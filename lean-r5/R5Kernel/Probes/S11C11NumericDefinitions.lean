namespace Erdos1011
open scoped BigOperators

def r5RepMaskSet11C11 (m : Fin 2048) : Finset (Fin 11) :=
  Finset.univ.filter (fun i => (m.1 / (2 ^ i.1)) % 2 = 1)

def r5RepScaledNum11C11 (r : R5RepDualRecord11) (i : Fin 11) : ℕ :=
  (2 * r.nums i) / r.dens i

def r5RepNatScaledValue11C11 (r : R5RepDualRecord11) : ℕ :=
  let R := r5RepMaskSet11C11 r.mask
  let U := cycleTypes 11 11
  r.beta * (∑ e ∈ R, r5RepScaledNum11C11 r e) +
    ∑ I ∈ U, if (I ∩ R).Nonempty then
      2 * I.card - ∑ e ∈ I,
        if e ∈ R then r5RepScaledNum11C11 r e else 0
      else 0

