def KernelS8C5UniformCertificate (mask : ℕ) : Prop :=
  let R := kernelSmallMask 8 mask
  let row := kernelS8C5UniformRow mask
  (∀ I ∈ kernelS8C5UniformTypes, I ⊆ R → I.card ≤ row.1) ∧
    row.1 * (R.card * row.2) +
      (∑ I ∈ kernelS8C5UniformTypes, if (I ∩ R).Nonempty then
        2 * I.card - (I ∩ R).card * row.2 else 0) ≤ 114

run_cmd R5Kernel.checkStandardAxioms ``KernelS8C5UniformCertificate

