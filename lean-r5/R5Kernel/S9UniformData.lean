def KernelS9C9UniformCertificate (mask : ℕ) : Prop :=
  let R := kernelSmallMask 9 mask
  let row := kernelS9C9UniformRow mask
  (∀ I ∈ kernelS9C9UniformTypes, I ⊆ R → I.card ≤ row.1) ∧
    row.1 * (R.card * row.2) +
      (∑ I ∈ kernelS9C9UniformTypes, if (I ∩ R).Nonempty then
        2 * I.card - (I ∩ R).card * row.2 else 0) ≤ 120

run_cmd R5Kernel.checkStandardAxioms ``KernelS9C9UniformCertificate

