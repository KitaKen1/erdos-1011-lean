def KernelS9C5UniformCertificate (mask : ℕ) : Prop :=
  let R := kernelSmallMask 9 mask
  let row := kernelS9C5UniformRow mask
  (∀ I ∈ kernelS9C5UniformTypes, I ⊆ R → I.card ≤ row.1) ∧
    row.1 * (R.card * row.2) +
      (∑ I ∈ kernelS9C5UniformTypes, if (I ∩ R).Nonempty then
        2 * I.card - (I ∩ R).card * row.2 else 0) ≤ 164

