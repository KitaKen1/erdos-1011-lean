theorem replaceVertex_residualType_eq_of_ne
    {n : ℕ} (G : SimpleGraph (Fin n)) {u v x y : Fin n}
    (huv : G.Adj u v) (hxA : x ∈ edgeSideASet G u v)
    (hy : y ≠ x) :
    residualType (G.replaceVertex u x) u v y = residualType G u v y := by
