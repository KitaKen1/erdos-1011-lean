  r#"section Flattened_Erdos1011_R4MaxDegreeData

/-!
# Maximum-degree case CNFs for the ten-vertex theorem

The common 9,962-clause formula is refined by ten cases.  In case `d`, vertex
zero has the normalized neighborhood `{1, ..., d}` and every vertex has degree
at most `d`.  Choosing a maximum-degree vertex and relabeling its neighbors
shows that these ten cases are exhaustive.
-/

namespace Erdos1011

open Std Sat

namespace R4MaxDegreeCNF

open R4SmallOrderCNF

/-- Lexicographically ordered fixed-length sublists, matching the certificate
generator's use of `itertools.combinations`. -/
def chooseLex {α : Type*} : Nat → List α → List (List α)
  | 0, _ => [[]]
  | _ + 1, [] => []
  | k + 1, x :: xs =>
      (chooseLex k xs).map (x :: ·) ++ chooseLex (k + 1) xs

def incidentVertices (v : Nat) : List Nat :=
  (List.range vertexCount).filter (· != v)

def incidentEdgeVars (v : Nat) : List Nat :=
  (incidentVertices v).map fun w => edgeVar (min v w) (max v w)

/-- Unit clauses fixing `N(0) = {1, ..., d}`. -/
def normalizedNeighborClauses (d : Nat) : List (CNF.Clause Nat) :=
  (List.range (vertexCount - 1)).map fun k =>
    let w := k + 1
    [(edgeVar 0 w, decide (w ≤ d))]

/-- Clauses saying that no vertex has `d+1` distinct incident edges. -/
def maximumDegreeClauses (d : Nat) : List (CNF.Clause Nat) :=
  (List.range vertexCount).flatMap fun v =>
    (chooseLex (d + 1) (incidentVertices v)).map fun neighbors =>
      neighbors.map fun w => (edgeVar (min v w) (max v w), false)

def caseExtraClauses (d : Nat) : List (CNF.Clause Nat) :=
  normalizedNeighborClauses d ++ maximumDegreeClauses d

def caseExtraCNF (d : Nat) : CNF Nat :=
  { clauses := (caseExtraClauses d).toArray }

def caseCNF (d : Nat) : CNF Nat :=
  { clauses := (R4SmallOrderCNF.counterexampleCNF.clauses ++
      (caseExtraClauses d).toArray) }

def caseExtraFormula (d : Nat) : Sat.Fmla :=
  satFmlaOfStdCNF (caseExtraCNF d)

def caseFormula (d : Nat) : Sat.Fmla :=
  Sat.Fmla.and R4SmallOrderCNF.satFormula (caseExtraFormula d)

end R4MaxDegreeCNF
end Erdos1011

end Flattened_Erdos1011_R4MaxDegreeData
