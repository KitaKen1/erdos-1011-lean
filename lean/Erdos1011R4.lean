theorem four_candidate_gap_s5 {n : ℕ} (hn : 32 ≤ n) :
    (n - 5) ^ 2 / 4 + 30 ≤ fourMCandidate n := by
  rw [fourMCandidate]
  have hshift : n - 3 = (n - 5) + 2 := by omega
  have hsq : (n - 3)^2 = (n - 5)^2 + (4 * (n - 5) + 4) := by
    rw [hshift]
    ring
  have hdiv :
      (n - 5)^2 / 4 + (4 * (n - 5) + 4) / 4 ≤
        ((n - 5)^2 + (4 * (n - 5) + 4)) / 4 :=
    Nat.div_add_div_le_add_div
  rw [← hsq] at hdiv
  have hD : 25 ≤ (4 * (n - 5) + 4) / 4 := by
