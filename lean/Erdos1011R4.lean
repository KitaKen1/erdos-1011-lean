erdos1011_elab_source r#"<Erdos1011.S3Mono>"#
  r#"section Flattened_Erdos1011_S3Mono

namespace Erdos1011

open SimpleGraph

/- A three-vertex edge code, used only for the P₃ exclusion.  Keeping the
   code at the `Sym2` level makes the finite certificate independent of any
   proof-irrelevant `Fintype` choices on a concrete graph. -/
abbrev S3EdgeCode := {e : Sym2 V3 // ¬ e.IsDiag}

def s3EdgeSet (E : Finset S3EdgeCode) : Set (Sym2 V3) :=
  ((E.image Subtype.val : Finset (Sym2 V3)) : Set _)

instance s3EdgeSet_decidable (E : Finset S3EdgeCode) :
    DecidablePred (· ∈ s3EdgeSet E) := by
  intro e
  change Decidable (e ∈ E.image Subtype.val)
  infer_instance

def s3CodeGraph (E : Finset S3EdgeCode) : SimpleGraph V3 :=
  SimpleGraph.fromEdgeSet (s3EdgeSet E)

instance s3CodeGraph_decidable (E : Finset S3EdgeCode) :
    DecidableRel (s3CodeGraph E).Adj := by
  intro x y
  change Decidable (s(x, y) ∈ s3EdgeSet E ∧ x ≠ y)
  infer_instance

def s3CodeTriangleFree (E : Finset S3EdgeCode) : Prop :=
  ∀ x y z : V3, (s3CodeGraph E).Adj x y →
    (s3CodeGraph E).Adj x z → (s3CodeGraph E).Adj y z → False

instance s3CodeTriangleFree_decidable (E : Finset S3EdgeCode) :
    Decidable (s3CodeTriangleFree E) := by
  unfold s3CodeTriangleFree
  infer_instance

def s3CodeIndependent (E : Finset S3EdgeCode) (I : Finset V3) : Prop :=
  ∀ ⦃x⦄, x ∈ I → ∀ ⦃y⦄, y ∈ I → x ≠ y →
    ¬ (s3CodeGraph E).Adj x y

instance s3CodeIndependent_decidable (E : Finset S3EdgeCode) (I : Finset V3) :
    Decidable (s3CodeIndependent E I) := by
  unfold s3CodeIndependent
  infer_instance

/- The executable part of the P₃ lemma.  Every triangle-free three-vertex
   graph with exactly two edges admits a proper two-colouring for which each
   independent set is monochromatic. -/
theorem s3_code_two_edge_mono_certificate :
    ∀ E : Finset S3EdgeCode, s3CodeTriangleFree E → E.card = 2 →
      ∃ c : V3 → Fin 2,
        (∀ x y, (s3CodeGraph E).Adj x y → c x ≠ c y) ∧
        ∀ I : Finset V3, s3CodeIndependent E I →
          ∃ d : Fin 2, ∀ z ∈ I, c z = d := by
  decide +kernel

private def s3EdgeCodeOfGraph (H : SimpleGraph V3)
    [DecidableRel H.Adj] : Finset S3EdgeCode :=
  H.edgeFinset.attach.image (fun e =>
    (⟨e.1, H.not_isDiag_of_mem_edgeFinset e.2⟩ : S3EdgeCode))

private theorem s3CodeGraph_edgeCodeOfGraph
    (H : SimpleGraph V3) [DecidableRel H.Adj] :
    s3CodeGraph (s3EdgeCodeOfGraph H) = H := by
  ext x y
  constructor
  · intro h
    change (SimpleGraph.fromEdgeSet (s3EdgeSet (s3EdgeCodeOfGraph H))).Adj x y at h
    rw [SimpleGraph.fromEdgeSet_adj] at h
    rcases h with ⟨hE, hxy⟩
    change s(x, y) ∈
      ((s3EdgeCodeOfGraph H).image Subtype.val : Finset (Sym2 V3)) at hE
    rw [Finset.mem_image] at hE
    rcases hE with ⟨e, he, heq⟩
    rcases Finset.mem_image.mp he with ⟨e', he', heeq⟩
    have hefin : e'.1 ∈ H.edgeFinset := e'.2
    have heq' : e'.1 = e.1 := by simpa using congrArg Subtype.val heeq
    have hval : e'.1 = s(x, y) := heq'.trans heq
    have : s(x, y) ∈ H.edgeFinset := by simpa [hval] using hefin
    exact SimpleGraph.mem_edgeFinset.mp this
  · intro hxy
    have hne : x ≠ y := H.ne_of_adj hxy
    change (SimpleGraph.fromEdgeSet (s3EdgeSet (s3EdgeCodeOfGraph H))).Adj x y
    rw [SimpleGraph.fromEdgeSet_adj]
    refine ⟨?_, hne⟩
    change s(x, y) ∈
      ((s3EdgeCodeOfGraph H).image Subtype.val : Finset (Sym2 V3))
    apply Finset.mem_image.mpr
    let e : H.edgeFinset := ⟨s(x, y), SimpleGraph.mem_edgeFinset.mpr hxy⟩
    let ec : S3EdgeCode :=
      ⟨e.1, H.not_isDiag_of_mem_edgeFinset e.2⟩
    refine ⟨ec, ?_, ?_⟩
    · apply Finset.mem_image.mpr
      exact ⟨e, by simp, rfl⟩
    · rfl

private theorem s3EdgeCodeOfGraph_card
    (H : SimpleGraph V3) [DecidableRel H.Adj] :
    (s3EdgeCodeOfGraph H).card = H.edgeFinset.card := by
  unfold s3EdgeCodeOfGraph
  calc
    (Finset.image (fun e =>
      (⟨e.1, H.not_isDiag_of_mem_edgeFinset e.2⟩ : S3EdgeCode))
        H.edgeFinset.attach).card = H.edgeFinset.attach.card := by
      apply Finset.card_image_of_injOn
      intro a ha b hb hab
      apply Subtype.ext
      simpa using congrArg Subtype.val hab
    _ = H.edgeFinset.card := by simp

/- The graph-facing form of the finite certificate. -/
theorem s3_graph_two_edge_mono_coloring
    (H : SimpleGraph V3) [DecidableRel H.Adj]
    (htri : H.CliqueFree 3) (hcard : H.edgeFinset.card = 2) :
    ∃ C : Coloring H (Fin 2),
      ∀ I : Finset V3, H.IsIndepSet (I : Set V3) →
        ∃ d : Fin 2, ∀ z ∈ I, C z = d := by
  let E := s3EdgeCodeOfGraph H
  have hEq : s3CodeGraph E = H := by
    exact s3CodeGraph_edgeCodeOfGraph H
  have htriE : s3CodeTriangleFree E := by
    intro x y z hxy hxz hyz
    apply htri
    exact SimpleGraph.is3Clique_triple_iff.mpr
      ⟨by simpa [hEq] using hxy, by simpa [hEq] using hxz,
        by simpa [hEq] using hyz⟩
  have hcardE : E.card = 2 := by
    dsimp [E]
    rw [s3EdgeCodeOfGraph_card]
    exact hcard
  obtain ⟨c, hcvalid, hcmono⟩ :=
    s3_code_two_edge_mono_certificate E htriE hcardE
  refine ⟨Coloring.mk c ?_, ?_⟩
  · intro x y hxy
    apply hcvalid x y
    simpa [hEq] using hxy
  · intro I hI
    apply hcmono I
    intro x hx y hy hxy
    intro hcode
    apply hI hx hy hxy
    simpa [hEq] using hcode

end Erdos1011

end Flattened_Erdos1011_S3Mono
