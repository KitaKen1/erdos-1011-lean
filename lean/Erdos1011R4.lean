private def satValuationOfBool (a : Nat → Bool) : Sat.Valuation :=
  fun i => a i = true

private theorem satClauseOfStd_satisfied
    (a : Nat → Bool) (c : Std.Sat.CNF.Clause Nat)
    (h : Std.Sat.CNF.Clause.eval a c = true) :
    (satValuationOfBool a).satisfies (satClauseOfStd c) := by
  induction c with
  | nil => simp at h
  | cons lit c ih =>
      rcases lit with ⟨i, polarity⟩
      cases polarity with
      | false =>
          cases hai : a i with
          | false =>
              simp [satClauseOfStd, satLiteralOfStd, satValuationOfBool,
                Sat.Valuation.satisfies, Sat.Valuation.neg, hai]
          | true =>
              have htail : Std.Sat.CNF.Clause.eval a c = true := by
                simpa [Std.Sat.CNF.Clause.eval, hai] using h
              simpa [satClauseOfStd, satLiteralOfStd, satValuationOfBool,
                Sat.Valuation.satisfies, Sat.Valuation.neg, hai] using ih htail
      | true =>
          cases hai : a i with
          | false =>
              have htail : Std.Sat.CNF.Clause.eval a c = true := by
                simpa [Std.Sat.CNF.Clause.eval, hai] using h
              simpa [satClauseOfStd, satLiteralOfStd, satValuationOfBool,
                Sat.Valuation.satisfies, Sat.Valuation.neg, hai] using ih htail
          | true =>
              simp [satClauseOfStd, satLiteralOfStd, satValuationOfBool,
                Sat.Valuation.satisfies, Sat.Valuation.neg, hai]

private theorem satFmlaOfStdCNF_satisfied
    (a : Nat → Bool) (cnf : Std.Sat.CNF Nat)
    (h : Std.Sat.CNF.eval a cnf = true) :
    (satValuationOfBool a).satisfies_fmla (satFmlaOfStdCNF cnf) := by
  refine ⟨?_⟩
  intro clause hclause
  rcases List.mem_map.mp hclause with ⟨source, hsource, rfl⟩
  apply satClauseOfStd_satisfied
  rw [Std.Sat.CNF.eval, Array.all_eq_true_iff_forall_mem] at h
  exact h source (Array.mem_toList_iff.mp hsource)

/-- A proof-producing LRAT refutation implies unsatisfiability of the
corresponding `Std.Sat.CNF`, with no native-code soundness axiom. -/
theorem stdCNF_unsat_of_fmla_proof (cnf : Std.Sat.CNF Nat)
    (hproof : (satFmlaOfStdCNF cnf).proof []) : cnf.Unsat := by
  intro a
  apply Bool.eq_false_iff.mpr
  intro htrue
  exact hproof (satValuationOfBool a)
    (satFmlaOfStdCNF_satisfied a cnf htrue)

