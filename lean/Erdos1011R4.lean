      by_cases hzA : z ∈ edgeSideASet G u v
      · exact Or.inr (Or.inr (Or.inl hzA))
      by_cases hzB : z ∈ edgeSideBSet G u v
      · exact Or.inr (Or.inr (Or.inr (Or.inl hzB)))
