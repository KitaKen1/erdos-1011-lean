  r#"section Flattened_Erdos1011_CapacityMasks

/-!
# Bit-mask certificate for the r=4 residual table

This is the executable counterpart of the support-family table.  A family is
encoded by an 11-bit mask, one bit for each nonempty independent support of
`K₂ ⊔ 2K₁`.  Keeping this checker separate from the graph reduction makes the
finite computational step small enough to inspect and replay.
-/

namespace Erdos1011

def r4TypeMask : Fin 11 → ℕ
  | 0 => 1
  | 1 => 2
  | 2 => 4
  | 3 => 5
  | 4 => 6
  | 5 => 8
  | 6 => 9
  | 7 => 10
  | 8 => 12
  | 9 => 13
  | 10 => 14

def r4TypeWeight (i : Fin 11) : ℕ :=
  match i with
  | 0 => 1 | 1 => 1 | 2 => 1 | 3 => 2 | 4 => 2 | 5 => 1
  | 6 => 2 | 7 => 2 | 8 => 2 | 9 => 3 | 10 => 3

def bitIn (family i : ℕ) : Bool := Nat.testBit family i

def maskIntersects (x y : ℕ) : Bool := decide (Nat.land x y ≠ 0)

def r4FamilyWeight (family : ℕ) : ℕ :=
  ∑ i : Fin 11, if bitIn family i.1 then r4TypeWeight i else 0

def r4Hits (family support : ℕ) : ℕ :=
  ∑ i : Fin 11,
    if bitIn family i.1 && maskIntersects (r4TypeMask i) support
    then 1 else 0

def r4Cross (a b : ℕ) : ℕ :=
  ∑ i : Fin 11, if bitIn b i.1 then r4Hits a (r4TypeMask i) else 0

def r4Surplus (a b : ℕ) : ℕ :=
  r4FamilyWeight a + r4FamilyWeight b - r4Cross a b

def r4Compatible (a b : ℕ) : Bool :=
  decide (∀ i : Fin 11, bitIn a i.1 = true →
    r4TypeWeight i ≤ r4Hits b (r4TypeMask i)) &&
  decide (∀ i : Fin 11, bitIn b i.1 = true →
    r4TypeWeight i ≤ r4Hits a (r4TypeMask i))

def R4Compatible (a b : ℕ) : Prop :=
  (∀ i : Fin 11, bitIn a i.1 = true →
    r4TypeWeight i ≤ r4Hits b (r4TypeMask i)) ∧
  (∀ i : Fin 11, bitIn b i.1 = true →
    r4TypeWeight i ≤ r4Hits a (r4TypeMask i))

theorem r4Compatible_iff (a b : ℕ) :
    r4Compatible a b = true ↔ R4Compatible a b := by
  simp [r4Compatible, R4Compatible]

theorem r4Cross_ge_leftWeight
    {a b : ℕ}
    (h : ∀ i : Fin 11, bitIn b i.1 = true →
      r4TypeWeight i ≤ r4Hits a (r4TypeMask i)) :
    r4FamilyWeight b ≤ r4Cross a b := by
  classical
  simp only [r4FamilyWeight, r4Cross]
  apply Finset.sum_le_sum
  intro i hi
  by_cases hb : bitIn b i.1 = true
  · simp [hb, h i hb]
  · simp [hb]

theorem r4Surplus_le_leftWeight
    {a b : ℕ}
    (h : ∀ i : Fin 11, bitIn b i.1 = true →
      r4TypeWeight i ≤ r4Hits a (r4TypeMask i)) :
    r4Surplus a b ≤ r4FamilyWeight a := by
  have hc := r4Cross_ge_leftWeight h
  unfold r4Surplus
  omega

end Erdos1011

end Flattened_Erdos1011_CapacityMasks
