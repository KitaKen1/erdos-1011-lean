  exact SimpleGraph.is3Clique_triple_iff.mpr
    ⟨(s3Adj_maskOfGraph_iff H x y).mp hxy,
      (s3Adj_maskOfGraph_iff H x z).mp hxz,
      (s3Adj_maskOfGraph_iff H y z).mp hyz⟩

theorem s3HasEdge_maskOfGraph
    (H : SimpleGraph V3) [DecidableRel H.Adj]
