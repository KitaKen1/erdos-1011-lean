/-! ===== Flattened module: Erdos1011.R4ResidualCapacity ===== -/

erdos1011_elab_source r#"<Erdos1011.R4ResidualCapacity>"#
  r#"section Flattened_Erdos1011_R4ResidualCapacity

namespace Erdos1011

open SimpleGraph

/-! The local graph-to-capacity bridge for a four-vertex residual.  The finite
    tables in `R4SmallCapacity` are deliberately kept separate from the
    graph bookkeeping here. -/

theorem r4_graph_support_surplus_le_eight_of_twoK2
    (H : SimpleGraph V4) [DecidableRel H.Adj]
    (h01 : H.Adj (0 : V4) 1) (h23 : H.Adj (2 : V4) 3)
    {𝒜 ℬ : Finset (Finset V4)}
    (h𝒜 : ∀ I ∈ 𝒜, I.Nonempty ∧ H.IsIndepSet (I : Set V4))
    (hℬ : ∀ J ∈ ℬ, J.Nonempty ∧ H.IsIndepSet (J : Set V4))
    (hcompat : DegreeCompatible 𝒜 ℬ) :
    supportSurplus 𝒜 ℬ ≤ 8 := by
