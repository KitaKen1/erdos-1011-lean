/-! # The ten-vertex CNF data

This module contains only the finite formula.  The proof-producing LRAT
checker lives in separate chunk modules so that its intermediate proof DAGs
can be released between Lean processes.
-/

namespace Erdos1011

open Std Sat

namespace R4SmallOrderCNF

abbrev Edge := Nat × Nat
abbrev Colouring := List Nat

def vertexCount : Nat := 10

def edgePairs : List Edge :=
  (List.range vertexCount).flatMap fun i =>
    (List.range (vertexCount - i - 1)).map fun d => (i, i + d + 1)

def edgeVar (i j : Nat) : Nat :=
  i * (2 * vertexCount - i - 1) / 2 + (j - i - 1)

def triangleClauses : List (CNF.Clause Nat) :=
  (List.range vertexCount).flatMap fun i =>
    (List.range (vertexCount - i - 1)).flatMap fun dj =>
      let j := i + dj + 1
      (List.range (vertexCount - j - 1)).map fun dk =>
        let k := j + dk + 1
        [(edgeVar i j, false), (edgeVar i k, false), (edgeVar j k, false)]

def canonicalTails : Nat → Nat → List Colouring
  | 0, _ => [[]]
  | remaining + 1, seenMax =>
      (List.range (min 2 (seenMax + 1) + 1)).flatMap fun colour =>
        (canonicalTails remaining (max seenMax colour)).map (colour :: ·)

def canonicalColourings : List Colouring :=
  (canonicalTails 9 0).map (0 :: ·)

def colouringClause (c : Colouring) : CNF.Clause Nat :=
  edgePairs.filterMap fun e =>
    if getElem? c e.1 = getElem? c e.2 then
      some (edgeVar e.1 e.2, true)
    else none

def colourClauses : List (CNF.Clause Nat) :=
  canonicalColourings.map colouringClause

def counterexampleCNF : CNF Nat :=
  { clauses := (triangleClauses ++ colourClauses).toArray }

/-- The formula in the representation used by the proof-producing LRAT
elaborator. -/
def satFormula : Sat.Fmla :=
  satFmlaOfStdCNF counterexampleCNF

/- The same formula represented as a balanced tree of `Fmla.and` nodes.
All proof chunks share this named context, which keeps kernel checking local. -/
lrat_fmla_context satContext erdos1011R4BaseCNFText

theorem edgePairs_length : edgePairs.length = 45 := by decide +kernel
theorem triangleClauses_length : triangleClauses.length = 120 := by decide +kernel
theorem canonicalColourings_length : canonicalColourings.length = 9842 := by decide +kernel
theorem counterexampleCNF_clause_count : counterexampleCNF.clauses.size = 9962 := by
  decide +kernel

end R4SmallOrderCNF
end Erdos1011

end Flattened_Erdos1011_R4SmallOrderData
