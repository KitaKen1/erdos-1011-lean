erdos1011_elab_source r#"<Erdos1011.S3GraphCode>"#
  r#"section Flattened_Erdos1011_S3GraphCode

namespace Erdos1011

open SimpleGraph

/-! Encoding an arbitrary simple graph on three labelled vertices by the
    `Fin 8` edge mask used in `SmallCapacity`.  The edge order is
    `01`, `12`, `02`, matching `s3EdgeIndex`. -/

noncomputable def s3MaskOfGraph
    (H : SimpleGraph V3) [DecidableRel H.Adj] : Fin 8 := by
  let b01 : ℕ := if H.Adj (0 : V3) 1 then 1 else 0
  let b12 : ℕ := if H.Adj (1 : V3) 2 then 2 else 0
  let b02 : ℕ := if H.Adj (0 : V3) 2 then 4 else 0
  exact ⟨b01 + b12 + b02, by
    dsimp [b01, b12, b02]
    split <;> split <;> split <;> omega⟩

theorem s3Adj_maskOfGraph_iff
    (H : SimpleGraph V3) [DecidableRel H.Adj] :
    ∀ x y : V3, s3Adj (s3MaskOfGraph H) x y ↔ H.Adj x y := by
  classical
  intro x y
  have h10 : H.Adj (1 : V3) 0 ↔ H.Adj 0 1 := H.adj_comm 1 0
  have h21 : H.Adj (2 : V3) 1 ↔ H.Adj 1 2 := H.adj_comm 2 1
  have h20 : H.Adj (2 : V3) 0 ↔ H.Adj 0 2 := H.adj_comm 2 0
  by_cases h01 : H.Adj (0 : V3) 1
  · by_cases h12 : H.Adj (1 : V3) 2
    · by_cases h02 : H.Adj (0 : V3) 2
      · fin_cases x <;> fin_cases y <;>
          simp [s3Adj, s3EdgeIndex, s3MaskOfGraph, h01, h12, h02,
            h10, h21, h20] <;> decide +kernel
      · fin_cases x <;> fin_cases y <;>
          simp [s3Adj, s3EdgeIndex, s3MaskOfGraph, h01, h12, h02,
            h10, h21, h20] <;> decide +kernel
    · by_cases h02 : H.Adj (0 : V3) 2
      · fin_cases x <;> fin_cases y <;>
          simp [s3Adj, s3EdgeIndex, s3MaskOfGraph, h01, h12, h02,
            h10, h21, h20] <;> decide +kernel
      · fin_cases x <;> fin_cases y <;>
          simp [s3Adj, s3EdgeIndex, s3MaskOfGraph, h01, h12, h02,
            h10, h21, h20] <;> decide +kernel
  · by_cases h12 : H.Adj (1 : V3) 2
    · by_cases h02 : H.Adj (0 : V3) 2
      · fin_cases x <;> fin_cases y <;>
          simp [s3Adj, s3EdgeIndex, s3MaskOfGraph, h01, h12, h02,
