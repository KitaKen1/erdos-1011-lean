      ℬ.image (fun I => I.map e.toEmbedding) by rfl]
  rw [Finset.sum_image (mapSupportFamily_map_injOn e ℬ)]
  apply Finset.sum_congr rfl
  intro J hJ
  rw [supportHits_mapSupportFamily]

theorem supportSurplus_mapSupportFamily {s t : ℕ} (e : Fin s ≃ Fin t)
    (𝒜 ℬ : Finset (Finset (Fin s))) :
    supportSurplus (mapSupportFamily e 𝒜) (mapSupportFamily e ℬ) =
      supportSurplus 𝒜 ℬ := by
  unfold supportSurplus
  rw [supportWeight_mapSupportFamily, supportWeight_mapSupportFamily,
    supportCross_mapSupportFamily]

/- The same transport works for a non-surjective embedding, which is the
   form needed when a six-vertex residual set sits inside an n-vertex graph. -/
noncomputable def mapSupportFamilyEmbedding {s t : ℕ} (f : Fin s ↪ Fin t)
    (𝒜 : Finset (Finset (Fin s))) : Finset (Finset (Fin t)) := by
