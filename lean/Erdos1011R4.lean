erdos1011_elab_source r#"<Erdos1011.S3Residual>"#
  r#"section Flattened_Erdos1011_S3Residual

namespace Erdos1011

open SimpleGraph

/-! The first concrete quotient bridge: a residual set of cardinality three is
    labelled by `Fin 3`, and the induced graph/support data can then use the
    finite mask certificate.  The remaining input to the final theorem is only
    the existence of an edge in that residual graph (the edgeless case needs a
    separate colouring argument in the r=4 proof). -/

noncomputable def residualThreeEmbedding
    {n : ℕ} (T : Finset (Fin n)) (hT : T.card = 3) : Fin 3 ↪ Fin n :=
  (T.equivFinOfCardEq hT).symm.toEmbedding.trans (Function.Embedding.subtype _)

theorem residualThreeEmbedding_mem
    {n : ℕ} (T : Finset (Fin n)) (hT : T.card = 3) (i : Fin 3) :
    residualThreeEmbedding T hT i ∈ T := by
  dsimp [residualThreeEmbedding]
  exact (T.equivFinOfCardEq hT).symm i |>.property

theorem residualThreeEmbedding_range
    {n : ℕ} (T : Finset (Fin n)) (hT : T.card = 3) :
    Set.range (residualThreeEmbedding T hT) = (T : Set (Fin n)) := by
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    exact residualThreeEmbedding_mem T hT i
  · intro hx
    let e : T ≃ Fin 3 := T.equivFinOfCardEq hT
    let y : T := ⟨x, hx⟩
    refine ⟨e y, ?_⟩
    dsimp [residualThreeEmbedding, e, y]
    simp

theorem residualTypeFinset_maps_to_three
    {n : ℕ} (G : SimpleGraph (Fin n)) (u v x : Fin n)
    (T : Finset (Fin n))
    (hTsub : ∀ z, z ∈ residualSet G u v → z ∈ T) :
    ∀ z ∈ residualTypeFinset G u v x, z ∈ T := by
  intro z hz
  exact hTsub z (mem_residualTypeFinset_iff.mp hz).2

theorem supportFamily_maps_to_three
    {n : ℕ} (G : SimpleGraph (Fin n)) (u v : Fin n)
    (T : Finset (Fin n))
    (hTsub : ∀ z, z ∈ residualSet G u v → z ∈ T)
    (f : Fin 3 ↪ Fin n)
    (hrange : Set.range f = (T : Set (Fin n))) :
    familyMapsToEmbedding f (supportFamilyA G u v) ∧
      familyMapsToEmbedding f (supportFamilyB G u v) := by
  constructor
  · intro I hI z hz
    rcases mem_supportFamilyA_iff.mp hI with ⟨x, hx, hIx⟩
    subst I
    rw [hrange]
    exact residualTypeFinset_maps_to_three G u v x T hTsub z hz
  · intro I hI z hz
    rcases mem_supportFamilyB_iff.mp hI with ⟨x, hx, hIx⟩
    subst I
    rw [hrange]
    exact residualTypeFinset_maps_to_three G u v x T hTsub z hz

/- The graph-specific theorem currently accepts the explicit labelled support
   equalities.  This is a useful checkpoint: all numerical quantities and the
   local degree compatibility now transport without any hidden assumptions. -/
theorem residual_three_capacity_of_labelled_certificate
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    {u v : Fin n} (htri : G.CliqueFree 3) (huv : G.Adj u v)
    {T : Finset (Fin n)} (hTcard : T.card = 3)
    (hTsub : ∀ z, z ∈ residualSet G u v → z ∈ T)
    (hcompat : DegreeCompatible (supportFamilyA G u v)
      (supportFamilyB G u v))
    (hedge : ∃ x y : Fin 3,
      (G.comap (residualThreeEmbedding T hTcard)).Adj x y) :
    supportSurplus (supportFamilyA G u v) (supportFamilyB G u v) ≤ 4 := by
  let f := residualThreeEmbedding T hTcard
  let H := G.comap f
  have hrange : Set.range f = (T : Set (Fin n)) := residualThreeEmbedding_range T hTcard
  have hmaps := supportFamily_maps_to_three G u v T hTsub f hrange
  have hA_pull : familyMapsToEmbedding f
      (supportFamilyA G u v) := hmaps.1
  have hB_pull : familyMapsToEmbedding f
      (supportFamilyB G u v) := hmaps.2
  let 𝒜 := pullSupportFamilyEmbedding f (supportFamilyA G u v)
  let ℬ := pullSupportFamilyEmbedding f (supportFamilyB G u v)
  have hAmap : mapSupportFamilyEmbedding f 𝒜 = supportFamilyA G u v := by
    simpa [𝒜] using map_pullSupportFamilyEmbedding_eq f hA_pull
  have hBmap : mapSupportFamilyEmbedding f ℬ = supportFamilyB G u v := by
    simpa [ℬ] using map_pullSupportFamilyEmbedding_eq f hB_pull
  have hcomp : DegreeCompatible 𝒜 ℬ := by
    apply degreeCompatible_of_mapped_certificate f
      (𝒜' := supportFamilyA G u v) (ℬ' := supportFamilyB G u v)
    · exact hAmap.symm
    · exact hBmap.symm
    · exact hcompat
  have hHtri : H.CliqueFree 3 := by
    intro s hs
    rcases SimpleGraph.is3Clique_iff.mp hs with ⟨a, b, c, hab, hac, hbc, _⟩
    apply htri
    exact SimpleGraph.is3Clique_triple_iff.mpr
      ⟨hab, hac, hbc⟩
  have h𝒜ind : ∀ I ∈ 𝒜, I.Nonempty ∧ H.IsIndepSet (I : Set V3) := by
    intro I hI
    have hI' : I.Nonempty := by
      rcases Finset.mem_image.mp hI with ⟨J, hJ, rfl⟩
      rcases supportFamilyA_nonempty hJ with ⟨z, hz⟩
      obtain ⟨i, hi⟩ := hA_pull J hJ z hz
      obtain ⟨i, rfl⟩ := hi
      exact ⟨i, Finset.mem_preimage.2 hz⟩
    refine ⟨hI', ?_⟩
    rcases Finset.mem_image.mp hI with ⟨J, hJ, rfl⟩
    intro a ha b hb hab hAdj
    exact (supportFamilyA_independent htri hJ)
      (Finset.mem_preimage.1 ha) (Finset.mem_preimage.1 hb)
      (fun h => hab (f.injective h)) hAdj
  have hℬind : ∀ J ∈ ℬ, J.Nonempty ∧ H.IsIndepSet (J : Set V3) := by
    intro I hI
    have hI' : I.Nonempty := by
      rcases Finset.mem_image.mp hI with ⟨J, hJ, rfl⟩
      rcases supportFamilyB_nonempty hJ with ⟨z, hz⟩
      obtain ⟨i, hi⟩ := hB_pull J hJ z hz
      obtain ⟨i, rfl⟩ := hi
      exact ⟨i, Finset.mem_preimage.2 hz⟩
    refine ⟨hI', ?_⟩
    rcases Finset.mem_image.mp hI with ⟨J, hJ, rfl⟩
    intro a ha b hb hab hAdj
    exact (supportFamilyB_independent htri hJ)
      (Finset.mem_preimage.1 ha) (Finset.mem_preimage.1 hb)
      (fun h => hab (f.injective h)) hAdj
  have hs := s3_graph_support_surplus_le_four H hedge hHtri h𝒜ind hℬind hcomp
  calc
    supportSurplus (supportFamilyA G u v) (supportFamilyB G u v) =
        supportSurplus (mapSupportFamilyEmbedding f 𝒜)
          (mapSupportFamilyEmbedding f ℬ) := by rw [hAmap, hBmap]
    _ = supportSurplus 𝒜 ℬ := supportSurplus_mapSupportFamilyEmbedding f 𝒜 ℬ
    _ ≤ 4 := hs

end Erdos1011

end Flattened_Erdos1011_S3Residual
