/- Every ordered pair of distinct four-vertex labels can be sent to 0,1.
The proof is finite but explicit, so it does not rely on a noncomputable
`Fintype` instance for permutations. -/
theorem r4_exists_pair_equiv (x y : V4) (hxy : x ≠ y) :
    ∃ e : V4 ≃ V4, e 0 = x ∧ e 1 = y := by
  fin_cases x <;> fin_cases y
  all_goals try { exact (hxy rfl).elim }
  · exact ⟨Equiv.refl _, by decide +kernel, by decide +kernel⟩
  · exact ⟨Equiv.swap 1 2, by decide +kernel, by decide +kernel⟩
  · exact ⟨Equiv.swap 1 3, by decide +kernel, by decide +kernel⟩
  · exact ⟨Equiv.swap 0 1, by decide +kernel, by decide +kernel⟩
  · exact ⟨(Equiv.swap 0 1).trans (Equiv.swap 0 2), by decide +kernel, by decide +kernel⟩
  · exact ⟨(Equiv.swap 0 1).trans (Equiv.swap 0 3), by decide +kernel, by decide +kernel⟩
  · exact ⟨(Equiv.swap 0 1).trans (Equiv.swap 1 2), by decide +kernel, by decide +kernel⟩
  · exact ⟨Equiv.swap 0 2, by decide +kernel, by decide +kernel⟩
  · exact ⟨(Equiv.swap 0 2).trans (Equiv.swap 1 3), by decide +kernel, by decide +kernel⟩
  · exact ⟨(Equiv.swap 0 1).trans (Equiv.swap 1 3), by decide +kernel, by decide +kernel⟩
  · exact ⟨Equiv.swap 0 3, by decide +kernel, by decide +kernel⟩
  · exact ⟨(Equiv.swap 0 3).trans (Equiv.swap 1 2), by decide +kernel, by decide +kernel⟩

theorem r4_graph_support_surplus_le_ten_of_edge
    (H : SimpleGraph V4) [DecidableRel H.Adj]
    (hEdge : H.Adj (0 : V4) 1)
    {𝒜 ℬ : Finset (Finset V4)}
    (h𝒜 : ∀ I ∈ 𝒜, I.Nonempty ∧ H.IsIndepSet (I : Set V4))
    (hℬ : ∀ J ∈ ℬ, J.Nonempty ∧ H.IsIndepSet (J : Set V4))
    (hcompat : DegreeCompatible 𝒜 ℬ) :
    supportSurplus 𝒜 ℬ ≤ 10 := by
  apply r4_support_surplus_le_ten
  · intro I hI
    apply r4_nonempty_base_independent (h𝒜 I hI).1
    intro x hx y hy hxy
    intro hpair
    rcases hpair with hpair | hpair
    · rcases hpair with ⟨rfl, rfl⟩
      exact (h𝒜 I hI).2 hx hy (by decide) hEdge
    · rcases hpair with ⟨rfl, rfl⟩
      exact (h𝒜 I hI).2 hx hy (by decide) hEdge.symm
  · intro J hJ
    apply r4_nonempty_base_independent (hℬ J hJ).1
    intro x hx y hy hxy
    intro hpair
    rcases hpair with hpair | hpair
    · rcases hpair with ⟨rfl, rfl⟩
      exact (hℬ J hJ).2 hx hy (by decide) hEdge
    · rcases hpair with ⟨rfl, rfl⟩
      exact (hℬ J hJ).2 hx hy (by decide) hEdge.symm
  · exact hcompat

theorem r4_graph_support_surplus_le_ten_of_any_edge
    (H : SimpleGraph V4) [DecidableRel H.Adj]
    (hedge : ∃ x y : V4, H.Adj x y)
    {𝒜 ℬ : Finset (Finset V4)}
    (h𝒜 : ∀ I ∈ 𝒜, I.Nonempty ∧ H.IsIndepSet (I : Set V4))
    (hℬ : ∀ J ∈ ℬ, J.Nonempty ∧ H.IsIndepSet (J : Set V4))
    (hcompat : DegreeCompatible 𝒜 ℬ) :
    supportSurplus 𝒜 ℬ ≤ 10 := by
  rcases hedge with ⟨x, y, hxy⟩
  obtain ⟨e, he0, he1⟩ := r4_exists_pair_equiv x y hxy.ne
  let H0 : SimpleGraph V4 := H.comap e
  let 𝒜0 := pullSupportFamilyEmbedding e.toEmbedding 𝒜
  let ℬ0 := pullSupportFamilyEmbedding e.toEmbedding ℬ
  have hAto : familyMapsToEmbedding e.toEmbedding 𝒜 := by
    intro I hI z hz
    exact ⟨e.symm z, by simp⟩
  have hBto : familyMapsToEmbedding e.toEmbedding ℬ := by
    intro I hI z hz
    exact ⟨e.symm z, by simp⟩
  have hAmap : mapSupportFamilyEmbedding e.toEmbedding 𝒜0 = 𝒜 := by
    simpa [𝒜0] using map_pullSupportFamilyEmbedding_eq e.toEmbedding hAto
  have hBmap : mapSupportFamilyEmbedding e.toEmbedding ℬ0 = ℬ := by
    simpa [ℬ0] using map_pullSupportFamilyEmbedding_eq e.toEmbedding hBto
  have hcompat0 : DegreeCompatible 𝒜0 ℬ0 := by
    apply degreeCompatible_of_mapped_certificate e.toEmbedding
      (𝒜' := 𝒜) (ℬ' := ℬ)
    · exact hAmap.symm
    · exact hBmap.symm
    · exact hcompat
  have hAind : ∀ I ∈ 𝒜0, I.Nonempty ∧ H0.IsIndepSet (I : Set V4) := by
    intro I hI
    rcases Finset.mem_image.mp hI with ⟨J, hJ, rfl⟩
    have hJ' := h𝒜 J hJ
    have hnon : (J.preimage e.toEmbedding e.injective.injOn).Nonempty := by
      rcases hJ'.1 with ⟨z, hz⟩
      obtain ⟨i, hi⟩ := e.surjective z
      refine ⟨i, Finset.mem_preimage.mpr ?_⟩
      simpa [hi] using hz
    refine ⟨hnon, ?_⟩
    intro a ha b hb hab hAdj
