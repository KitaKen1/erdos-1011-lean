    colorable_three_of_residual_edgeless hG.1 huv hedgeless
  have hle : G.chromaticNumber ≤ 3 := h3.chromaticNumber_le
  have hbad : (4 : ℕ∞) ≤ 3 := hG.2.trans hle
  norm_num at hbad

theorem residual_not_colorable_two_of_high_five
    {n : ℕ} {G : SimpleGraph (Fin n)} {u v : Fin n}
    (hG : HighChromaticTriangleFree 5 n G) (huv : G.Adj u v) :
