/-! ===== Flattened module: Erdos1011.R4CapacityCross ===== -/

erdos1011_elab_source r#"<Erdos1011.R4CapacityCross>"#
  r#"section Flattened_Erdos1011_R4CapacityCross

namespace Erdos1011

theorem r4_mask_cross (a b : Fin 2048) :
    supportCross (r4FamilyOfMask a.val) (r4FamilyOfMask b.val) =
      r4Cross a.val b.val := by
  classical
  unfold supportCross r4FamilyOfMask r4Cross
  rw [Finset.sum_image]
  · rw [Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro i hi
    by_cases hbit : bitIn b.val i.val = true
    · simp only [hbit, if_true]
      change supportHits (r4FamilyOfMask a.val) (r4TypeFinset i) = _
      exact r4_mask_hits a i
    · simp [hbit]
  · exact r4TypeFinset_injective.injOn

theorem r4_mask_surplus (a b : Fin 2048) :
    supportSurplus (r4FamilyOfMask a.val) (r4FamilyOfMask b.val) =
      r4Surplus a.val b.val := by
  unfold supportSurplus r4Surplus
  rw [r4_mask_weight, r4_mask_weight, r4_mask_cross]

theorem r4TypeWeight_eq_card (i : Fin 11) :
    r4TypeWeight i = (r4TypeFinset i).card := by
  decide +kernel +revert

end Erdos1011

