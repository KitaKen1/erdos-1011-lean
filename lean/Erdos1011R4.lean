  r#"section Flattened_Erdos1011_S3Transport

namespace Erdos1011

/- Transport the finite three-vertex capacity check through an arbitrary
   embedding.  The graph-specific part of a later residual classification is
   precisely the production of the mask, embedding, and the displayed support
   equalities/independence certificates. -/
theorem embedded_s3_support_surplus_le_four
    {t : ℕ} (e : Fin 8) (f : Fin 3 ↪ Fin t)
    {𝒜 ℬ : Finset (Finset V3)}
    (h𝒜ind : ∀ I ∈ 𝒜, I.Nonempty ∧ s3Independent e I)
    (hℬind : ∀ J ∈ ℬ, J.Nonempty ∧ s3Independent e J)
    (hcompat : DegreeCompatible 𝒜 ℬ)
    (hedge : s3HasEdge e) (htri : s3TriangleFree e) :
    supportSurplus (mapSupportFamilyEmbedding f 𝒜)
        (mapSupportFamilyEmbedding f ℬ) ≤ 4 := by
  rw [supportSurplus_mapSupportFamilyEmbedding]
  exact s3_support_surplus_le_four e hedge htri 𝒜 ℬ h𝒜ind hℬind hcompat

theorem s3_support_surplus_le_four_of_embedded_certificate
    {t : ℕ} {f : Fin 3 ↪ Fin t} {e : Fin 8}
    {𝒜 ℬ : Finset (Finset V3)}
    {𝒜' ℬ' : Finset (Finset (Fin t))}
    (h𝒜eq : 𝒜' = mapSupportFamilyEmbedding f 𝒜)
    (hℬeq : ℬ' = mapSupportFamilyEmbedding f ℬ)
    (h𝒜ind : ∀ I ∈ 𝒜, I.Nonempty ∧ s3Independent e I)
    (hℬind : ∀ J ∈ ℬ, J.Nonempty ∧ s3Independent e J)
    (hcompat : DegreeCompatible 𝒜 ℬ)
    (hedge : s3HasEdge e) (htri : s3TriangleFree e) :
    supportSurplus 𝒜' ℬ' ≤ 4 := by
  rw [h𝒜eq, hℬeq]
  exact embedded_s3_support_surplus_le_four e f h𝒜ind hℬind hcompat hedge htri

end Erdos1011

end Flattened_Erdos1011_S3Transport
