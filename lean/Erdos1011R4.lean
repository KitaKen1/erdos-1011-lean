def r4DualD (a : ℕ) : ℕ := (r4DualRows[a]!).1

def r4DualP (a : ℕ) (i : Fin 11) : ℕ :=
  ((r4DualRows[a]!).2)[i.val]!

def R4DualValidAt (a : Fin 2048) : Prop :=
    r4FamilyWeight a.val ≤ 10 ∨
      (0 < r4DualD a.val ∧
       r4DualD a.val * (r4FamilyWeight a.val - 10) ≤
         r4DualObjective a.val (r4DualP a.val) ∧
       ∀ j : Fin 11,
         r4TypeWeight j ≤ r4Hits a.val (r4TypeMask j) →
           r4DualLoad a.val (r4DualP a.val) j ≤
             r4DualD a.val *
               (r4Hits a.val (r4TypeMask j) - r4TypeWeight j))

/- Checking all 2048 rows in one kernel reduction has an unnecessarily high
peak-memory cost.  `fin_cases` creates 128 independent kernel lemmas, each of
which checks only sixteen rows. -/
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem r4_dual_table_chunks (q : Fin 128) :
    ∀ r : Fin 16,
      R4DualValidAt ⟨q.val * 16 + r.val, by omega⟩ := by
  fin_cases q <;> intro r <;> fin_cases r <;>
    unfold R4DualValidAt <;> decide +kernel

theorem r4_dual_table_valid (a : Fin 2048) : R4DualValidAt a := by
  let q : Fin 128 := ⟨a.val / 16, by omega⟩
  let r : Fin 16 := ⟨a.val % 16, Nat.mod_lt _ (by omega)⟩
  have h := r4_dual_table_chunks q r
  have hval : q.val * 16 + r.val = a.val := by
    dsimp [q, r]
    omega
  have hfin : (⟨q.val * 16 + r.val, by omega⟩ : Fin 2048) = a := by
    exact Fin.ext hval
  simpa [hfin] using h

theorem r4_no_bad_pair_dual
    {a b : ℕ} (ha : a < 2048) (hb : b < 2048)
    (hcompat : r4Compatible a b = true) :
    r4Surplus a b ≤ 10 := by
  have hcomp : R4Compatible a b := (r4Compatible_iff a b).mp hcompat
  let af : Fin 2048 := ⟨a, ha⟩
  rcases r4_dual_table_valid af with hsmall | hcert
  · have hs := r4Surplus_le_leftWeight hcomp.2
    dsimp [af] at hsmall
    omega
  · rcases hcert with ⟨hD, hobjective, hload⟩
    dsimp [af] at hD hobjective hload
    exact r4_surplus_le_ten_of_dual (r4DualP a) hD hobjective hload hcomp


end Erdos1011

