  exact 𝒜.image (fun I => I.map f)

theorem mapSupportFamilyEmbedding_map_injective {s t : ℕ} (f : Fin s ↪ Fin t) :
    Function.Injective (fun I : Finset (Fin s) => I.map f) := by
