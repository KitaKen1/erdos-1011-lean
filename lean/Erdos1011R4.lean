/-! A second finite r=4 capacity certificate, for the labelled residual
graph `2K₂` (edges 01 and 23).  The same pattern can be instantiated for the
P₃+K₁ and P₄ rows; keeping the definitions explicit makes the finite proof
auditable and keeps all enumeration in the kernel/native checker. -/

def r4TwoK2Type : Fin 8 → Finset V4
  | 0 => {0} | 1 => {1} | 2 => {2} | 3 => {0, 2}
  | 4 => {1, 2} | 5 => {3} | 6 => {0, 3} | 7 => {1, 3}

def r4TwoK2Types : Finset (Finset V4) := Finset.univ.image r4TwoK2Type

def r4TwoK2Family (a : ℕ) : Finset (Finset V4) :=
  (Finset.univ.filter (fun i : Fin 8 => Nat.testBit a i.1)).image r4TwoK2Type

def r4TwoK2Weight (a : ℕ) : ℕ :=
  ∑ i : Fin 8, if Nat.testBit a i.1 then (r4TwoK2Type i).card else 0

def r4TwoK2Hits (a : ℕ) (J : Finset V4) : ℕ :=
