erdos1011_elab_source r#"<Erdos1011.R4StarCapacity>"#
  r#"section Flattened_Erdos1011_R4StarCapacity

namespace Erdos1011

/-! Finite capacity table for the remaining triangle-free four-vertex shape,
the 3-star.  It is useful even though the paper proof can exclude this shape
by a direct colouring argument: keeping the table here makes the finite graph
dispatcher independent of that optional shortcut. -/

def r4StarType : Fin 8 → Finset V4
  | 0 => {0} | 1 => {1} | 2 => {2} | 3 => {3}
  | 4 => {1, 2} | 5 => {1, 3} | 6 => {2, 3} | 7 => {1, 2, 3}

def r4StarTypes : Finset (Finset V4) := Finset.univ.image r4StarType

def r4StarIndependent (I : Finset V4) : Prop :=
  ∀ ⦃x⦄, x ∈ I → ∀ ⦃y⦄, y ∈ I → x ≠ y →
    ¬ (x = (0 : V4) ∧ y = 1 ∨ x = 1 ∧ y = 0 ∨
      x = 0 ∧ y = 2 ∨ x = 2 ∧ y = 0 ∨
      x = 0 ∧ y = 3 ∨ x = 3 ∧ y = 0)

instance r4StarIndependent_decidable (I : Finset V4) :
    Decidable (r4StarIndependent I) := by
  unfold r4StarIndependent
  infer_instance

theorem r4Star_nonempty_independent
    {I : Finset V4} (hI : I.Nonempty)
    (hInd : r4StarIndependent I) : I ∈ r4StarTypes := by
  decide +kernel +revert

def r4StarFamily (a : ℕ) : Finset (Finset V4) :=
  (Finset.univ.filter (fun i : Fin 8 => Nat.testBit a i.1)).image r4StarType

def r4StarWeight (a : ℕ) : ℕ :=
  ∑ i : Fin 8, if Nat.testBit a i.1 then (r4StarType i).card else 0

def r4StarHits (a : ℕ) (J : Finset V4) : ℕ :=
  ∑ i : Fin 8,
    if Nat.testBit a i.1 && ¬ Disjoint (r4StarType i) J then 1 else 0

def r4StarCross (a b : ℕ) : ℕ :=
  ∑ i : Fin 8, if Nat.testBit b i.1 then r4StarHits a (r4StarType i) else 0

def r4StarSurplus (a b : ℕ) : ℕ :=
  r4StarWeight a + r4StarWeight b - r4StarCross a b

def r4StarCompatible (a b : ℕ) : Bool :=
  decide (∀ i : Fin 8, Nat.testBit a i.1 = true →
    (r4StarType i).card ≤ r4StarHits b (r4StarType i)) &&
  decide (∀ i : Fin 8, Nat.testBit b i.1 = true →
    (r4StarType i).card ≤ r4StarHits a (r4StarType i))

def r4StarBadPair (a b : ℕ) : Bool :=
  r4StarCompatible a b && decide (r4StarSurplus a b > 7)

def r4StarCapacityCertificate : Bool :=
  (List.range 256).all (fun a =>
    if r4StarWeight a ≤ 7 then true else
      (List.range 256).all (fun b => !r4StarBadPair a b))

theorem r4Star_capacity_certificate : r4StarCapacityCertificate = true := by
  decide +kernel

theorem r4Star_compatible_iff (a b : ℕ) :
    r4StarCompatible a b = true ↔
      (∀ i : Fin 8, Nat.testBit a i.1 = true →
        (r4StarType i).card ≤ r4StarHits b (r4StarType i)) ∧
      (∀ i : Fin 8, Nat.testBit b i.1 = true →
        (r4StarType i).card ≤ r4StarHits a (r4StarType i)) := by
  simp [r4StarCompatible]

theorem r4Star_surplus_le_of_certificate {a b : ℕ}
    (ha : a < 256) (hb : b < 256)
    (hcompat : r4StarCompatible a b = true) :
    r4StarSurplus a b ≤ 7 := by
  rcases (r4Star_compatible_iff a b).mp hcompat with ⟨haComp, hbComp⟩
  by_cases hsmall : r4StarWeight a ≤ 7
  · have hcross : r4StarWeight b ≤ r4StarCross a b := by
      unfold r4StarWeight r4StarCross
      apply Finset.sum_le_sum
      intro i hi
      by_cases hbi : Nat.testBit b i.1 = true
      · simp [hbi, hbComp i hbi]
      · simp [hbi]
    unfold r4StarSurplus
    omega
  · have hall := List.all_eq_true.mp r4Star_capacity_certificate
    have hentry := hall a (List.mem_range.mpr ha)
    simp [hsmall] at hentry
    have hbad := hentry b hb
    have hnot : ¬ r4StarBadPair a b := by simpa using hbad
    simp [r4StarBadPair, hcompat] at hnot
    omega

theorem r4Star_mask_weight (a : Fin 256) :
    supportWeight (r4StarFamily a.1) = r4StarWeight a.1 := by
  decide +kernel +revert

theorem r4Star_mask_hits (a : Fin 256) (i : Fin 8) :
    supportHits (r4StarFamily a.1) (r4StarType i) =
      r4StarHits a.1 (r4StarType i) := by
  decide +kernel +revert

theorem r4Star_mask_cross (a b : Fin 256) :
    supportCross (r4StarFamily a.1) (r4StarFamily b.1) =
      r4StarCross a.1 b.1 := by
  classical
  unfold supportCross r4StarFamily r4StarCross
  rw [Finset.sum_image]
  · rw [Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro i hi
    by_cases hbit : Nat.testBit b.val i.val = true
    · simp only [hbit, if_true]
      change supportHits (r4StarFamily a.val) (r4StarType i) = _
      exact r4Star_mask_hits a i
    · simp [hbit]
  · exact (by decide +kernel : Function.Injective r4StarType).injOn

def r4StarIndexMask (A : Finset (Fin 8)) : ℕ :=
  ∑ i ∈ A, 2 ^ i.1

theorem r4StarIndexMask_lt (A : Finset (Fin 8)) :
    r4StarIndexMask A < 256 := by
  decide +kernel +revert

theorem r4StarFamily_of_indexMask (A : Finset (Fin 8)) :
    r4StarFamily (r4StarIndexMask A) = A.image r4StarType := by
  decide +kernel +revert

theorem r4StarType_injective : Function.Injective r4StarType := by decide

theorem r4Star_exists_mask
    (𝒜 : Finset (Finset V4))
    (h𝒜 : ∀ I ∈ 𝒜, I ∈ r4StarTypes) :
    ∃ a : Fin 256, r4StarFamily a.1 = 𝒜 := by
  classical
  let A : Finset (Fin 8) := Finset.univ.filter (fun i => r4StarType i ∈ 𝒜)
  have hAeq : A.image r4StarType = 𝒜 := by
    ext I
    constructor
    · intro hI
      rcases Finset.mem_image.mp hI with ⟨i, hi, rfl⟩
      exact Finset.mem_filter.mp hi |>.2
    · intro hI
      have hIt := h𝒜 I hI
      rcases Finset.mem_image.mp hIt with ⟨i, hi, hEq⟩
      apply Finset.mem_image.mpr
      refine ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩, hEq⟩
      simpa [hEq] using hI
  refine ⟨⟨r4StarIndexMask A, r4StarIndexMask_lt A⟩, ?_⟩
  rw [r4StarFamily_of_indexMask, hAeq]

theorem r4_star_support_surplus_le_seven
    {𝒜 ℬ : Finset (Finset V4)}
    (h𝒜 : ∀ I ∈ 𝒜, I ∈ r4StarTypes)
    (hℬ : ∀ J ∈ ℬ, J ∈ r4StarTypes)
    (hcompat : DegreeCompatible 𝒜 ℬ) :
    supportSurplus 𝒜 ℬ ≤ 7 := by
  obtain ⟨a, ha⟩ := r4Star_exists_mask 𝒜 h𝒜
  obtain ⟨b, hb⟩ := r4Star_exists_mask ℬ hℬ
  have hc : r4StarCompatible a.1 b.1 = true := by
    apply (r4Star_compatible_iff _ _).mpr
    constructor
    · intro i hi
      have hiA : r4StarType i ∈ 𝒜 := by
        rw [← ha]
        exact Finset.mem_image.mpr ⟨i,
          Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩, rfl⟩
      have h := hcompat.1 _ hiA
      rw [← hb] at h
      rw [r4Star_mask_hits] at h
      simpa using h
    · intro i hi
      have hiB : r4StarType i ∈ ℬ := by
        rw [← hb]
        exact Finset.mem_image.mpr ⟨i,
          Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩, rfl⟩
      have h := hcompat.2 _ hiB
      rw [← ha] at h
      rw [r4Star_mask_hits] at h
      simpa using h
  have hbound := r4Star_surplus_le_of_certificate a.isLt b.isLt hc
  have hsurp : supportSurplus (r4StarFamily a.1)
      (r4StarFamily b.1) ≤ 7 := by
    unfold supportSurplus
    rw [r4Star_mask_weight, r4Star_mask_weight, r4Star_mask_cross]
    exact hbound
  simpa [ha, hb] using hsurp

end Erdos1011

end Flattened_Erdos1011_R4StarCapacity
