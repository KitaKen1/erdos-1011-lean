/- Relabeling helper used by the finite pattern dispatcher.  The domain and
  codomain both have four labels, so every support member is automatically in
  the range of the equivalence and can be pulled back. -/
theorem r4_graph_support_surplus_le_of_relabel
    (H : SimpleGraph V4) [DecidableRel H.Adj]
    (e : V4 ≃ V4) {𝒜 ℬ : Finset (Finset V4)}
    (h𝒜 : ∀ I ∈ 𝒜, I.Nonempty ∧ H.IsIndepSet (I : Set V4))
    (hℬ : ∀ J ∈ ℬ, J.Nonempty ∧ H.IsIndepSet (J : Set V4))
    (hcompat : DegreeCompatible 𝒜 ℬ)
    {q : ℕ}
    (hcap : supportSurplus
      (pullSupportFamilyEmbedding e.toEmbedding 𝒜)
      (pullSupportFamilyEmbedding e.toEmbedding ℬ) ≤ q) :
    supportSurplus 𝒜 ℬ ≤ q := by
  let 𝒜₀ := pullSupportFamilyEmbedding e.toEmbedding 𝒜
  let ℬ₀ := pullSupportFamilyEmbedding e.toEmbedding ℬ
  have hAto : familyMapsToEmbedding e.toEmbedding 𝒜 := by
    intro I hI z hz
    exact ⟨e.symm z, by simp⟩
  have hBto : familyMapsToEmbedding e.toEmbedding ℬ := by
    intro I hI z hz
    exact ⟨e.symm z, by simp⟩
  have hAmap : mapSupportFamilyEmbedding e.toEmbedding 𝒜₀ = 𝒜 := by
    simpa [𝒜₀] using map_pullSupportFamilyEmbedding_eq e.toEmbedding hAto
  have hBmap : mapSupportFamilyEmbedding e.toEmbedding ℬ₀ = ℬ := by
    simpa [ℬ₀] using map_pullSupportFamilyEmbedding_eq e.toEmbedding hBto
  have hcomp : DegreeCompatible 𝒜₀ ℬ₀ := by
    apply degreeCompatible_of_mapped_certificate e.toEmbedding
      (𝒜' := 𝒜) (ℬ' := ℬ)
    · exact hAmap.symm
    · exact hBmap.symm
    · exact hcompat
  calc
    supportSurplus 𝒜 ℬ = supportSurplus
        (mapSupportFamilyEmbedding e.toEmbedding 𝒜₀)
        (mapSupportFamilyEmbedding e.toEmbedding ℬ₀) := by rw [hAmap, hBmap]
    _ = supportSurplus 𝒜₀ ℬ₀ :=
      supportSurplus_mapSupportFamilyEmbedding e.toEmbedding 𝒜₀ ℬ₀
    _ ≤ q := by simpa [𝒜₀, ℬ₀] using hcap

theorem r4_graph_support_surplus_le_seven_of_star_any
    (H : SimpleGraph V4) [DecidableRel H.Adj]
    {c x y z : V4}
    (hcx : H.Adj c x) (hcy : H.Adj c y) (hcz : H.Adj c z)
    (hstar : c ≠ x ∧ c ≠ y ∧ c ≠ z ∧ x ≠ y ∧ x ≠ z ∧ y ≠ z)
    {𝒜 ℬ : Finset (Finset V4)}
    (h𝒜 : ∀ I ∈ 𝒜, I.Nonempty ∧ H.IsIndepSet (I : Set V4))
    (hℬ : ∀ J ∈ ℬ, J.Nonempty ∧ H.IsIndepSet (J : Set V4))
    (hcompat : DegreeCompatible 𝒜 ℬ) :
    supportSurplus 𝒜 ℬ ≤ 7 := by
  obtain ⟨e, he0, he1, he2, he3⟩ := r4_exists_quad_equiv c x y z
    hstar.1 hstar.2.2.2.2.2 hstar.2.1 hstar.2.2.1 hstar.2.2.2.1
      hstar.2.2.2.2.1
  have h01 : (H.comap e).Adj (0 : V4) 1 := by simpa [he0, he1] using hcx
  have h02 : (H.comap e).Adj (0 : V4) 2 := by simpa [he0, he2] using hcy
  have h03 : (H.comap e).Adj (0 : V4) 3 := by simpa [he0, he3] using hcz
  let 𝒜₀ := pullSupportFamilyEmbedding e.toEmbedding 𝒜
  let ℬ₀ := pullSupportFamilyEmbedding e.toEmbedding ℬ
  have h𝒜₀ : ∀ I ∈ 𝒜₀, I.Nonempty ∧ (H.comap e).IsIndepSet (I : Set V4) := by
    intro I hI
    rcases Finset.mem_image.mp hI with ⟨J, hJ, rfl⟩
    have hJ' := h𝒜 J hJ
    have hnon : (J.preimage e.toEmbedding e.injective.injOn).Nonempty := by
      rcases hJ'.1 with ⟨w, hw⟩
      refine ⟨e.symm w, Finset.mem_preimage.mpr ?_⟩
      simpa using hw
    refine ⟨hnon, ?_⟩
    intro a ha b hb hab hAdj
    exact hJ'.2 (Finset.mem_preimage.1 ha) (Finset.mem_preimage.1 hb)
      (fun h => hab (e.injective h)) hAdj
  have hℬ₀ : ∀ I ∈ ℬ₀, I.Nonempty ∧ (H.comap e).IsIndepSet (I : Set V4) := by
    intro I hI
    rcases Finset.mem_image.mp hI with ⟨J, hJ, rfl⟩
    have hJ' := hℬ J hJ
    have hnon : (J.preimage e.toEmbedding e.injective.injOn).Nonempty := by
      rcases hJ'.1 with ⟨w, hw⟩
      refine ⟨e.symm w, Finset.mem_preimage.mpr ?_⟩
      simpa using hw
    refine ⟨hnon, ?_⟩
    intro a ha b hb hab hAdj
    exact hJ'.2 (Finset.mem_preimage.1 ha) (Finset.mem_preimage.1 hb)
      (fun h => hab (e.injective h)) hAdj
  have hcomp₀ : DegreeCompatible 𝒜₀ ℬ₀ := by
    apply degreeCompatible_of_mapped_certificate e.toEmbedding
      (𝒜' := 𝒜) (ℬ' := ℬ)
    · simpa [𝒜₀] using (map_pullSupportFamilyEmbedding_eq e.toEmbedding
        (show familyMapsToEmbedding e.toEmbedding 𝒜 by
          intro I hI w hw; exact ⟨e.symm w, by simp⟩)).symm
    · simpa [ℬ₀] using (map_pullSupportFamilyEmbedding_eq e.toEmbedding
        (show familyMapsToEmbedding e.toEmbedding ℬ by
          intro I hI w hw; exact ⟨e.symm w, by simp⟩)).symm
    · exact hcompat
  exact r4_graph_support_surplus_le_of_relabel H e h𝒜 hℬ hcompat
    (r4_graph_support_surplus_le_seven_of_star (H.comap e) h01 h02 h03
      h𝒜₀ hℬ₀ hcomp₀)

/- The following transport lemmas are the other three nontrivial four-point
   patterns.  They deliberately keep the finite certificate in its labelled
   form and do only the isomorphism bookkeeping here. -/
theorem r4_pull_support_family_independent
    (H : SimpleGraph V4) (e : V4 ≃ V4)
    {𝒜 : Finset (Finset V4)}
    (h𝒜 : ∀ I ∈ 𝒜, I.Nonempty ∧ H.IsIndepSet (I : Set V4)) :
    ∀ I ∈ pullSupportFamilyEmbedding e.toEmbedding 𝒜,
      I.Nonempty ∧ (H.comap e).IsIndepSet (I : Set V4) := by
  intro I hI
  rcases Finset.mem_image.mp hI with ⟨J, hJ, rfl⟩
  have hJ' := h𝒜 J hJ
  have hnon : (J.preimage e.toEmbedding e.injective.injOn).Nonempty := by
    rcases hJ'.1 with ⟨z, hz⟩
    refine ⟨e.symm z, Finset.mem_preimage.mpr ?_⟩
    simpa using hz
  refine ⟨hnon, ?_⟩
  intro a ha b hb hab hAdj
  exact hJ'.2 (Finset.mem_preimage.1 ha) (Finset.mem_preimage.1 hb)
    (fun h => hab (e.injective h)) hAdj

theorem r4_graph_support_surplus_le_eight_of_twoK2_any
    (H : SimpleGraph V4) [DecidableRel H.Adj]
    {x₁ y₁ x₂ y₂ : V4}
    (h₁ : H.Adj x₁ y₁) (h₂ : H.Adj x₂ y₂)
    (hxy : x₁ ≠ x₂) (hxy' : x₁ ≠ y₂)
    (hyx : y₁ ≠ x₂) (hyy : y₁ ≠ y₂)
    {𝒜 ℬ : Finset (Finset V4)}
    (h𝒜 : ∀ I ∈ 𝒜, I.Nonempty ∧ H.IsIndepSet (I : Set V4))
    (hℬ : ∀ J ∈ ℬ, J.Nonempty ∧ H.IsIndepSet (J : Set V4))
    (hcompat : DegreeCompatible 𝒜 ℬ) :
    supportSurplus 𝒜 ℬ ≤ 8 := by
  obtain ⟨e, he0, he1, he2, he3⟩ := r4_exists_quad_equiv x₁ y₁ x₂ y₂
    h₁.ne h₂.ne hxy hxy' hyx hyy
  let H₀ := H.comap e
  let 𝒜₀ := pullSupportFamilyEmbedding e.toEmbedding 𝒜
  let ℬ₀ := pullSupportFamilyEmbedding e.toEmbedding ℬ
  have h𝒜₀ := r4_pull_support_family_independent H e h𝒜
  have hℬ₀ := r4_pull_support_family_independent H e hℬ
  have hAmap : mapSupportFamilyEmbedding e.toEmbedding 𝒜₀ = 𝒜 := by
    simpa [𝒜₀] using map_pullSupportFamilyEmbedding_eq e.toEmbedding
      (show familyMapsToEmbedding e.toEmbedding 𝒜 by
        intro I hI z hz; exact ⟨e.symm z, by simp⟩)
  have hBmap : mapSupportFamilyEmbedding e.toEmbedding ℬ₀ = ℬ := by
    simpa [ℬ₀] using map_pullSupportFamilyEmbedding_eq e.toEmbedding
      (show familyMapsToEmbedding e.toEmbedding ℬ by
        intro I hI z hz; exact ⟨e.symm z, by simp⟩)
  have hcomp₀ : DegreeCompatible 𝒜₀ ℬ₀ := by
    apply degreeCompatible_of_mapped_certificate e.toEmbedding
      (𝒜' := 𝒜) (ℬ' := ℬ)
    · exact hAmap.symm
    · exact hBmap.symm
    · exact hcompat
  have h01 : H₀.Adj (0 : V4) 1 := by simpa [H₀, he0, he1] using h₁
  have h23 : H₀.Adj (2 : V4) 3 := by simpa [H₀, he2, he3] using h₂
  exact r4_graph_support_surplus_le_of_relabel H e h𝒜 hℬ hcompat
    (r4_graph_support_surplus_le_eight_of_twoK2 H₀ h01 h23
      (by simpa [H₀] using h𝒜₀) (by simpa [H₀] using hℬ₀) hcomp₀)

theorem r4_graph_support_surplus_le_eight_of_p3_any
    (H : SimpleGraph V4) [DecidableRel H.Adj]
    {x y z : V4} (hxy : H.Adj x y) (hyz : H.Adj y z)
    (hxz : x ≠ z)
