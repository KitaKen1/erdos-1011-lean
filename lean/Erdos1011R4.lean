  intro v w₁ w₂ s t hw
  have hk : 1 < 1 := by
    simpa using hw.card_inter_lt_of_cliqueFree htri
  omega

theorem minDegree_le_two_mul_n_div_five_of_W10
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
