      (by simpa [H₀] using h𝒜₀) (by simpa [H₀] using hℬ₀) hcomp₀)

theorem r4_graph_support_surplus_le_seven_of_p4_any
    (H : SimpleGraph V4) [DecidableRel H.Adj]
    {x₀ x₁ x₂ x₃ : V4}
    (h01 : H.Adj x₀ x₁) (h12 : H.Adj x₁ x₂) (h23 : H.Adj x₂ x₃)
    (h02 : x₀ ≠ x₂) (h03 : x₀ ≠ x₃) (h13 : x₁ ≠ x₃)
