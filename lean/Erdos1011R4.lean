namespace Erdos1011

/-! Finite certificate for the 11-vertex equality case.

The one-edge residual `K₂ ⊔ K₁` has exactly five nonempty independent
supports.  They are encoded by `Fin 5`: the three singletons followed by the
two supports containing the isolated vertex.  The certificate below checks
that, when each side has at most three distinct nonempty types and the
degree-compatible surplus is four, the support incidence graph extends to a
proper three-colouring with endpoint colours `0` and `1`.
-/

def s3N11Support (k : Fin 5) : Finset V3 :=
  if k.val = 0 then {(0 : V3)} else
  if k.val = 1 then {(1 : V3)} else
  if k.val = 2 then {(2 : V3)} else
  if k.val = 3 then {(0 : V3), 2} else {(1 : V3), 2}

def s3N11Family (A : Finset (Fin 5)) : Finset (Finset V3) :=
  A.image s3N11Support

def s3N11Colorable (A B : Finset (Fin 5)) : Prop :=
  ∃ cS : V3 → Fin 3, ∃ cA : A → Fin 3,
    ∃ cB : B → Fin 3,
      cS 0 ≠ cS 1 ∧
      (∀ k : A, (∀ x ∈ s3N11Support k.1, cA k ≠ cS x) ∧ cA k ≠ 1) ∧
      (∀ k : B, (∀ x ∈ s3N11Support k.1, cB k ≠ cS x) ∧ cB k ≠ 0) ∧
      (∀ k : A, ∀ l : B, Disjoint (s3N11Support k.1)
        (s3N11Support l.1) → cA k ≠ cB l)

instance s3N11Colorable_decidable (A B : Finset (Fin 5)) :
    Decidable (s3N11Colorable A B) := by
  unfold s3N11Colorable
  let pB : (V3 → Fin 3) → (A → Fin 3) →
      (B → Fin 3) → Prop := fun cS cA cB =>
    cS 0 ≠ cS 1 ∧
      (∀ k : A, (∀ x ∈ s3N11Support k.1, cA k ≠ cS x) ∧ cA k ≠ 1) ∧
      (∀ k : B, (∀ x ∈ s3N11Support k.1, cB k ≠ cS x) ∧ cB k ≠ 0) ∧
      (∀ k : A, ∀ l : B, Disjoint (s3N11Support k.1)
        (s3N11Support l.1) → cA k ≠ cB l)
  let pA : (V3 → Fin 3) → (A → Fin 3) → Prop := fun cS cA =>
    ∃ cB, pB cS cA cB
  let pS : (V3 → Fin 3) → Prop := fun cS => ∃ cA, pA cS cA
  change Decidable (∃ cS, pS cS)
  letI : ∀ cS cA, DecidablePred (pB cS cA) := by
    intro cS cA cB
    dsimp [pB]
    infer_instance
  letI : ∀ cS, DecidablePred (pA cS) := by
    intro cS cA
    exact Fintype.decidableExistsFintype
  letI : DecidablePred pS := by
    intro cS
    exact Fintype.decidableExistsFintype
  exact Fintype.decidableExistsFintype

theorem s3N11_code_colorable_of_capacity :
    ∀ A B : Finset (Fin 5),
      A.card ≤ 3 → B.card ≤ 3 →
      supportSurplus (s3N11Family A) (s3N11Family B) = 4 →
      DegreeCompatible (s3N11Family A) (s3N11Family B) →
      s3N11Colorable A B := by
  decide +kernel

def s3N11Index (I : Finset V3) : Fin 5 :=
  if I = {(0 : V3)} then 0 else
  if I = {(1 : V3)} then 1 else
  if I = {(2 : V3)} then 2 else
  if I = {(0 : V3), 2} then 3 else 4

theorem s3N11_support_index_eq :
    ∀ I : Finset V3, I.Nonempty →
      s3Independent (1 : Fin 8) I →
      s3N11Support (s3N11Index I) = I := by
  decide +kernel

def s3N11CodeOfFamily (𝒜 : Finset (Finset V3)) : Finset (Fin 5) :=
  𝒜.image s3N11Index

theorem s3N11_code_family_eq
    {𝒜 : Finset (Finset V3)}
    (h𝒜 : ∀ I ∈ 𝒜, I.Nonempty ∧ s3Independent (1 : Fin 8) I) :
    s3N11Family (s3N11CodeOfFamily 𝒜) = 𝒜 := by
  classical
  ext I
  constructor
  · intro hI
    rcases Finset.mem_image.mp hI with ⟨k, hk, rfl⟩
    rcases Finset.mem_image.mp hk with ⟨J, hJ, rfl⟩
    have hEq := s3N11_support_index_eq J (h𝒜 J hJ).1 (h𝒜 J hJ).2
    simpa [hEq] using hJ
  · intro hI
    apply Finset.mem_image.mpr
    refine ⟨s3N11Index I, ?_, ?_⟩
    · exact Finset.mem_image.mpr ⟨I, hI, rfl⟩
    · exact s3N11_support_index_eq I (h𝒜 I hI).1 (h𝒜 I hI).2

def s3N11FamilyColorable (𝒜 ℬ : Finset (Finset V3)) : Prop :=
  ∃ cS : V3 → Fin 3, ∃ cA : 𝒜 → Fin 3,
    ∃ cB : ℬ → Fin 3,
      cS 0 ≠ cS 1 ∧
      (∀ I : 𝒜, (∀ x ∈ I.1, cA I ≠ cS x) ∧ cA I ≠ 1) ∧
      (∀ J : ℬ, (∀ x ∈ J.1, cB J ≠ cS x) ∧ cB J ≠ 0) ∧
      (∀ I : 𝒜, ∀ J : ℬ, Disjoint I.1 J.1 → cA I ≠ cB J)

theorem s3N11_family_colorable_of_capacity
    {𝒜 ℬ : Finset (Finset V3)}
    (h𝒜 : ∀ I ∈ 𝒜, I.Nonempty ∧ s3Independent (1 : Fin 8) I)
    (hℬ : ∀ J ∈ ℬ, J.Nonempty ∧ s3Independent (1 : Fin 8) J)
    (hcomp : DegreeCompatible 𝒜 ℬ)
    (h𝒜card : 𝒜.card ≤ 3) (hℬcard : ℬ.card ≤ 3)
    (hF : supportSurplus 𝒜 ℬ = 4) :
    s3N11FamilyColorable 𝒜 ℬ := by
  let A := s3N11CodeOfFamily 𝒜
  let B := s3N11CodeOfFamily ℬ
  have hAeq : s3N11Family A = 𝒜 := by
    simpa [A] using s3N11_code_family_eq h𝒜
  have hBeq : s3N11Family B = ℬ := by
    simpa [B] using s3N11_code_family_eq hℬ
  have hAcard : A.card ≤ 3 := by
    dsimp [A]
    exact (Finset.card_image_le).trans (by simpa using h𝒜card)
  have hBcard : B.card ≤ 3 := by
    dsimp [B]
    exact (Finset.card_image_le).trans (by simpa using hℬcard)
  have hF' : supportSurplus (s3N11Family A) (s3N11Family B) = 4 := by
    rw [hAeq, hBeq]
    exact hF
  have hcomp' : DegreeCompatible (s3N11Family A) (s3N11Family B) := by
    rw [hAeq, hBeq]
    exact hcomp
  obtain ⟨cS, cAc, cBc, hcS, hcA, hcB, hcAB⟩ :=
    s3N11_code_colorable_of_capacity A B hAcard hBcard hF' hcomp'
  let iA : ∀ I : 𝒜, A := fun I =>
    ⟨s3N11Index I.1, by
      dsimp [A]
      exact Finset.mem_image.mpr ⟨I.1, I.2, rfl⟩⟩
  let iB : ∀ J : ℬ, B := fun J =>
    ⟨s3N11Index J.1, by
      dsimp [B]
      exact Finset.mem_image.mpr ⟨J.1, J.2, rfl⟩⟩
  refine ⟨cS, (fun I => cAc (iA I)), (fun J => cBc (iB J)), hcS, ?_, ?_, ?_⟩
  · intro I
    have h := hcA (iA I)
    have hIeq : s3N11Support (iA I).1 = I.1 := by
      dsimp [iA]
      exact s3N11_support_index_eq I.1 (h𝒜 I.1 I.2).1 (h𝒜 I.1 I.2).2
    simpa [hIeq] using h
  · intro J
    have h := hcB (iB J)
    have hJeq : s3N11Support (iB J).1 = J.1 := by
      dsimp [iB]
      exact s3N11_support_index_eq J.1 (hℬ J.1 J.2).1 (hℬ J.1 J.2).2
    simpa [hJeq] using h
  · intro I J hdis
    apply hcAB (iA I) (iB J)
    have hIeq : s3N11Support (iA I).1 = I.1 := by
      dsimp [iA]
      exact s3N11_support_index_eq I.1 (h𝒜 I.1 I.2).1 (h𝒜 I.1 I.2).2
    have hJeq : s3N11Support (iB J).1 = J.1 := by
      dsimp [iB]
      exact s3N11_support_index_eq J.1 (hℬ J.1 J.2).1 (hℬ J.1 J.2).2
    simpa [hIeq, hJeq] using hdis

theorem s3N11_relabel_edge
    {H : SimpleGraph V3} [DecidableRel H.Adj]
    (hedge : ∃ x y : V3, H.Adj x y) :
    ∃ e : V3 ≃ V3, H.Adj (e 0) (e 1) := by
  rcases hedge with ⟨x, y, hxy⟩
  have hne : x ≠ y := H.ne_of_adj hxy
  fin_cases x <;> fin_cases y
  all_goals try { exact (hne rfl).elim }
  · exact ⟨Equiv.refl V3, by simpa using hxy⟩
  · exact ⟨Equiv.swap (1 : V3) 2,
      by simpa [Equiv.swap_apply_def] using hxy⟩
  · exact ⟨Equiv.swap (0 : V3) 1, by simpa using hxy⟩
  · exact ⟨(Equiv.swap (1 : V3) 2).trans (Equiv.swap (0 : V3) 1),
      by simpa [Equiv.trans_apply, Equiv.swap_apply_def] using hxy⟩
  · exact ⟨(Equiv.swap (0 : V3) 2).trans (Equiv.swap (0 : V3) 1),
      by simpa [Equiv.trans_apply, Equiv.swap_apply_def] using hxy⟩
  · exact ⟨Equiv.swap (0 : V3) 2,
      by simpa [Equiv.swap_apply_def] using hxy⟩

theorem s3N11_one_edge_adj_cases
    {H : SimpleGraph V3} [DecidableRel H.Adj]
    (hcard : H.edgeFinset.card = 1) (h01 : H.Adj 0 1) :
    ∀ i j : V3, H.Adj i j →
      (i = 0 ∧ j = 1) ∨ (i = 1 ∧ j = 0) := by
  rcases Finset.card_eq_one.mp hcard with ⟨e, he⟩
  have hmem01 : s(0, 1) ∈ H.edgeFinset := SimpleGraph.mem_edgeFinset.mpr h01
  have he01 : e = s(0, 1) := by
    rw [he] at hmem01
    exact (Finset.mem_singleton.mp hmem01).symm
  intro i j hij
  have hmem : s(i, j) ∈ H.edgeFinset := SimpleGraph.mem_edgeFinset.mpr hij
  have hse : s(i, j) = s(0, 1) := by
    rw [he] at hmem
    simp only [Finset.mem_singleton] at hmem
    exact hmem.trans he01
  fin_cases i <;> fin_cases j <;> simp_all

end Erdos1011

