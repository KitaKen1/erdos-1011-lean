    calc
      a * b ≤ (a + b) ^ 2 / 4 := hab
      _ = (n - 4) ^ 2 / 4 := by rw [hshift]
  have hbase : m ≤ (n - 4)^2 / 4 + 11 := by omega
  exact hbase.trans (four_candidate_gap_s4 hn)

theorem r4_residual_decomposition_bound_s4_total
    {n a b e q m : ℕ}
    (hn : 16 ≤ n)
    (hsum : a + b + 4 = n)
    (heq : e + q ≤ 11)
    (hdecomp : m ≤ a * b + e + q) :
    m ≤ fourMCandidate n := by
  have hab : a * b ≤ (a + b) ^ 2 / 4 := nat_mul_le_add_sq_div_four a b
  have hshift : a + b = n - 4 := by omega
  have hab' : a * b ≤ (n - 4) ^ 2 / 4 := by
    calc
      a * b ≤ (a + b) ^ 2 / 4 := hab
      _ = (n - 4) ^ 2 / 4 := by rw [hshift]
  have hbase : m ≤ (n - 4)^2 / 4 + 11 := by omega
  exact hbase.trans (four_candidate_gap_s4 hn)

theorem r4_residual_decomposition_bound_s5
    {n a b e q m : ℕ}
    (hn : 32 ≤ n)
    (hsum : a + b + 5 = n)
    (he : e ≤ 6) (hq : q ≤ 24)
    (hdecomp : m ≤ a * b + e + q) :
    m ≤ fourMCandidate n := by
  have hab : a * b ≤ (a + b) ^ 2 / 4 := nat_mul_le_add_sq_div_four a b
  have hshift : a + b = n - 5 := by omega
  have hab' : a * b ≤ (n - 5) ^ 2 / 4 := by
    calc
      a * b ≤ (a + b) ^ 2 / 4 := hab
      _ = (n - 5) ^ 2 / 4 := by rw [hshift]
  have hbase : m ≤ (n - 5)^2 / 4 + 30 := by omega
  exact hbase.trans (four_candidate_gap_s5 hn)

/- Degree-average arithmetic for the r=4 candidate.  The floor loss is at
   most three after multiplying by four, which is enough to force the
   residual set down to at most five vertices once n is at least 32. -/
theorem four_mul_fourMCandidate_ge
    {n : ℕ} (hn : 32 ≤ n) :
    n ^ 2 - 6 * n + 26 ≤ 4 * fourMCandidate n := by
  unfold fourMCandidate
  have hmod : (n - 3) ^ 2 % 4 < 4 := Nat.mod_lt _ (by omega)
  have hdiv := Nat.mod_add_div ((n - 3) ^ 2) 4
  have hmul : 4 * ((n - 3) ^ 2 / 4) ≤
      4 * ((n - 3) ^ 2 / 4) + 20 := by omega
  have hfloor : (n - 3) ^ 2 - 3 ≤ 4 * ((n - 3) ^ 2 / 4) := by
    omega
  have hshift : n = (n - 3) + 3 := by omega
  have hsq0 : n ^ 2 + 9 = (n - 3) ^ 2 + 6 * n := by
    rw [hshift]
    simp only [Nat.add_sub_cancel]
    ring
  have hnn : 6 * n ≤ n ^ 2 := by
    have := Nat.mul_le_mul_left n (show 6 ≤ n by omega)
    simpa [pow_two, Nat.mul_comm] using this
  have hsq : n ^ 2 - 6 * n + 26 = (n - 3) ^ 2 + 17 := by
    omega
  rw [hsq]
  omega

theorem r4_residual_decomposition_bound_s3
    {n a b m : ℕ}
    (hsum : a + b + 3 = n)
    (hdecomp : m ≤ a * b + 1 + 4) :
    m ≤ fourMCandidate n := by
  have hab : a * b ≤ (a + b) ^ 2 / 4 :=
    nat_mul_le_add_sq_div_four a b
  have hsub : n - 3 = a + b := by omega
  unfold fourMCandidate
  rw [hsub]
  omega

/- The three-point arithmetic bridge in its sharp form.  The graph-specific
   finite certificate supplies the combined estimate `e(H)+F ≤ 5`; keeping
   this as one hypothesis avoids losing the unit needed by the candidate. -/
theorem r4_residual_decomposition_bound_s3_total
    {n a b e q m : ℕ}
    (hsum : a + b + 3 = n)
    (heq : e + q ≤ 5)
    (hdecomp : m ≤ a * b + e + q) :
    m ≤ fourMCandidate n := by
  have hab : a * b ≤ (a + b) ^ 2 / 4 :=
    nat_mul_le_add_sq_div_four a b
  have hsub : n - 3 = a + b := by omega
  have hbound : m ≤ (a + b) ^ 2 / 4 + 5 := by
    have hstep : a * b + e + q ≤ (a + b) ^ 2 / 4 + e + q := by
      omega
    have htail : (a + b) ^ 2 / 4 + e + q ≤ (a + b) ^ 2 / 4 + 5 := by
      omega
    exact hdecomp.trans (hstep.trans htail)
  unfold fourMCandidate
  rw [hsub]
  exact hbound

theorem residual_ncard_le_five_of_degree_sum_bound
    {n m D s : ℕ} (hn : 32 ≤ n)
    (hm : fourMCandidate n ≤ m)
    (havg : 4 * m ≤ n * D)
    (hsum : D + s = n) :
    s ≤ 5 := by
