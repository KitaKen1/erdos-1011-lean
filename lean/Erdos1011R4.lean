erdos1011_elab_source r#"<Erdos1011.R4CapacityDual>"#
  r#"section Flattened_Erdos1011_R4CapacityDual

namespace Erdos1011

open scoped BigOperators

def r4DualLoad (a : ℕ) (p : Fin 11 → ℕ) (j : Fin 11) : ℕ :=
  ∑ i : Fin 11,
    if bitIn a i.val && maskIntersects (r4TypeMask j) (r4TypeMask i)
    then p i else 0

def r4DualObjective (a : ℕ) (p : Fin 11 → ℕ) : ℕ :=
  ∑ i : Fin 11,
    if bitIn a i.val then p i * r4TypeWeight i else 0

def r4DualDeficit (a b : ℕ) : ℕ :=
  ∑ j : Fin 11,
    if bitIn b j.val
    then r4Hits a (r4TypeMask j) - r4TypeWeight j
    else 0

set_option maxHeartbeats 1000000 in
theorem r4_weighted_hits_eq_dual_load
    (a b : ℕ) (p : Fin 11 → ℕ) :
    (∑ i : Fin 11,
      if bitIn a i.val then p i * r4Hits b (r4TypeMask i) else 0) =
    ∑ j : Fin 11,
      if bitIn b j.val then r4DualLoad a p j else 0 := by
  classical
  simp only [r4Hits, r4DualLoad]
  calc
    (∑ i : Fin 11,
        if bitIn a i.val then
          p i * ∑ j : Fin 11,
            if bitIn b j.val &&
                maskIntersects (r4TypeMask j) (r4TypeMask i)
            then 1 else 0
        else 0) =
        ∑ i : Fin 11, ∑ j : Fin 11,
          if bitIn a i.val && bitIn b j.val &&
              maskIntersects (r4TypeMask j) (r4TypeMask i)
          then p i else 0 := by
      apply Finset.sum_congr rfl
      intro i hi
      by_cases hai : bitIn a i.val = true
      · simp only [hai, if_true, Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro j hj
        by_cases hbj : bitIn b j.val = true
        · by_cases hij :
              maskIntersects (r4TypeMask i) (r4TypeMask j) = true
          · simp [hbj, hij]
          · simp [hbj, hij]
        · simp [hbj]
      · simp [hai]
    _ = ∑ j : Fin 11, ∑ i : Fin 11,
          if bitIn a i.val && bitIn b j.val &&
              maskIntersects (r4TypeMask j) (r4TypeMask i)
          then p i else 0 := Finset.sum_comm
    _ = ∑ j : Fin 11,
          if bitIn b j.val then
            ∑ i : Fin 11,
              if bitIn a i.val &&
                  maskIntersects (r4TypeMask j) (r4TypeMask i)
              then p i else 0
          else 0 := by
      apply Finset.sum_congr rfl
      intro j hj
      by_cases hbj : bitIn b j.val = true
      · simp [hbj]
      · simp [hbj]

/-- A short rational dual certificate replaces the exhaustive search over
all right-hand families.  `D` is the common positive denominator and `p`
contains the integer numerators. -/
theorem r4_surplus_le_ten_of_dual
    {a b D : ℕ} (p : Fin 11 → ℕ)
    (hD : 0 < D)
    (hobjective :
      D * (r4FamilyWeight a - 10) ≤ r4DualObjective a p)
    (hload : ∀ j : Fin 11,
      r4TypeWeight j ≤ r4Hits a (r4TypeMask j) →
        r4DualLoad a p j ≤
          D * (r4Hits a (r4TypeMask j) - r4TypeWeight j))
    (hcompat : R4Compatible a b) :
    r4Surplus a b ≤ 10 := by
  have hweighted : r4DualObjective a p ≤
      ∑ i : Fin 11,
        if bitIn a i.val
        then p i * r4Hits b (r4TypeMask i)
        else 0 := by
    unfold r4DualObjective
    apply Finset.sum_le_sum
    intro i hi
    by_cases hai : bitIn a i.val = true
    · simp only [hai, if_true]
      exact Nat.mul_le_mul_left (p i) (hcompat.1 i hai)
    · simp [hai]
  have hloads :
      (∑ j : Fin 11,
        if bitIn b j.val then r4DualLoad a p j else 0) ≤
      ∑ j : Fin 11,
        if bitIn b j.val
        then D * (r4Hits a (r4TypeMask j) - r4TypeWeight j)
        else 0 := by
    apply Finset.sum_le_sum
    intro j hj
    by_cases hbj : bitIn b j.val = true
    · simp only [hbj, if_true]
      exact hload j (hcompat.2 j hbj)
    · simp [hbj]
  have hdual :
      D * (r4FamilyWeight a - 10) ≤ D * r4DualDeficit a b := by
    calc
      D * (r4FamilyWeight a - 10) ≤ r4DualObjective a p := hobjective
      _ ≤ ∑ i : Fin 11,
          if bitIn a i.val
          then p i * r4Hits b (r4TypeMask i)
          else 0 := hweighted
      _ = ∑ j : Fin 11,
          if bitIn b j.val then r4DualLoad a p j else 0 :=
        r4_weighted_hits_eq_dual_load a b p
      _ ≤ ∑ j : Fin 11,
          if bitIn b j.val
          then D * (r4Hits a (r4TypeMask j) - r4TypeWeight j)
          else 0 := hloads
      _ = D * r4DualDeficit a b := by
        simp [r4DualDeficit, Finset.mul_sum, mul_ite]
  have hdeficit : r4FamilyWeight a - 10 ≤ r4DualDeficit a b := by
    exact (Nat.mul_le_mul_left_iff hD).mp hdual
  have hcross :
      r4FamilyWeight b + r4DualDeficit a b = r4Cross a b := by
    unfold r4FamilyWeight r4DualDeficit r4Cross
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro j hj
    by_cases hbj : bitIn b j.val = true
    · simp only [hbj, if_true]
      have hle := hcompat.2 j hbj
      omega
    · simp [hbj]
  unfold r4Surplus
  rw [← hcross]
  omega

end Erdos1011

end Flattened_Erdos1011_R4CapacityDual
