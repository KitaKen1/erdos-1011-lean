  apply s3_support_surplus_le_four e he hte 𝒜 ℬ
  · intro I hI
    refine ⟨(h𝒜 I hI).1, ?_⟩
    intro x hx y hy hxy hcode
    exact (h𝒜 I hI).2 hx hy hxy
      ((s3Adj_maskOfGraph_iff H x y).mp hcode)
  · intro J hJ
    refine ⟨(hℬ J hJ).1, ?_⟩
    intro x hx y hy hxy hcode
    exact (hℬ J hJ).2 hx hy hxy
      ((s3Adj_maskOfGraph_iff H x y).mp hcode)
  · exact hcompat

