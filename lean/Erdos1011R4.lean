erdos1011_elab_source r#"<Erdos1011.R4Capacity>"#
  r#"section Flattened_Erdos1011_R4Capacity

namespace Erdos1011

/-! A labelled `K₂ ⊔ 2K₁` support universe for the r=4 residual argument.
The Boolean certificate in `CapacityMasks.lean` uses the same eleven types as
the explicit finset universe below.  Families are represented by an eleven-bit
mask; only one-family finite enumeration is used to obtain a mask, avoiding an
exponential search over pairs of arbitrary `Finset` values. -/

abbrev V4 := Fin 4

def r4TypeFinset : Fin 11 → Finset V4
  | 0 => {0}
  | 1 => {1}
  | 2 => {2}
  | 3 => {0, 2}
  | 4 => {1, 2}
  | 5 => {3}
  | 6 => {0, 3}
  | 7 => {1, 3}
  | 8 => {2, 3}
  | 9 => {0, 2, 3}
  | 10 => {1, 2, 3}

def r4Types : Finset (Finset V4) := Finset.univ.image r4TypeFinset

def r4FamilyOfMask (a : ℕ) : Finset (Finset V4) :=
  (Finset.univ.filter (fun i : Fin 11 => bitIn a i.1)).image r4TypeFinset

theorem r4TypeFinset_injective : Function.Injective r4TypeFinset := by
  decide

theorem r4TypeFinset_mem_types (i : Fin 11) : r4TypeFinset i ∈ r4Types := by
  exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩

/- Every nonempty set avoiding the edge 0--1 is one of the eleven types. -/
theorem r4_nonempty_base_independent
    {I : Finset V4} (hI : I.Nonempty)
    (hInd : ∀ ⦃x⦄, x ∈ I → ∀ ⦃y⦄, y ∈ I → x ≠ y →
      ¬ (x = (0 : V4) ∧ y = 1 ∨ x = 1 ∧ y = 0)) :
    I ∈ r4Types := by
  decide +kernel +revert

/- We first encode a finset of the eleven indices.  This avoids enumerating
all `2^16` arbitrary families: only `2^11` index families occur. -/
def r4IndexFamily (A : Finset (Fin 11)) : Finset (Finset V4) :=
  A.image r4TypeFinset

def r4MaskOfIndices (A : Finset (Fin 11)) : ℕ :=
  ∑ i ∈ A, 2 ^ i.1

theorem r4MaskOfIndices_lt (A : Finset (Fin 11)) :
    r4MaskOfIndices A < 2048 := by
  unfold r4MaskOfIndices
  calc
    (∑ i ∈ A, 2 ^ i.val) ≤ ∑ i : Fin 11, 2 ^ i.val := by
      exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ A)
        (by simp)
    _ = 2047 := by decide +kernel
    _ < 2048 := by omega

private def r4IndexValues (A : Finset (Fin 11)) : Finset ℕ :=
  A.image Fin.val

private theorem r4MaskOfIndices_eq_values (A : Finset (Fin 11)) :
    r4MaskOfIndices A = ∑ i ∈ r4IndexValues A, 2 ^ i := by
  unfold r4MaskOfIndices r4IndexValues
  rw [Finset.sum_image]
  intro i hi j hj hij
  exact Fin.ext hij

private theorem bitIn_r4MaskOfIndices_iff
    (A : Finset (Fin 11)) (i : Fin 11) :
    bitIn (r4MaskOfIndices A) i.val = true ↔ i ∈ A := by
  rw [r4MaskOfIndices_eq_values]
  change Nat.testBit (∑ k ∈ r4IndexValues A, 2 ^ k) i.val = true ↔ i ∈ A
  rw [← Nat.mem_bitIndices]
  rw [← List.mem_toFinset]
  rw [Finset.toFinset_bitIndices_sum_two_pow]
  constructor
  · intro hi
    rcases Finset.mem_image.mp hi with ⟨j, hj, hval⟩
    have hji : j = i := Fin.ext hval
    simpa [hji] using hj
  · intro hi
    exact Finset.mem_image.mpr ⟨i, hi, rfl⟩

theorem r4FamilyOfMaskOfIndices (A : Finset (Fin 11)) :
    r4FamilyOfMask (r4MaskOfIndices A) = r4IndexFamily A := by
  unfold r4FamilyOfMask r4IndexFamily
  congr 1
  ext i
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  exact bitIn_r4MaskOfIndices_iff A i

theorem r4_exists_mask
    (𝒜 : Finset (Finset V4))
    (h𝒜 : ∀ I ∈ 𝒜, I ∈ r4Types) :
    ∃ a : Fin 2048, r4FamilyOfMask a.val = 𝒜 := by
  classical
  let A : Finset (Fin 11) := Finset.univ.filter (fun i => r4TypeFinset i ∈ 𝒜)
  have hAeq : r4IndexFamily A = 𝒜 := by
    ext I
    constructor
    · intro hI
      rcases Finset.mem_image.mp hI with ⟨i, hiA, rfl⟩
      exact Finset.mem_filter.mp hiA |>.2
    · intro hI
      have hIt : I ∈ r4Types := h𝒜 I hI
      rcases Finset.mem_image.mp hIt with ⟨i, hiuniv, hitype⟩
      have hiA : i ∈ A := Finset.mem_filter.mpr ⟨Finset.mem_univ _, by simpa [hitype] using hI⟩
      exact Finset.mem_image.mpr ⟨i, hiA, hitype⟩
  refine ⟨⟨r4MaskOfIndices A, r4MaskOfIndices_lt A⟩, ?_⟩
  rw [r4FamilyOfMaskOfIndices, hAeq]

/- The mask encoding preserves the numerical support quantities.  These
generic sum proofs replace exhaustive evaluation over all 2048 masks. -/
private theorem r4TypeWeight_eq_card_internal (i : Fin 11) :
    r4TypeWeight i = (r4TypeFinset i).card := by
  fin_cases i <;> decide +kernel

theorem r4_mask_weight (a : Fin 2048) :
    supportWeight (r4FamilyOfMask a.val) = r4FamilyWeight a.val := by
  classical
  unfold supportWeight r4FamilyOfMask r4FamilyWeight
  rw [Finset.sum_image]
  · rw [Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro i hi
    by_cases hbit : bitIn a.val i.val = true
    · simp [hbit, r4TypeWeight_eq_card_internal]
    · simp [hbit]
  · exact r4TypeFinset_injective.injOn

private theorem r4TypeIntersectsMask (i j : Fin 11) :
    (¬ Disjoint (r4TypeFinset i) (r4TypeFinset j)) ↔
      maskIntersects (r4TypeMask i) (r4TypeMask j) = true := by
  fin_cases i <;> fin_cases j <;> decide +kernel

theorem r4_mask_hits (a : Fin 2048) (i : Fin 11) :
    supportHits (r4FamilyOfMask a.val) (r4TypeFinset i) =
      r4Hits a.val (r4TypeMask i) := by
  classical
  unfold supportHits r4FamilyOfMask r4Hits
  rw [Finset.sum_image]
  · rw [Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro j hj
    by_cases hbit : bitIn a.val j.val = true
    · simp only [hbit, Bool.true_and, if_true]
      by_cases hdis : Disjoint (r4TypeFinset j) (r4TypeFinset i)
      · have hmask :
            maskIntersects (r4TypeMask j) (r4TypeMask i) = false := by
          apply Bool.eq_false_iff.mpr
          intro htrue
          exact ((r4TypeIntersectsMask j i).mpr htrue) hdis
        simp [hdis, hmask]
      · have hmask :
            maskIntersects (r4TypeMask j) (r4TypeMask i) = true :=
          (r4TypeIntersectsMask j i).mp hdis
        simp [hdis, hmask]
    · simp [hbit]
  · exact r4TypeFinset_injective.injOn

end Erdos1011

end Flattened_Erdos1011_R4Capacity
