      supportHits 𝒜 I := by
  classical
  unfold supportHits mapSupportFamily
  rw [Finset.sum_image (mapSupportFamily_map_injOn e 𝒜)]
  apply Finset.sum_congr rfl
  intro J hJ
  simp only [mapSupportFamily_disjoint_iff]

theorem supportCross_mapSupportFamily {s t : ℕ} (e : Fin s ≃ Fin t)
    (𝒜 ℬ : Finset (Finset (Fin s))) :
