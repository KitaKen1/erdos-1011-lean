theorem supportHits_mapSupportFamilyEmbedding {s t : ℕ} (f : Fin s ↪ Fin t)
    (𝒜 : Finset (Finset (Fin s))) (I : Finset (Fin s)) :
    supportHits (mapSupportFamilyEmbedding f 𝒜) (I.map f) =
      supportHits 𝒜 I := by
