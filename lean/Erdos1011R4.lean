          simp [s3Adj, s3EdgeIndex, s3MaskOfGraph, h01, h12, h02,
            h10, h21, h20] <;> decide +kernel

theorem s3TriangleFree_maskOfGraph
    (H : SimpleGraph V3) [DecidableRel H.Adj]
    (htri : H.CliqueFree 3) :
    s3TriangleFree (s3MaskOfGraph H) := by
  intro x y z hxy hxz hyz
