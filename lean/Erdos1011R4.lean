/-! ===== Flattened module: Erdos1011.R4MaxDegreeSemantics ===== -/

erdos1011_elab_source r#"<Erdos1011.R4MaxDegreeSemantics>"#
  r#"section Flattened_Erdos1011_R4MaxDegreeSemantics

/-!
# Semantics of the maximum-degree case split

The SAT certificates use one representative for each possible maximum degree:
a maximum-degree vertex is renamed to `0` and its neighborhood to
`{1, ..., d}`.  This file proves that the additional CNF clauses express
exactly those two normalizing conditions.
-/

namespace Erdos1011.R4MaxDegreeCNF

open Std Sat
open R4SmallOrderCNF

theorem chooseLex_spec {α : Type*} {k : Nat} {xs ys : List α}
    (h : ys ∈ chooseLex k xs) : ys.length = k ∧ ys.Sublist xs := by
  induction xs generalizing k ys with
  | nil =>
      cases k with
      | zero =>
          simp [chooseLex] at h
          subst ys
          exact ⟨rfl, .slnil⟩
      | succ k => simp [chooseLex] at h
  | cons x xs ih =>
      cases k with
      | zero =>
          simp [chooseLex] at h
          subst ys
          simp
      | succ k =>
          simp only [chooseLex, List.mem_append, List.mem_map] at h
          rcases h with ⟨zs, hzs, rfl⟩ | h
          · obtain ⟨hlen, hsub⟩ := ih hzs
            exact ⟨by simp [hlen], hsub.cons_cons _⟩
