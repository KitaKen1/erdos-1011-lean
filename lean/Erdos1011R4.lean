/- A complete four-point dispatcher.  The finite pattern certificate first
   identifies the residual graph; the corresponding labelled capacity theorem
   then supplies the support bound.  The output is intentionally the combined
   `e + q` bound needed by the arithmetic endgame. -/
theorem residual_four_capacity_dispatch
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (hG : HighChromaticTriangleFree 4 n G)
    {u v : Fin n} (huv : G.Adj u v)
    (hS : (residualSet G u v).ncard = 4)
    (hcompat : DegreeCompatible (supportFamilyA G u v)
      (supportFamilyB G u v)) :
    ∃ e q : ℕ,
      (G.induce (residualFinset G u v : Set (Fin n))).edgeFinset.card ≤ e ∧
      supportSurplus (supportFamilyA G u v) (supportFamilyB G u v) ≤ q ∧
      e + q ≤ 11 := by
  let T := residualFinset G u v
  have hTcard : T.card = 4 := by
    dsimp [T]
    rw [residualFinset_card_eq_ncard]
    exact hS
  have hTsub : ∀ z, z ∈ residualSet G u v → z ∈ T := by
    intro z hz
    exact mem_residualFinset_iff.mpr hz
  let f := residualFourEmbedding T hTcard
  let H := G.comap f
  have hrange : Set.range f = (T : Set (Fin n)) :=
    residualFourEmbedding_range T hTcard
  have hcardIso : H.edgeFinset.card =
      (G.induce (residualFinset G u v : Set (Fin n))).edgeFinset.card := by
    let g : V4 → (residualFinset G u v : Set (Fin n)) := fun i =>
      ⟨f i, by
        have hi : f i ∈ (T : Set (Fin n)) := by
          rw [← hrange]
          exact ⟨i, rfl⟩
        exact hi⟩
    have hginj : Function.Injective g := by
      intro i j hij
      apply f.injective
      exact congrArg Subtype.val hij
    have hgsurj : Function.Surjective g := by
      intro y
      have hyT : y.1 ∈ (T : Set (Fin n)) := y.2
      have hyrange : y.1 ∈ Set.range f := by
        rw [hrange]
        exact hyT
      rcases Set.mem_range.mp hyrange with ⟨i, hi⟩
      refine ⟨i, Subtype.ext ?_⟩
      exact hi
    let eS : V4 ≃ (residualFinset G u v : Set (Fin n)) :=
      Equiv.ofBijective g ⟨hginj, hgsurj⟩
    let iso : H ≃g G.induce (residualFinset G u v : Set (Fin n)) :=
      { toEquiv := eS
        map_rel_iff' := by
          intro i j
          change H.Adj i j ↔
            (G.induce (residualFinset G u v : Set (Fin n))).Adj (eS i) (eS j)
          change G.Adj (f i) (f j) ↔ G.Adj (eS i).1 (eS j).1
          have hi : (eS i).1 = f i := by rfl
          have hj : (eS j).1 = f j := by rfl
          rw [hi, hj] }
    exact iso.card_edgeFinset_eq
  have hHtri : H.CliqueFree 3 := by
    intro s hs
    rcases SimpleGraph.is3Clique_iff.mp hs with ⟨a, b, c, hab, hac, hbc, _⟩
    apply hG.1
    exact SimpleGraph.is3Clique_triple_iff.mpr
      ⟨hab, hac, hbc⟩
  have hresEdge : ∃ x y : Fin n,
      x ∈ residualSet G u v ∧ y ∈ residualSet G u v ∧ G.Adj x y :=
    residual_has_edge_of_high_four hG huv
  have hHEdge : ∃ x y : V4, H.Adj x y := by
    rcases hresEdge with ⟨x, y, hx, hy, hxy⟩
    have hxT : x ∈ T := hTsub x hx
    have hyT : y ∈ T := hTsub y hy
    have hrange := residualFourEmbedding_range T hTcard
    have hxrange : x ∈ Set.range f := by
      rw [hrange]
      exact hxT
    have hyrange : y ∈ Set.range f := by
      rw [hrange]
      exact hyT
    rcases Set.mem_range.mp hxrange with ⟨i, hi⟩
    rcases Set.mem_range.mp hyrange with ⟨j, hj⟩
    refine ⟨i, j, ?_⟩
    change G.Adj (f i) (f j)
    simpa [hi, hj] using hxy
  have hHcard_pos : 0 < H.edgeFinset.card := by
    rcases hHEdge with ⟨x, y, hxy⟩
    exact Finset.card_pos.mpr ⟨s(x, y), SimpleGraph.mem_edgeFinset.mpr hxy⟩
  have hpat := r4_graph_pattern_certificate H hHtri
  rcases hpat with h0 | ⟨h1, hEdge⟩ | ⟨h2, hP⟩ | ⟨h3, hP⟩
  · exfalso
    omega
  · refine ⟨1, 10, ?_, ?_, by norm_num⟩
    · have hcard : H.edgeFinset.card = 1 := h1
      -- The embedding of `T` is exactly the residual set in this branch.
      rw [← hcardIso]
      exact hcard.le
    · exact residual_four_capacity_of_local hG.1 huv hTcard hTsub hcompat
        (by
          intro 𝒜 ℬ h𝒜 hℬ hc
          exact r4_graph_support_surplus_le_ten_of_any_edge H hHEdge h𝒜 hℬ hc)
  · refine ⟨2, 8, ?_, ?_, by norm_num⟩
    · have hcard : H.edgeFinset.card = 2 := h2
      rw [← hcardIso]
      exact hcard.le
    · rcases hP with hP | hP
      · rcases hP with ⟨x, y, z, hxy, hyz, hxz⟩
        exact residual_four_capacity_of_local hG.1 huv hTcard hTsub hcompat
          (by
            intro 𝒜 ℬ h𝒜 hℬ hc
            exact r4_graph_support_surplus_le_eight_of_p3_any H hxy hyz hxz
              h𝒜 hℬ hc)
      · rcases hP with ⟨x₁, y₁, x₂, y₂, h₁, h₂, hxy, hxy', hyx, hyy⟩
        exact residual_four_capacity_of_local hG.1 huv hTcard hTsub hcompat
          (by
            intro 𝒜 ℬ h𝒜 hℬ hc
            exact r4_graph_support_surplus_le_eight_of_twoK2_any H h₁ h₂
              hxy hxy' hyx hyy h𝒜 hℬ hc)
  · refine ⟨4, 7, ?_, ?_, by norm_num⟩
    · have hmantel := edgeCount_le_turan_triangle_free hHtri
      rw [edgeCount_eq_edgeFinset_card_r4] at hmantel
      norm_num at hmantel
      rw [← hcardIso]
      exact hmantel
    · rcases hP with hP | hP
      · rcases hP with ⟨x₀, x₁, x₂, x₃, h01, h12, h23, h02, h03, h13⟩
        exact residual_four_capacity_of_local hG.1 huv hTcard hTsub hcompat
          (by
            intro 𝒜 ℬ h𝒜 hℬ hc
            exact r4_graph_support_surplus_le_seven_of_p4_any H h01 h12 h23
              h02 h03 h13 h𝒜 hℬ hc)
      · rcases hP with ⟨c, x, y, z, hcx, hcy, hcz, hstar⟩
        exact residual_four_capacity_of_local hG.1 huv hTcard hTsub hcompat
          (by
            intro 𝒜 ℬ h𝒜 hℬ hc
            exact r4_graph_support_surplus_le_seven_of_star_any H hcx hcy hcz
