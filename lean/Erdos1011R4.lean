      exact htri _ (SimpleGraph.is3Clique_triple_iff.mpr ⟨huv, huz, hzA.1⟩)
    have hnot_v_B {z : Fin n} (hzB : z ∈ edgeSideBSet G u v)
        (hvz : G.Adj v z) : False := by
      exact htri _ (SimpleGraph.is3Clique_triple_iff.mpr ⟨huv.symm, hvz, hzB.1⟩)
