erdos1011_elab_source r#"<Erdos1011.SmallCapacity>"#
  r#"section Flattened_Erdos1011_SmallCapacity

namespace Erdos1011

/- A tiny executable model for residual graphs on three labelled vertices.  The
   three unordered pairs are encoded by bits 0,1,2 of an eight-valued edge
   mask; bits above 2 are ignored.  This keeps the finite capacity theorem
   independent of any particular `SimpleGraph` representation. -/
abbrev V3 := Fin 3

def s3EdgeIndex (x y : V3) : Fin 3 :=
  if x.val = 0 then
    if y.val = 1 then 0 else 2
  else if x.val = 1 then
    if y.val = 0 then 0 else 1
  else if y.val = 0 then 2 else 1

def s3Adj (e : Fin 8) (x y : V3) : Prop :=
  x ≠ y ∧ Nat.testBit e.val (s3EdgeIndex x y).val

instance s3Adj_decidable (e : Fin 8) : DecidableRel (s3Adj e) := by
  intro x y
  unfold s3Adj
  infer_instance

def s3TriangleFree (e : Fin 8) : Prop :=
  ∀ ⦃x y z : V3⦄, s3Adj e x y → s3Adj e x z → s3Adj e y z → False

instance s3TriangleFree_decidable (e : Fin 8) : Decidable (s3TriangleFree e) := by
  unfold s3TriangleFree
  infer_instance

def s3Independent (e : Fin 8) (I : Finset V3) : Prop :=
  ∀ ⦃x⦄, x ∈ I → ∀ ⦃y⦄, y ∈ I → x ≠ y → ¬ s3Adj e x y

instance s3Independent_decidable (e : Fin 8) (I : Finset V3) :
    Decidable (s3Independent e I) := by
  unfold s3Independent
  infer_instance

def s3HasEdge (e : Fin 8) : Prop := e.val % 8 ≠ 0

instance s3HasEdge_decidable (e : Fin 8) : Decidable (s3HasEdge e) := by
  unfold s3HasEdge
  infer_instance

/- The number of residual edges in the three-vertex mask.  The bit order is
   the same as `s3EdgeIndex`: `01`, `12`, `02`. -/
def s3EdgeCount (e : Fin 8) : ℕ :=
  (if Nat.testBit e.val 0 then 1 else 0) +
  (if Nat.testBit e.val 1 then 1 else 0) +
  (if Nat.testBit e.val 2 then 1 else 0)

instance s3EdgeCount_decidable (e : Fin 8) : Decidable (s3EdgeCount e = 1) := by
  unfold s3EdgeCount
  infer_instance

instance s3DegreeCompatible_decidable
    (𝒜 ℬ : Finset (Finset V3)) : Decidable (DegreeCompatible 𝒜 ℬ) := by
  unfold DegreeCompatible
  infer_instance

/- Exhaustive finite capacity check corresponding to the paper's `s≤3` case.
   The hypothesis says that every support is nonempty and independent in the
   encoded residual graph; `DegreeCompatible` is exactly the local degree
   condition extracted from the extremal edge.

   Keeping the eight edge masks in separate declarations is important for a
   browser checker: after checking one mask, Lean can release its evaluator
   state before starting the next one.  The final theorem merely dispatches on
   `e`; no additional trust assumption is introduced by this partition. -/
private def S3SupportSurplusBoundAt (e : Fin 8) : Prop :=
  s3HasEdge e → s3TriangleFree e →
    ∀ 𝒜 ℬ : Finset (Finset V3),
      (∀ I ∈ 𝒜, I.Nonempty ∧ s3Independent e I) →
      (∀ J ∈ ℬ, J.Nonempty ∧ s3Independent e J) →
      DegreeCompatible 𝒜 ℬ →
      supportSurplus 𝒜 ℬ ≤ 4

private theorem s3_support_surplus_bound_0 :
    S3SupportSurplusBoundAt (0 : Fin 8) := by
  unfold S3SupportSurplusBoundAt
  decide +kernel
private theorem s3_support_surplus_bound_1 :
    S3SupportSurplusBoundAt (1 : Fin 8) := by
  unfold S3SupportSurplusBoundAt
  decide +kernel
private theorem s3_support_surplus_bound_2 :
    S3SupportSurplusBoundAt (2 : Fin 8) := by
  unfold S3SupportSurplusBoundAt
  decide +kernel
private theorem s3_support_surplus_bound_3 :
    S3SupportSurplusBoundAt (3 : Fin 8) := by
  unfold S3SupportSurplusBoundAt
  decide +kernel
private theorem s3_support_surplus_bound_4 :
    S3SupportSurplusBoundAt (4 : Fin 8) := by
  unfold S3SupportSurplusBoundAt
  decide +kernel
private theorem s3_support_surplus_bound_5 :
    S3SupportSurplusBoundAt (5 : Fin 8) := by
  unfold S3SupportSurplusBoundAt
  decide +kernel
private theorem s3_support_surplus_bound_6 :
    S3SupportSurplusBoundAt (6 : Fin 8) := by
  unfold S3SupportSurplusBoundAt
  decide +kernel
private theorem s3_support_surplus_bound_7 :
    S3SupportSurplusBoundAt (7 : Fin 8) := by
  unfold S3SupportSurplusBoundAt
  decide +kernel

theorem s3_support_surplus_le_four :
    ∀ e : Fin 8, s3HasEdge e → s3TriangleFree e →
      ∀ 𝒜 ℬ : Finset (Finset V3),
        (∀ I ∈ 𝒜, I.Nonempty ∧ s3Independent e I) →
        (∀ J ∈ ℬ, J.Nonempty ∧ s3Independent e J) →
        DegreeCompatible 𝒜 ℬ →
        supportSurplus 𝒜 ℬ ≤ 4 := by
  intro e
  fin_cases e
  · exact s3_support_surplus_bound_0
  · exact s3_support_surplus_bound_1
  · exact s3_support_surplus_bound_2
  · exact s3_support_surplus_bound_3
  · exact s3_support_surplus_bound_4
  · exact s3_support_surplus_bound_5
  · exact s3_support_surplus_bound_6
  · exact s3_support_surplus_bound_7

end Erdos1011

end Flattened_Erdos1011_SmallCapacity
