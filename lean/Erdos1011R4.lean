theorem supportFamilyB_degree_compatible_of_degree_sum_max
    {r n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (hG : HighExtremal r n G)
    {u v : Fin n} (huv : G.Adj u v)
    (hD : ∀ H a b, HighExtremalEdgePairs r n (H, (a, b)) →
