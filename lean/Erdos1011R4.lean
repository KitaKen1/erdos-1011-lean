  have hs6 : 6 ≤ s := by omega
  have hn6 : 6 ≤ n := by omega
  have hprod : 6 * n ≤ s * n := by
    simpa [Nat.mul_comm] using Nat.mul_le_mul_right n hs6
  have hprod' : 6 * n ≤ n * s := by
    simpa [Nat.mul_comm] using hprod
  have hsq : 6 * n ≤ n ^ 2 := by
    have := Nat.mul_le_mul_left n hn6
    simpa [pow_two, Nat.mul_comm] using this
  have hsq' : 6 * n ≤ n * n := by
    simpa [pow_two] using hsq
