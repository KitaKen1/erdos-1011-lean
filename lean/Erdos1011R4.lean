/- Reindexing lemmas for a selected path.  The finite proof starts with the
first two images and swaps the two unused domain labels if necessary. -/
theorem r4_exists_triple_equiv (x y z : V4)
    (hxy : x ≠ y) (hyz : y ≠ z) (hxz : x ≠ z) :
    ∃ e : V4 ≃ V4, e 0 = x ∧ e 1 = y ∧ e 2 = z := by
  obtain ⟨e, he0, he1⟩ := r4_exists_pair_equiv x y hxy
  have hz0 : e.symm z ≠ 0 := by
    intro h
    apply hxz
    rw [← he0, ← h]
    simp
  have hz1 : e.symm z ≠ 1 := by
    intro h
    apply hyz
    rw [← he1, ← h]
    simp
  let w : V4 := e.symm z
  have hw0 : w ≠ 0 := by simpa [w] using hz0
  have hw1 : w ≠ 1 := by simpa [w] using hz1
  have hz : w = 2 ∨ w = 3 := fin4_eq_two_or_three hw0 hw1
  rcases hz with hz2 | hz3
  · exact ⟨e, he0, he1, by
      have := congrArg e (show e.symm z = 2 by simpa [w] using hz2)
      simpa using this.symm⟩
  · let e' : V4 ≃ V4 := (Equiv.swap (2 : V4) 3).trans e
    have he'0 : e' 0 = x := by
      dsimp [e']; simp only [Equiv.swap_apply_def]
      exact he0
    have he'1 : e' 1 = y := by
      dsimp [e']; simp only [Equiv.swap_apply_def]
      exact he1
    have he'2 : e' 2 = z := by
      dsimp [e']; change e 3 = z
      have := congrArg e (show e.symm z = 3 by simpa [w] using hz3)
      simpa using this.symm
    exact ⟨e', he'0, he'1, he'2⟩

theorem r4_exists_quad_equiv (x₁ y₁ x₂ y₂ : V4)
    (h₁ : x₁ ≠ y₁) (h₂ : x₂ ≠ y₂)
    (hxy : x₁ ≠ x₂) (hxy' : x₁ ≠ y₂)
    (hyx : y₁ ≠ x₂) (hyy : y₁ ≠ y₂) :
    ∃ e : V4 ≃ V4, e 0 = x₁ ∧ e 1 = y₁ ∧ e 2 = x₂ ∧ e 3 = y₂ := by
  obtain ⟨e, he0, he1⟩ := r4_exists_pair_equiv x₁ y₁ h₁
  have hx2_0 : e.symm x₂ ≠ 0 := by
    intro h; apply hxy; rw [← he0, ← h]; simp
  have hx2_1 : e.symm x₂ ≠ 1 := by
    intro h; apply hyx; rw [← he1, ← h]; simp
  have hy2_0 : e.symm y₂ ≠ 0 := by
    intro h; apply hxy'; rw [← he0, ← h]; simp
  have hy2_1 : e.symm y₂ ≠ 1 := by
    intro h; apply hyy; rw [← he1, ← h]; simp
  let wx : V4 := e.symm x₂
  let wy : V4 := e.symm y₂
  have hwx0 : wx ≠ 0 := by simpa [wx] using hx2_0
  have hwx1 : wx ≠ 1 := by simpa [wx] using hx2_1
  have hwy0 : wy ≠ 0 := by simpa [wy] using hy2_0
  have hwy1 : wy ≠ 1 := by simpa [wy] using hy2_1
  have hx2 : wx = 2 ∨ wx = 3 := fin4_eq_two_or_three hwx0 hwx1
  have hy2 : wy = 2 ∨ wy = 3 := fin4_eq_two_or_three hwy0 hwy1
  rcases hx2 with hx2 | hx3 <;> rcases hy2 with hy2 | hy3
  · have heq : x₂ = y₂ := by
      calc
        x₂ = e (e.symm x₂) := (e.apply_symm_apply x₂).symm
        _ = e (e.symm y₂) := by rw [show e.symm x₂ = 2 by simpa [wx] using hx2,
          show e.symm y₂ = 2 by simpa [wy] using hy2]
        _ = y₂ := e.apply_symm_apply y₂
    exact (h₂ heq).elim
  · exact ⟨e, he0, he1,
      by simpa [wx] using (congrArg e hx2).symm,
      by simpa [wy] using (congrArg e hy3).symm⟩
  · exact ⟨(Equiv.swap (2 : V4) 3).trans e,
      by dsimp; simp only [Equiv.swap_apply_def]; exact he0,
      by dsimp; simp only [Equiv.swap_apply_def]; exact he1,
      by simpa [wx] using (congrArg e hx3).symm,
      by simpa [wy] using (congrArg e hy2).symm⟩
  · have heq : x₂ = y₂ := by
      calc
        x₂ = e (e.symm x₂) := (e.apply_symm_apply x₂).symm
        _ = e (e.symm y₂) := by rw [show e.symm x₂ = 3 by simpa [wx] using hx3,
          show e.symm y₂ = 3 by simpa [wy] using hy3]
        _ = y₂ := e.apply_symm_apply y₂
    exact (h₂ heq).elim

end Erdos1011

