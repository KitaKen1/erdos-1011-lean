/-! ===== Flattened module: Erdos1011.R4SmallOrderSemantics ===== -/

erdos1011_elab_source r#"<Erdos1011.R4SmallOrderSemantics>"#
  r#"section Flattened_Erdos1011_R4SmallOrderSemantics

/-! Semantic interpretation of the ten-vertex graph CNF, independent of any certificate. -/

namespace Erdos1011

open Std Sat

namespace R4SmallOrderCNF

theorem canonicalTails_length :
    ∀ remaining seenMax c,
      c ∈ canonicalTails remaining seenMax → c.length = remaining := by
  intro remaining
  induction remaining with
  | zero =>
      intro seenMax c hc
      have : c = [] := by simpa [canonicalTails] using hc
      subst c
      simp
  | succ remaining ih =>
      intro seenMax c hc
      rw [canonicalTails] at hc
      rcases List.mem_flatMap.mp hc with ⟨colour, hcolour, hc⟩
      rcases List.mem_map.mp hc with ⟨tail, htail, rfl⟩
      simp [ih _ _ htail]

theorem canonicalTails_lt_three :
    ∀ remaining seenMax c,
      c ∈ canonicalTails remaining seenMax → ∀ x ∈ c, x < 3 := by
  intro remaining
  induction remaining with
  | zero =>
      intro seenMax c hc
      have : c = [] := by simpa [canonicalTails] using hc
      subst c
      simp
  | succ remaining ih =>
      intro seenMax c hc
      rw [canonicalTails] at hc
      rcases List.mem_flatMap.mp hc with ⟨colour, hcolour, hc⟩
      rcases List.mem_map.mp hc with ⟨tail, htail, rfl⟩
      intro x hx
      simp only [List.mem_cons] at hx
      rcases hx with rfl | hx
      · have hlt := List.mem_range.mp hcolour
        omega
      · exact ih _ _ htail x hx

theorem canonicalColourings_spec {c : Colouring}
    (hc : c ∈ canonicalColourings) :
    c.length = vertexCount ∧ ∀ x ∈ c, x < 3 := by
  rw [canonicalColourings] at hc
  rcases List.mem_map.mp hc with ⟨tail, htail, rfl⟩
  constructor
  · simp [vertexCount, canonicalTails_length _ _ _ htail]
  · intro x hx
    simp only [List.mem_cons] at hx
    rcases hx with rfl | hx
    · omega
    · exact canonicalTails_lt_three _ _ _ htail x hx

def graphAssignment (G : SimpleGraph (Fin vertexCount))
    [DecidableRel G.Adj] (v : Nat) : Bool :=
  decide (∃ i j : Fin vertexCount,
    i < j ∧ edgeVar i j = v ∧ G.Adj i j)

theorem edgeVar_injective :
    ∀ i j i' j' : Fin vertexCount,
      i < j → i' < j' → edgeVar i j = edgeVar i' j' → i = i' ∧ j = j' := by
  decide +kernel

theorem graphAssignment_edge_iff
    {G : SimpleGraph (Fin vertexCount)} [DecidableRel G.Adj]
    {i j : Fin vertexCount} (hij : i < j) :
    graphAssignment G (edgeVar i j) = true ↔ G.Adj i j := by
  simp only [graphAssignment, decide_eq_true_eq]
  constructor
  · rintro ⟨i', j', hi'j', hvar, hadj⟩
    obtain ⟨rfl, rfl⟩ := edgeVar_injective i' j' i j hi'j' hij hvar
    exact hadj
  · intro hadj
    exact ⟨i, j, hij, rfl, hadj⟩

theorem edgePairs_complete :
    ∀ i j : Fin vertexCount, i < j → (i.val, j.val) ∈ edgePairs := by
  decide +kernel

def colouringOfList (c : Colouring)
    (hlen : c.length = vertexCount) (hbound : ∀ x ∈ c, x < 3) :
    Fin vertexCount → Fin 3 := fun i =>
  ⟨getElem c i.val (by omega), hbound _ (List.getElem_mem (by omega))⟩

theorem colouringClause_eval_true
    {G : SimpleGraph (Fin vertexCount)} [DecidableRel G.Adj]
    (hnot3 : ¬ G.Colorable 3) {c : Colouring}
    (hc : c ∈ canonicalColourings) :
    CNF.Clause.eval (graphAssignment G) (colouringClause c) = true := by
  obtain ⟨hlen, hbound⟩ := canonicalColourings_spec hc
  let colour := colouringOfList c hlen hbound
  have himproper : ¬ ∀ {u v : Fin vertexCount}, G.Adj u v → colour u ≠ colour v := by
    intro hproper
    apply hnot3
    exact ⟨SimpleGraph.Coloring.mk colour hproper⟩
  push Not at himproper
  obtain ⟨u, v, huv, heq⟩ := himproper
  have huv_ne : u ≠ v := G.ne_of_adj huv
  have ordered :
      ∃ i j : Fin vertexCount, i < j ∧ G.Adj i j ∧ colour i = colour j := by
    rcases lt_or_gt_of_ne huv_ne with huvlt | hvult
    · exact ⟨u, v, huvlt, huv, heq⟩
    · exact ⟨v, u, hvult, huv.symm, heq.symm⟩
  obtain ⟨i, j, hij, hadj, hcolour⟩ := ordered
  have hi : i.val < c.length := by omega
  have hj : j.val < c.length := by omega
  have hvalues : getElem c i.val hi = getElem c j.val hj :=
    congrArg Fin.val hcolour
  have hoptions : getElem? c i.val = getElem? c j.val := by
    rw [List.getElem?_eq_getElem hi, List.getElem?_eq_getElem hj, hvalues]
  have hlit : (edgeVar i j, true) ∈ colouringClause c := by
    rw [colouringClause, List.mem_filterMap]
    refine ⟨(i.val, j.val), edgePairs_complete i j hij, ?_⟩
    simp [hoptions]
  rw [CNF.Clause.eval, List.any_eq_true]
  refine ⟨(edgeVar i j, true), hlit, ?_⟩
  simpa using (graphAssignment_edge_iff (G := G) hij).2 hadj

theorem graphAssignment_satisfies
    {G : SimpleGraph (Fin vertexCount)} [DecidableRel G.Adj]
    (htri : G.CliqueFree 3) (hnot3 : ¬ G.Colorable 3) :
    counterexampleCNF.eval (graphAssignment G) = true := by
  simp [counterexampleCNF, CNF.eval, triangleClauses, colourClauses]
  constructor
  · intro i hi dj hdj dk hdk
    let j := i + dj + 1
    let k := j + dk + 1
    have hi10 : i < vertexCount := hi
    have hj10 : j < vertexCount := by omega
    have hk10 : k < vertexCount := by omega
    let fi : Fin vertexCount := ⟨i, hi10⟩
    let fj : Fin vertexCount := ⟨j, hj10⟩
    let fk : Fin vertexCount := ⟨k, hk10⟩
    have hij : fi < fj := by simp [fi, fj, j]
    have hik : fi < fk := by simp [fi, fk]; omega
    have hjk : fj < fk := by simp [fj, fk]; omega
    by_contra h
    push Not at h
    have haij : graphAssignment G (edgeVar i j) = true :=
      Bool.eq_true_of_not_eq_false h.1
    have haik : graphAssignment G (edgeVar i k) = true :=
      Bool.eq_true_of_not_eq_false h.2.1
    have hajk : graphAssignment G (edgeVar j k) = true :=
      Bool.eq_true_of_not_eq_false h.2.2
    have hgij : G.Adj fi fj := by
      exact (graphAssignment_edge_iff (G := G) hij).1 (by simpa [fi, fj] using haij)
    have hgik : G.Adj fi fk := by
      exact (graphAssignment_edge_iff (G := G) hik).1 (by simpa [fi, fk] using haik)
    have hgjk : G.Adj fj fk := by
      exact (graphAssignment_edge_iff (G := G) hjk).1 (by simpa [fj, fk] using hajk)
    exact htri _ (SimpleGraph.is3Clique_triple_iff.mpr ⟨hgij, hgik, hgjk⟩)
  · intro c hc
    exact colouringClause_eval_true hnot3 hc

end R4SmallOrderCNF
end Erdos1011

end Flattened_Erdos1011_R4SmallOrderSemantics
