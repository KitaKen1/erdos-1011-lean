theorem mapSupportFamilyEmbedding_disjoint_iff {s t : ℕ} (f : Fin s ↪ Fin t)
    (I J : Finset (Fin s)) :
    Disjoint (I.map f) (J.map f) ↔ Disjoint I J := by
