    h01.ne h23.ne h02 h03 h12.ne h13
  let H₀ := H.comap e
  let 𝒜₀ := pullSupportFamilyEmbedding e.toEmbedding 𝒜
  let ℬ₀ := pullSupportFamilyEmbedding e.toEmbedding ℬ
  have h𝒜₀ := r4_pull_support_family_independent H e h𝒜
  have hℬ₀ := r4_pull_support_family_independent H e hℬ
  have hAmap : mapSupportFamilyEmbedding e.toEmbedding 𝒜₀ = 𝒜 := by
    simpa [𝒜₀] using map_pullSupportFamilyEmbedding_eq e.toEmbedding
