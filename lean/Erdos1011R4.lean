  r#"section Flattened_Erdos1011_R4

/-!
# The r = 4 base construction

This file starts the paper-formalization of the fixed four-colour part of
Erdos #1011.  It deliberately begins with an explicit 11-vertex Grötzsch
graph, rather than hiding the construction behind an opaque constant.
-/

namespace Erdos1011

open SimpleGraph

def c5Adj (i j : Nat) : Prop :=
  i < 5 ∧ j < 5 ∧ i ≠ j ∧ ((i + 1) % 5 = j ∨ (j + 1) % 5 = i)

def grotzschRel (x y : Fin 11) : Prop :=
  let a := x.1
  let b := y.1
  (c5Adj a b) ∨
  (a < 5 ∧ 5 ≤ b ∧ b < 10 ∧ c5Adj a (b - 5)) ∨
  (5 ≤ a ∧ a < 10 ∧ b < 5 ∧ c5Adj b (a - 5)) ∨
  (a = 10 ∧ 5 ≤ b ∧ b < 10) ∨
  (b = 10 ∧ 5 ≤ a ∧ a < 10)

def grotzsch : SimpleGraph (Fin 11) := SimpleGraph.fromRel grotzschRel

instance : DecidableRel grotzschRel := by
  intro x y
  dsimp [grotzschRel, c5Adj]
  infer_instance

abbrev BlowupVertex (a b : ℕ) := Fin 9 ⊕ (Fin a ⊕ Fin b)

def blowupBaseVertex {a b : ℕ} : BlowupVertex a b → Fin 11
  | Sum.inl i =>
      if h : i.1 < 5 then ⟨i.1, by omega⟩ else ⟨i.1 + 1, by omega⟩
  | Sum.inr (Sum.inl _) => ⟨10, by decide⟩
  | Sum.inr (Sum.inr _) => ⟨5, by decide⟩

def grotzschBlowupRel {a b : ℕ} (x y : BlowupVertex a b) : Prop :=
  grotzschRel (blowupBaseVertex x) (blowupBaseVertex y)

def grotzschBlowup (a b : ℕ) : SimpleGraph (BlowupVertex a b) :=
  SimpleGraph.fromRel (grotzschBlowupRel (a := a) (b := b))

def grotzschBlowupSection {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b)
  (v : Fin 11) : BlowupVertex a b :=
  if h5 : v.1 = 5 then
    Sum.inr (Sum.inr ⟨0, by omega⟩)
  else if h10 : v.1 = 10 then
    Sum.inr (Sum.inl ⟨0, by omega⟩)
  else
    if hv : v.1 < 5 then
      Sum.inl ⟨v.1, by omega⟩
    else
      Sum.inl ⟨v.1 - 1, by omega⟩

theorem blowupBaseVertex_section {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b)
    (v : Fin 11) :
    blowupBaseVertex (grotzschBlowupSection ha hb v) = v := by
  by_cases h5 : v.1 = 5
  · apply Fin.ext
    simp [grotzschBlowupSection, h5, blowupBaseVertex]
  by_cases h10 : v.1 = 10
  · apply Fin.ext
    simp [grotzschBlowupSection, h5, h10, blowupBaseVertex]
  by_cases hv : v.1 < 5
  · simp [grotzschBlowupSection, h5, h10, hv, blowupBaseVertex]
  · have hv1 : ¬ v.1 - 1 < 5 := by omega
    apply Fin.ext
    simp [grotzschBlowupSection, h5, h10, hv, hv1, blowupBaseVertex]
    omega

instance {a b : ℕ} : DecidableRel (grotzschBlowupRel (a := a) (b := b)) := by
  intro x y
  dsimp [grotzschBlowupRel, blowupBaseVertex]
  infer_instance

def grotzschBlowupSectionHom {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b) :
    grotzsch →g grotzschBlowup a b :=
  { toFun := grotzschBlowupSection ha hb
    map_rel' := by
      intro x y hxy
      have hxy' : x ≠ y ∧ (grotzschRel x y ∨ grotzschRel y x) := by
        simpa [grotzsch, SimpleGraph.fromRel_adj] using hxy
      refine (SimpleGraph.fromRel_adj _ _ _).2 ⟨?_, ?_⟩
      · intro heq
        apply hxy'.1
        have hbase := congrArg (blowupBaseVertex (a := a) (b := b)) heq
        simpa [blowupBaseVertex_section ha hb] using hbase
      · change grotzschRel (blowupBaseVertex (grotzschBlowupSection ha hb x))
          (blowupBaseVertex (grotzschBlowupSection ha hb y)) ∨
          grotzschRel (blowupBaseVertex (grotzschBlowupSection ha hb y))
            (blowupBaseVertex (grotzschBlowupSection ha hb x))
        simpa [blowupBaseVertex_section ha hb] using hxy'.2
  }

theorem grotzschBlowup_vertex_card (a b : ℕ) :
    Fintype.card (BlowupVertex a b) = 9 + a + b := by
  simp [BlowupVertex, Nat.add_assoc]

/- A computable directed incidence count for explicit finite graphs.  We use
this during construction verification; the generic identification with the
noncomputable `edgeCount` is a separate counting lemma. -/
def directedEdgeCount {n : ℕ} (G : SimpleGraph (Fin n)) [DecidableRel G.Adj] : ℕ :=
  (Finset.univ.filter (fun p : Fin n × Fin n => G.Adj p.1 p.2)).card

def directedEdgeCountAny {α : Type*} [Fintype α]
    (G : SimpleGraph α) [DecidableRel G.Adj] : ℕ :=
  (Finset.univ.filter (fun p : α × α => G.Adj p.1 p.2)).card

instance {a b : ℕ} : DecidableRel (grotzschBlowup a b).Adj := by
  intro x y
  change Decidable (x ≠ y ∧
    (grotzschBlowupRel (a := a) (b := b) x y ∨
      grotzschBlowupRel (a := a) (b := b) y x))
  infer_instance

theorem grotzschBlowup_directed_edge_count_base :
    directedEdgeCountAny (grotzschBlowup 1 1) = 40 := by
  decide +kernel

theorem grotzschBlowup_edgeFinset_card_base :
    (grotzschBlowup 1 1).edgeFinset.card = 20 := by
  have h := (grotzschBlowup 1 1).two_mul_card_edgeFinset
  change 2 * (grotzschBlowup 1 1).edgeFinset.card =
    directedEdgeCountAny (grotzschBlowup 1 1) at h
  rw [grotzschBlowup_directed_edge_count_base] at h
  omega

/- The extremal blow-up used by the fixed-4 formula replaces an adjacent
shadow/apex pair.  Their degrees in the 11-vertex graph are 3 and 5.  After
blowing them up to sizes `a` and `b`, the other 9 vertices stay singletons. -/
def grotzschBlowupEdges (a b : ℕ) : ℕ :=
  13 + a * b + 4 * a + 2 * b

lemma adj_a_singleton (a b : ℕ) (x : Fin a) (y : Fin 9) :
    (grotzschBlowup a b).Adj (Sum.inr (Sum.inl x)) (Sum.inl y) ↔ 5 ≤ y.1 := by
  by_cases h : y.1 < 5 <;>
    simp [grotzschBlowup, SimpleGraph.fromRel_adj, grotzschBlowupRel,
      blowupBaseVertex, grotzschRel, c5Adj, h] <;> omega

lemma adj_a_b (a b : ℕ) (x : Fin a) (y : Fin b) :
    (grotzschBlowup a b).Adj (Sum.inr (Sum.inl x)) (Sum.inr (Sum.inr y)) := by
  simp [grotzschBlowup, SimpleGraph.fromRel_adj, grotzschBlowupRel,
    blowupBaseVertex, grotzschRel, c5Adj]

lemma adj_b_singleton (a b : ℕ) (x : Fin b) (y : Fin 9) :
    (grotzschBlowup a b).Adj (Sum.inr (Sum.inr x)) (Sum.inl y) ↔
      (y.1 = 1 ∨ y.1 = 4) := by
  fin_cases y <;>
    simp [grotzschBlowup, SimpleGraph.fromRel_adj, grotzschBlowupRel,
      blowupBaseVertex, grotzschRel, c5Adj]

lemma not_adj_a_a (a b : ℕ) (x z : Fin a) :
    ¬ (grotzschBlowup a b).Adj (Sum.inr (Sum.inl x)) (Sum.inr (Sum.inl z)) := by
  simp [grotzschBlowup, SimpleGraph.fromRel_adj, grotzschBlowupRel,
    blowupBaseVertex, grotzschRel, c5Adj]

lemma adj_b_a (a b : ℕ) (x : Fin b) (y : Fin a) :
    (grotzschBlowup a b).Adj (Sum.inr (Sum.inr x)) (Sum.inr (Sum.inl y)) := by
  exact (adj_a_b a b y x).symm

lemma adj_singleton_a (a b : ℕ) (y : Fin 9) (x : Fin a) :
    (grotzschBlowup a b).Adj (Sum.inl y) (Sum.inr (Sum.inl x)) ↔
      5 ≤ y.1 := by
  simpa [SimpleGraph.adj_comm] using (adj_a_singleton a b x y)

lemma adj_singleton_b (a b : ℕ) (y : Fin 9) (x : Fin b) :
    (grotzschBlowup a b).Adj (Sum.inl y) (Sum.inr (Sum.inr x)) ↔
      (y.1 = 1 ∨ y.1 = 4) := by
  simpa [SimpleGraph.adj_comm] using (adj_b_singleton a b x y)

def singletonBaseVertex (y : Fin 9) : Fin 11 :=
  if h : y.1 < 5 then ⟨y.1, by omega⟩ else ⟨y.1 + 1, by omega⟩

lemma adj_singletons (a b : ℕ) (y z : Fin 9) :
    (grotzschBlowup a b).Adj (Sum.inl y) (Sum.inl z) ↔
      (y ≠ z ∧ (grotzschRel (singletonBaseVertex y) (singletonBaseVertex z) ∨
        grotzschRel (singletonBaseVertex z) (singletonBaseVertex y))) := by
  by_cases hy : y.1 < 5 <;> by_cases hz : z.1 < 5 <;>
    simp [grotzschBlowup, SimpleGraph.fromRel_adj, grotzschBlowupRel,
      blowupBaseVertex, singletonBaseVertex, grotzschRel, c5Adj, hy, hz]

lemma not_adj_b_b (a b : ℕ) (x z : Fin b) :
