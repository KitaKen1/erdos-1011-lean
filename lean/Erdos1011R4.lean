namespace Erdos1011

open scoped BigOperators

/- Reindexing a support family along an equivalence preserves all numerical
   quantities used in the capacity argument.  These lemmas isolate the
   bookkeeping needed to transport the finite `Fin 6` tables to an arbitrary
   six-vertex residual graph. -/

noncomputable def mapSupportFamily {s t : ℕ} (e : Fin s ≃ Fin t)
    (𝒜 : Finset (Finset (Fin s))) : Finset (Finset (Fin t)) := by
  classical
  exact 𝒜.image (fun I => I.map e.toEmbedding)

theorem mapSupportFamily_map_injective {s t : ℕ} (e : Fin s ≃ Fin t) :
    Function.Injective (fun I : Finset (Fin s) => I.map e.toEmbedding) := by
  exact Finset.map_injective e.toEmbedding

theorem mapSupportFamily_map_injOn {s t : ℕ} (e : Fin s ≃ Fin t)
    (𝒜 : Finset (Finset (Fin s))) :
    Set.InjOn (fun I : Finset (Fin s) => I.map e.toEmbedding) (𝒜 : Set _) := by
  intro I hI J hJ hIJ
  exact mapSupportFamily_map_injective e hIJ

@[simp] theorem mapSupportFamily_mem_iff {s t : ℕ} (e : Fin s ≃ Fin t)
    {𝒜 : Finset (Finset (Fin s))} {I : Finset (Fin t)} :
    I ∈ mapSupportFamily e 𝒜 ↔
      ∃ J ∈ 𝒜, J.map e.toEmbedding = I := by
  classical
  simp [mapSupportFamily]

theorem mapSupportFamily_card {s t : ℕ} (e : Fin s ≃ Fin t)
    (𝒜 : Finset (Finset (Fin s))) :
    (mapSupportFamily e 𝒜).card = 𝒜.card := by
  classical
  unfold mapSupportFamily
  exact Finset.card_image_of_injective _ (mapSupportFamily_map_injective e)

theorem supportWeight_mapSupportFamily {s t : ℕ} (e : Fin s ≃ Fin t)
    (𝒜 : Finset (Finset (Fin s))) :
    supportWeight (mapSupportFamily e 𝒜) = supportWeight 𝒜 := by
  classical
  unfold supportWeight mapSupportFamily
  rw [Finset.sum_image (mapSupportFamily_map_injOn e 𝒜)]
  simp [Finset.card_map]

theorem mapSupportFamily_disjoint_iff {s t : ℕ} (e : Fin s ≃ Fin t)
    (I J : Finset (Fin s)) :
    Disjoint (I.map e.toEmbedding) (J.map e.toEmbedding) ↔
      Disjoint I J := by
  exact Finset.disjoint_map e.toEmbedding

theorem supportHits_mapSupportFamily {s t : ℕ} (e : Fin s ≃ Fin t)
    (𝒜 : Finset (Finset (Fin s))) (I : Finset (Fin s)) :
