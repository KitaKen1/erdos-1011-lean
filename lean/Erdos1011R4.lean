  r#"section Flattened_Erdos1011_R4UnifiedMaxDegreeData

/-!
# One certificate for all normalized maximum-degree cases

The edge variables incident with vertex zero are required to form a prefix.
If that prefix has length `d`, guarded clauses enforce maximum degree at most
`d`.  Hence one CNF replaces the ten almost-identical case CNFs.
-/

namespace Erdos1011.R4UnifiedMaxDegreeCNF

open Std Sat
open R4SmallOrderCNF R4MaxDegreeCNF

/-- Clauses `0--(w+1) → 0--w`, so the neighbors of zero form a prefix. -/
def normalizedPrefixClauses : List (CNF.Clause Nat) :=
  (List.range (vertexCount - 2)).map fun k =>
    let w := k + 1
    [(edgeVar 0 (w + 1), false), (edgeVar 0 w, true)]

/-- The disjunction which is false exactly when the prefix has length `d`. -/
def degreeGuard (d : Nat) : CNF.Clause Nat :=
  if d = 0 then
    [(edgeVar 0 1, true)]
  else if d = vertexCount - 1 then
    [(edgeVar 0 (vertexCount - 1), false)]
  else
    [(edgeVar 0 d, false), (edgeVar 0 (d + 1), true)]

def guardedMaximumDegreeClauses (d : Nat) : List (CNF.Clause Nat) :=
  (maximumDegreeClauses d).map fun clause => degreeGuard d ++ clause

def unifiedExtraClauses : List (CNF.Clause Nat) :=
  normalizedPrefixClauses ++
    (List.range vertexCount).flatMap guardedMaximumDegreeClauses

def unifiedExtraCNF : CNF Nat :=
  { clauses := unifiedExtraClauses.toArray }

def unifiedCNF : CNF Nat :=
  { clauses := R4SmallOrderCNF.counterexampleCNF.clauses ++
      unifiedExtraClauses.toArray }

def unifiedExtraFormula : Sat.Fmla := satFmlaOfStdCNF unifiedExtraCNF

def unifiedFormula : Sat.Fmla :=
  Sat.Fmla.and R4SmallOrderCNF.satFormula unifiedExtraFormula

lrat_fmla_context_range unifiedExtraContext 9962 15080
  erdos1011R4UnifiedCNFText

noncomputable def unifiedCheckedContext : Sat.Fmla :=
  Sat.Fmla.and R4SmallOrderCNF.satContext unifiedExtraContext

end Erdos1011.R4UnifiedMaxDegreeCNF

