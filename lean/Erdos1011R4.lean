/- The finite mask certificate now applies to arbitrary families over the
labelled `K₂ ⊔ 2K₁` residual, provided their members are among the eleven
nonempty independent support types. -/
theorem r4_support_surplus_le_ten
    {𝒜 ℬ : Finset (Finset V4)}
    (h𝒜 : ∀ I ∈ 𝒜, I ∈ r4Types)
    (hℬ : ∀ J ∈ ℬ, J ∈ r4Types)
    (hcompat : DegreeCompatible 𝒜 ℬ) :
    supportSurplus 𝒜 ℬ ≤ 10 := by
  obtain ⟨a, ha⟩ := r4_exists_mask 𝒜 h𝒜
  obtain ⟨b, hb⟩ := r4_exists_mask ℬ hℬ
  have hmask : r4Compatible a.val b.val = true := by
    apply (r4Compatible_iff _ _).mpr
    constructor
    · intro i hi
      have hiA : r4TypeFinset i ∈ 𝒜 := by
        rw [← ha]
        apply Finset.mem_image.mpr
        exact ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩, rfl⟩
      have hc := hcompat.1 _ hiA
      rw [← hb] at hc
      rw [r4_mask_hits b i] at hc
      simpa [r4TypeWeight_eq_card i] using hc
    · intro i hi
      have hiB : r4TypeFinset i ∈ ℬ := by
        rw [← hb]
        apply Finset.mem_image.mpr
        exact ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩, rfl⟩
      have hc := hcompat.2 _ hiB
      rw [← ha] at hc
      rw [r4_mask_hits a i] at hc
      simpa [r4TypeWeight_eq_card i] using hc
  have hbound := r4_no_bad_pair_dual a.isLt b.isLt hmask
  have hs : supportSurplus (r4FamilyOfMask a.val)
      (r4FamilyOfMask b.val) ≤ 10 := by
    rw [r4_mask_surplus]
    exact hbound
  simpa [ha, hb] using hs

