      have hTc' : ((fun z : residualSet G u v => (z : Fin n)) '' T).ncard = T.ncard :=
        Set.ncard_image_of_injective T Subtype.val_injective
      rw [himage] at hTc'
      rw [← hTc']
      exact hType y hy
