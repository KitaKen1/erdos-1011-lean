  r#"namespace Erdos1011

/-! The expensive P₃ finite capacity computation is isolated in this module.
Downstream proof edits can then reuse its `.olean` without re-running all 512
kernel-checked rows. -/

def r4P3Type : Fin 9 → Finset V4
  | 0 => {0} | 1 => {1} | 2 => {2} | 3 => {0, 2} | 4 => {3}
  | 5 => {0, 3} | 6 => {1, 3} | 7 => {2, 3} | 8 => {0, 2, 3}

def r4P3Types : Finset (Finset V4) := Finset.univ.image r4P3Type

def r4P3Family (a : ℕ) : Finset (Finset V4) :=
  (Finset.univ.filter (fun i : Fin 9 => Nat.testBit a i.1)).image r4P3Type

def r4P3Weight (a : ℕ) : ℕ :=
  ∑ i : Fin 9, if Nat.testBit a i.1 then (r4P3Type i).card else 0

def r4P3Hits (a : ℕ) (J : Finset V4) : ℕ :=
  ∑ i : Fin 9, if Nat.testBit a i.1 && ¬ Disjoint (r4P3Type i) J then 1 else 0

def r4P3Cross (a b : ℕ) : ℕ :=
  ∑ i : Fin 9, if Nat.testBit b i.1 then r4P3Hits a (r4P3Type i) else 0

def r4P3Surplus (a b : ℕ) : ℕ := r4P3Weight a + r4P3Weight b - r4P3Cross a b

def r4P3Compatible (a b : ℕ) : Bool :=
  decide (∀ i : Fin 9, Nat.testBit a i.1 = true →
    (r4P3Type i).card ≤ r4P3Hits b (r4P3Type i)) &&
  decide (∀ i : Fin 9, Nat.testBit b i.1 = true →
    (r4P3Type i).card ≤ r4P3Hits a (r4P3Type i))

def r4P3BadPair (a b : ℕ) : Bool :=
  r4P3Compatible a b && decide (r4P3Surplus a b > 8)

def r4P3CapacityRow (a : ℕ) : Bool :=
  if r4P3Weight a ≤ 8 then true else
    (List.range 512).all (fun b => !r4P3BadPair a b)

def r4P3CapacityCertificate : Bool :=
  (List.range 512).all r4P3CapacityRow

/- Checking all 512 rows in one reduction is memory-hungry, while a single
`fin_cases` proof creates a very deep frontend snapshot tree.  Sixteen-row
blocks keep both the kernel computation and Lean4Web's editor tree shallow. -/
def r4P3CapacityChunk (start len : ℕ) : Bool :=
  (List.range' start len).all r4P3CapacityRow

end Erdos1011
