/- The four-point finite dispatcher now transports the labelled capacity
   tables to an arbitrary residual four-set and returns the combined
   `e(H)+F ≤ 11` certificate. -/
theorem verified_r4_residual_four_dispatch
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (hG : HighChromaticTriangleFree 4 n G) {u v : Fin n} (huv : G.Adj u v)
    (hS : (residualSet G u v).ncard = 4)
    (hcompat : DegreeCompatible (supportFamilyA G u v)
      (supportFamilyB G u v)) :
    ∃ e q : ℕ,
      (G.induce (residualFinset G u v : Set (Fin n))).edgeFinset.card ≤ e ∧
      supportSurplus (supportFamilyA G u v) (supportFamilyB G u v) ≤ q ∧
      e + q ≤ 11 :=
  residual_four_capacity_dispatch hG huv hS hcompat

/- The finite four-point dispatcher now plugs directly into the extremal
   graph decomposition.  This is deliberately a bridge theorem: it closes
   the s = 4 branch once the degree-sum-maximal edge and the small residual
   cardinality have been supplied, but it does not assert the missing global
   extremal-edge selection or the s ≤ 3 exclusion. -/
theorem verified_r4_upper_from_residual_s4_dispatch
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (hG : HighExtremal 4 n G) {u v : Fin n} (huv : G.Adj u v)
    (hD : ∀ H a b, HighExtremalEdgePairs 4 n (H, (a, b)) →
      degreeSumPair (H, (a, b)) ≤ degreeSumPair (G, (u, v)))
    (hnoA : ∀ x x', x ∈ edgeSideASet G u v →
      x' ∈ edgeSideASet G u v → x ≠ x' →
      (residualType G u v x).Nonempty →
      residualType G u v x ≠ residualType G u v x')
    (hnoB : ∀ y y', y ∈ edgeSideBSet G u v →
      y' ∈ edgeSideBSet G u v → y ≠ y' →
      (residualType G u v y).Nonempty →
      residualType G u v y ≠ residualType G u v y')
    (hn : 16 ≤ n)
    (hS : (residualSet G u v).ncard = 4) :
    edgeCount G ≤ fourMCandidate n := by
  have hmax : IsEdgeMaximalTriangleFree G :=
    edge_maximal_of_edgeCount_max hG.1 hG.2
  have hcompat : DegreeCompatible (supportFamilyA G u v)
      (supportFamilyB G u v) :=
    degreeCompatible_of_degree_sum_max hG huv hD hnoA hnoB
  obtain ⟨e, q, he, hq, hEq⟩ :=
    verified_r4_residual_four_dispatch hG.1 huv hS hcompat
  exact verified_r4_upper_from_residual_s4_total_certificate hmax huv
    hnoA hnoB he hq hn ⟨hS, hEq⟩

/- A residual of at most two vertices cannot occur at chromatic number four.
   The residual edge forced by `residual_has_edge_of_high_four` makes every
   independent residual type a singleton (or empty).  Hence any 2-colouring
   of the residual is automatically monochromatic on every B-type, and the
   sharpened three-colour reduction gives a contradiction. -/
theorem verified_r4_residual_ncard_le_two_impossible
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (hG : HighChromaticTriangleFree 4 n G)
    {u v : Fin n} (huv : G.Adj u v)
    (hS : (residualSet G u v).ncard ≤ 2) : False := by
  have hresEdge : ∃ x y : Fin n,
      x ∈ residualSet G u v ∧ y ∈ residualSet G u v ∧ G.Adj x y :=
    residual_has_edge_of_high_four hG huv
  have hScard : (residualSet G u v).ncard = 2 := by
    apply le_antisymm hS
    rcases hresEdge with ⟨x, y, hx, hy, hxy⟩
    have hxyne : x ≠ y := G.ne_of_adj hxy
    have hpair : ({x, y} : Set (Fin n)) ⊆ residualSet G u v := by
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl
      · exact hx
      · exact hy
    have hpaircard : ({x, y} : Set (Fin n)).ncard = 2 :=
      Set.ncard_pair hxyne
    have hle := Set.ncard_le_ncard hpair
    simpa [hpaircard] using hle
  obtain ⟨C⟩ :=
    induced_triangle_free_colorable_two_of_ncard_le_four
      (S := residualSet G u v) hG.1 (by omega)
  have htype_le_one : ∀ y, y ∈ edgeSideBSet G u v →
      (residualType G u v y).ncard ≤ 1 := by
    intro y hy
    apply (Set.ncard_le_one).2
    intro a ha b hb
    by_contra hab
    have hpairsub : ({a, b} : Set (Fin n)) ⊆ residualSet G u v := by
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl
      · exact ha.2
      · exact hb.2
    have hpairEq : ({a, b} : Set (Fin n)) = residualSet G u v := by
      apply Set.eq_of_subset_of_ncard_le hpairsub
      rw [hScard, Set.ncard_pair hab]
    rcases hresEdge with ⟨x, y', hx, hy', hxy'⟩
    have hxa : x = a ∨ x = b := by
      have hxpair : x ∈ ({a, b} : Set (Fin n)) := by
        rw [hpairEq]
        exact hx
      simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hxpair
    have hya : y' = a ∨ y' = b := by
      have hypair : y' ∈ ({a, b} : Set (Fin n)) := by
        rw [hpairEq]
        exact hy'
      simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hypair
    have habadj : G.Adj a b := by
      rcases hxa with rfl | rfl <;> rcases hya with rfl | rfl
      · exact False.elim (G.loopless.irrefl _ hxy')
      · exact hxy'
      · exact hxy'.symm
      · exact False.elim (G.loopless.irrefl _ hxy')
    exact (residualType_independent hG.1 u v y ha hb hab) habadj
  have hmono : ∀ y, y ∈ edgeSideBSet G u v →
      ∃ d : Fin 2, ∀ z : residualSet G u v,
        (z : Fin n) ∈ residualType G u v y → C z = d := by
    intro y hy
    have hle := htype_le_one y hy
    rcases Set.eq_empty_or_nonempty (residualType G u v y) with hempty | hnonempty
    · refine ⟨0, ?_⟩
      intro z hz
      rw [hempty] at hz
      exact hz.elim
    · rcases hnonempty with ⟨z₀, hz₀⟩
      refine ⟨C ⟨z₀, hz₀.2⟩, ?_⟩
      intro z hz
      have hsame : (z : Fin n) = z₀ :=
        (Set.ncard_le_one (s := residualType G u v y)).mp hle
          (z : Fin n) hz z₀ hz₀
      have hzEq : z = (⟨z₀, hz₀.2⟩ : residualSet G u v) :=
        Subtype.ext hsame
      rw [hzEq]
  have h3 : G.Colorable 3 :=
    colorable_three_of_residual_colorable_two_and_B_type_mono hG.1 huv
      ⟨C, hmono⟩
  have hle : G.chromaticNumber ≤ 3 := h3.chromaticNumber_le
  have hbad : (4 : ℕ∞) ≤ 3 := hG.2.trans hle
  norm_num at hbad

/- The three-point residual capacity bridge.  For r=4 an edge in the
   residual graph is forced by non-3-colourability, so the finite `Fin 3`
   certificate applies without an additional graph-shape hypothesis. -/
theorem verified_r4_residual_three_capacity
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (hG : HighChromaticTriangleFree 4 n G) {u v : Fin n} (huv : G.Adj u v)
    {T : Finset (Fin n)} (hTcard : T.card = 3)
    (hTsub : ∀ z, z ∈ residualSet G u v → z ∈ T)
    (hcompat : DegreeCompatible (supportFamilyA G u v)
      (supportFamilyB G u v)) :
    supportSurplus (supportFamilyA G u v) (supportFamilyB G u v) ≤ 4 := by
  apply residual_three_capacity_of_labelled_certificate hG.1 huv hTcard hTsub hcompat
  have hresEdge : ∃ x y : Fin n,
      x ∈ residualSet G u v ∧ y ∈ residualSet G u v ∧ G.Adj x y :=
    residual_has_edge_of_high_four hG huv
  have hEdge : ∃ i j : V3,
      (G.comap (residualThreeEmbedding T hTcard)).Adj i j := by
    rcases hresEdge with ⟨x, y, hx, hy, hxy⟩
    have hxT : x ∈ T := hTsub x hx
    have hyT : y ∈ T := hTsub y hy
    have hrange : Set.range (residualThreeEmbedding T hTcard) =
        (T : Set (Fin n)) := residualThreeEmbedding_range T hTcard
    have hxrange : x ∈ Set.range (residualThreeEmbedding T hTcard) := by
      rw [hrange]
      exact hxT
    have hyrange : y ∈ Set.range (residualThreeEmbedding T hTcard) := by
      rw [hrange]
      exact hyT
    rcases Set.mem_range.mp hxrange with ⟨i, hi⟩
    rcases Set.mem_range.mp hyrange with ⟨j, hj⟩
    refine ⟨i, j, ?_⟩
    change G.Adj (residualThreeEmbedding T hTcard i)
      (residualThreeEmbedding T hTcard j)
    simpa [hi, hj] using hxy
  exact hEdge

/- If the labelled three-point residual has exactly one edge, the preceding
   `F ≤ 4` estimate combines with the exact residual edge count to give the
   sharp `e + F ≤ 5` certificate required by the arithmetic endgame. -/
theorem verified_r4_residual_three_one_edge_certificate
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (hG : HighChromaticTriangleFree 4 n G) {u v : Fin n} (huv : G.Adj u v)
    {T : Finset (Fin n)} (hTcard : T.card = 3)
    (hTsub : ∀ z, z ∈ residualSet G u v → z ∈ T)
    (hTeq : (T : Set (Fin n)) = residualSet G u v)
    (hcompat : DegreeCompatible (supportFamilyA G u v)
      (supportFamilyB G u v))
    (hHcard : (G.comap (residualThreeEmbedding T hTcard)).edgeFinset.card = 1) :
    ∃ e q : ℕ,
      (G.induce (residualFinset G u v : Set (Fin n))).edgeFinset.card ≤ e ∧
      supportSurplus (supportFamilyA G u v) (supportFamilyB G u v) ≤ q ∧
      e + q ≤ 5 := by
  have hq : supportSurplus (supportFamilyA G u v)
      (supportFamilyB G u v) ≤ 4 :=
    verified_r4_residual_three_capacity hG huv hTcard hTsub hcompat
  have hcardIso :
      (G.comap (residualThreeEmbedding T hTcard)).edgeFinset.card =
        (G.induce (residualFinset G u v : Set (Fin n))).edgeFinset.card := by
    let f := residualThreeEmbedding T hTcard
    let g : V3 → (residualFinset G u v : Set (Fin n)) := fun i =>
      ⟨f i, by
        have hi : f i ∈ (T : Set (Fin n)) := by
          rw [← residualThreeEmbedding_range T hTcard]
          exact ⟨i, rfl⟩
        rw [hTeq] at hi
        exact mem_residualFinset_iff.mpr hi⟩
    have hginj : Function.Injective g := by
      intro i j hij
      apply f.injective
      simpa [g] using congrArg Subtype.val hij
    have hgsurj : Function.Surjective g := by
      intro y
      have hyres : y.1 ∈ residualSet G u v :=
        mem_residualFinset_iff.mp y.2
      have hyT : y.1 ∈ (T : Set (Fin n)) := by
        rw [hTeq]
        exact hyres
      have hyrange : y.1 ∈ Set.range f := by
        rw [residualThreeEmbedding_range T hTcard]
        exact hyT
      rcases Set.mem_range.mp hyrange with ⟨i, hi⟩
      refine ⟨i, Subtype.ext ?_⟩
      exact hi
    let eS : V3 ≃ (residualFinset G u v : Set (Fin n)) :=
      Equiv.ofBijective g ⟨hginj, hgsurj⟩
    let iso : G.comap f ≃g
        G.induce (residualFinset G u v : Set (Fin n)) :=
      { toEquiv := eS
        map_rel_iff' := by
          intro i j
          change (G.comap f).Adj i j ↔
            (G.induce (residualFinset G u v : Set (Fin n))).Adj (eS i) (eS j)
          change G.Adj (f i) (f j) ↔ G.Adj (eS i).1 (eS j).1
          have hi : (eS i).1 = f i := by rfl
          have hj : (eS j).1 = f j := by rfl
          rw [hi, hj] }
    exact iso.card_edgeFinset_eq
  refine ⟨1, 4, ?_, hq, by norm_num⟩
  rw [← hcardIso]
  exact hHcard.le

/- The P₃ residual branch supplies the monochromatic-type hypothesis needed by
   the sharpened three-colour reduction.  The finite certificate is transported
   through the labelled residual embedding and its graph isomorphism. -/
theorem verified_r4_residual_three_two_edge_mono_coloring
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (htri : G.CliqueFree 3) {u v : Fin n} (huv : G.Adj u v)
    {T : Finset (Fin n)} (hTcard : T.card = 3)
    (hTsub : ∀ z, z ∈ residualSet G u v → z ∈ T)
    (hTeq : (T : Set (Fin n)) = residualSet G u v)
    (hHcard :
      (G.comap (residualThreeEmbedding T hTcard)).edgeFinset.card = 2) :
    ∃ C : Coloring (G.induce (residualSet G u v)) (Fin 2),
      ∀ y, y ∈ edgeSideBSet G u v →
        ∃ d : Fin 2, ∀ z : residualSet G u v,
          (z : Fin n) ∈ residualType G u v y → C z = d := by
  let f := residualThreeEmbedding T hTcard
  let H := G.comap f
  have hHtri : H.CliqueFree 3 := by
    intro s hs
    rcases SimpleGraph.is3Clique_iff.mp hs with ⟨a, b, c, hab, hac, hbc, _⟩
    apply htri
    exact SimpleGraph.is3Clique_triple_iff.mpr
      ⟨hab, hac, hbc⟩
  obtain ⟨CH, hCHmono⟩ :=
    s3_graph_two_edge_mono_coloring H hHtri (by simpa [H, f] using hHcard)
  let g : V3 → (residualSet G u v) := fun i =>
    ⟨f i, by
      have hi : f i ∈ (T : Set (Fin n)) := by
        exact residualThreeEmbedding_mem T hTcard i
      rw [hTeq] at hi
      exact hi⟩
  have hginj : Function.Injective g := by
    intro i j hij
    apply f.injective
    simpa [g] using congrArg Subtype.val hij
  have hgsurj : Function.Surjective g := by
    intro z
    have hzT : z.1 ∈ (T : Set (Fin n)) := by
      rw [hTeq]
      exact z.2
    have hzrange : z.1 ∈ Set.range f := by
      rw [residualThreeEmbedding_range T hTcard]
      exact hzT
    rcases Set.mem_range.mp hzrange with ⟨i, hi⟩
    refine ⟨i, Subtype.ext ?_⟩
    exact hi
  let eS : V3 ≃ (residualSet G u v) :=
    Equiv.ofBijective g ⟨hginj, hgsurj⟩
  let K := G.induce (residualSet G u v)
  let iso : H ≃g K :=
    { toEquiv := eS
      map_rel_iff' := by
        intro i j
        change G.Adj (f i) (f j) ↔ G.Adj (eS i).1 (eS j).1
        have hi : (eS i).1 = f i := by rfl
        have hj : (eS j).1 = f j := by rfl
        rw [hi, hj] }
  let CK : Coloring K (Fin 2) :=
    Coloring.mk (fun z => CH (eS.symm z)) (by
      intro x y hxy
      apply CH.valid
      exact (iso.symm.map_rel_iff).mpr hxy)
  refine ⟨CK, ?_⟩
  intro y hy
  let I : Finset V3 :=
    (Set.toFinite {i : V3 | f i ∈ residualType G u v y}).toFinset
  have hIind : H.IsIndepSet (I : Set V3) := by
    intro i hi j hj hij hAdj
    have hi' : f i ∈ residualType G u v y := by
      exact Set.toFinite {i : V3 | f i ∈ residualType G u v y} |>.mem_toFinset.mp hi
    have hj' : f j ∈ residualType G u v y := by
      exact Set.toFinite {i : V3 | f i ∈ residualType G u v y} |>.mem_toFinset.mp hj
    have hGAdj : G.Adj (f i) (f j) := by
      simpa [H] using hAdj
    exact (residualType_independent htri u v y) hi' hj'
      (fun h => hij (f.injective h)) hGAdj
  obtain ⟨d, hd⟩ := hCHmono I hIind
  refine ⟨d, ?_⟩
  intro z hz
  have hiz : eS.symm z ∈ I := by
    apply Set.toFinite {i : V3 | f i ∈ residualType G u v y} |>.mem_toFinset.mpr
    change f (eS.symm z) ∈ residualType G u v y
    have heq : f (eS.symm z) = z.1 := by
      have hz' := congrArg Subtype.val (eS.apply_symm_apply z)
      change f (eS.symm z) = z.1 at hz'
      exact hz'
    simpa [heq] using hz
  have hdz := hd (eS.symm z) hiz
  change CH (eS.symm z) = d
  exact hdz

theorem verified_r4_residual_three_two_edge_impossible
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (hG : HighChromaticTriangleFree 4 n G) {u v : Fin n} (huv : G.Adj u v)
    {T : Finset (Fin n)} (hTcard : T.card = 3)
    (hTsub : ∀ z, z ∈ residualSet G u v → z ∈ T)
    (hTeq : (T : Set (Fin n)) = residualSet G u v)
    (hHcard :
      (G.comap (residualThreeEmbedding T hTcard)).edgeFinset.card = 2) :
    False := by
  obtain ⟨C, hMono⟩ := verified_r4_residual_three_two_edge_mono_coloring
    hG.1 huv hTcard hTsub hTeq hHcard
  have h3 : G.Colorable 3 :=
    colorable_three_of_residual_colorable_two_and_B_type_mono hG.1 huv
      ⟨C, hMono⟩
  have hle : G.chromaticNumber ≤ 3 := h3.chromaticNumber_le
  have hbad : (4 : ℕ∞) ≤ 3 := hG.2.trans hle
  norm_num at hbad

/- Arithmetic bridge for the complete three-point residual branch.  After the
   P₃ case is excluded, the surviving one-edge case has the sharp `e+F ≤ 5`
   constant used by the four-colour candidate. -/
theorem verified_r4_upper_from_residual_s3_certificate
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    {u v : Fin n}
    (hmax : IsEdgeMaximalTriangleFree G)
    (huv : G.Adj u v)
    (hnoA : ∀ x x', x ∈ edgeSideASet G u v →
      x' ∈ edgeSideASet G u v → x ≠ x' →
      (residualType G u v x).Nonempty →
      residualType G u v x ≠ residualType G u v x')
    (hnoB : ∀ x x', x ∈ edgeSideBSet G u v →
      x' ∈ edgeSideBSet G u v → x ≠ x' →
      (residualType G u v x).Nonempty →
      residualType G u v x ≠ residualType G u v x')
    {e q : ℕ}
    (he : (G.induce (residualFinset G u v : Set (Fin n))).edgeFinset.card ≤ e)
    (hq : supportSurplus (supportFamilyA G u v)
        (supportFamilyB G u v) ≤ q)
    (hcase : (residualSet G u v).ncard = 3 ∧ e + q ≤ 5) :
    edgeCount G ≤ fourMCandidate n := by
  have hsum := full_side_degree_residual_card_sum hmax.1 huv
  rw [hcase.1] at hsum
  have hdecomp := edgeCount_le_full_product_plus_residual_bound_of_additive
    (G := G) hmax huv hnoA hnoB he hq
  exact r4_residual_decomposition_bound_s3_total hsum hcase.2
    hdecomp

/- Fully instantiate the previous bridge from an extremal edge choice.  This
   closes the entire `s = 3` branch once the degree-sum maximal edge and its
   no-repeated-type hypotheses are available. -/
theorem verified_r4_upper_from_residual_s3_dispatch
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (hG : HighExtremal 4 n G) {u v : Fin n} (huv : G.Adj u v)
    (hD : ∀ H a b, HighExtremalEdgePairs 4 n (H, (a, b)) →
      degreeSumPair (H, (a, b)) ≤ degreeSumPair (G, (u, v)))
    (hnoA : ∀ x x', x ∈ edgeSideASet G u v →
      x' ∈ edgeSideASet G u v → x ≠ x' →
      (residualType G u v x).Nonempty →
      residualType G u v x ≠ residualType G u v x')
    (hnoB : ∀ y y', y ∈ edgeSideBSet G u v →
      y' ∈ edgeSideBSet G u v → y ≠ y' →
      (residualType G u v y).Nonempty →
      residualType G u v y ≠ residualType G u v y')
    (hS : (residualSet G u v).ncard = 3)
    (hcert : ∃ e q : ℕ,
      (G.induce (residualFinset G u v : Set (Fin n))).edgeFinset.card ≤ e ∧
      supportSurplus (supportFamilyA G u v) (supportFamilyB G u v) ≤ q ∧
      e + q ≤ 5) :
    edgeCount G ≤ fourMCandidate n := by
  have hmax : IsEdgeMaximalTriangleFree G :=
    edge_maximal_of_edgeCount_max hG.1 hG.2
  have hcompat : DegreeCompatible (supportFamilyA G u v)
      (supportFamilyB G u v) :=
    degreeCompatible_of_degree_sum_max hG huv hD hnoA hnoB
  obtain ⟨e, q, he, hq, hEq⟩ := hcert
  exact verified_r4_upper_from_residual_s3_certificate hmax huv hnoA hnoB
    he hq ⟨hS, hEq⟩

/- Instantiate the sharp three-point certificate when the residual graph has
   one edge.  The remaining two-edge `P₃` shape is intentionally not folded
   into this theorem: it must first be excluded by a separate 3-colouring
   argument, as in the paper proof. -/
theorem verified_r4_upper_from_residual_s3_one_edge_dispatch
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (hG : HighExtremal 4 n G) {u v : Fin n} (huv : G.Adj u v)
    (hD : ∀ H a b, HighExtremalEdgePairs 4 n (H, (a, b)) →
      degreeSumPair (H, (a, b)) ≤ degreeSumPair (G, (u, v)))
    (hnoA : ∀ x x', x ∈ edgeSideASet G u v →
      x' ∈ edgeSideASet G u v → x ≠ x' →
      (residualType G u v x).Nonempty →
      residualType G u v x ≠ residualType G u v x')
    (hnoB : ∀ y y', y ∈ edgeSideBSet G u v →
      y' ∈ edgeSideBSet G u v → y ≠ y' →
      (residualType G u v y).Nonempty →
      residualType G u v y ≠ residualType G u v y')
    (hS : (residualSet G u v).ncard = 3)
    (hHcard :
      (G.comap (residualThreeEmbedding (residualFinset G u v)
        (by rw [residualFinset_card_eq_ncard]; exact hS))).edgeFinset.card = 1) :
    edgeCount G ≤ fourMCandidate n := by
  have hmax : IsEdgeMaximalTriangleFree G :=
    edge_maximal_of_edgeCount_max hG.1 hG.2
  have hcompat : DegreeCompatible (supportFamilyA G u v)
      (supportFamilyB G u v) :=
    degreeCompatible_of_degree_sum_max hG huv hD hnoA hnoB
  let T := residualFinset G u v
  have hTcard : T.card = 3 := by
    dsimp [T]
    rw [residualFinset_card_eq_ncard]
    exact hS
  have hTsub : ∀ z, z ∈ residualSet G u v → z ∈ T := by
    intro z hz
    exact mem_residualFinset_iff.mpr hz
  have hTeq : (T : Set (Fin n)) = residualSet G u v := by
    ext z
    exact mem_residualFinset_iff
  obtain ⟨e, q, he, hq, hEq⟩ :=
    verified_r4_residual_three_one_edge_certificate hG.1 huv hTcard
      hTsub hTeq hcompat (by simpa [T] using hHcard)
  exact verified_r4_upper_from_residual_s3_certificate hmax huv hnoA hnoB
    he hq ⟨hS, hEq⟩

/- Fully automatic three-point dispatch.  The residual has an edge, Turán's
   bound gives at most two edges, and the preceding P₃ contradiction forces
   the one-edge certificate. -/
theorem verified_r4_upper_from_residual_s3_auto_dispatch
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (hG : HighExtremal 4 n G) {u v : Fin n} (huv : G.Adj u v)
    (hD : ∀ H a b, HighExtremalEdgePairs 4 n (H, (a, b)) →
      degreeSumPair (H, (a, b)) ≤ degreeSumPair (G, (u, v)))
    (hnoA : ∀ x x', x ∈ edgeSideASet G u v →
      x' ∈ edgeSideASet G u v → x ≠ x' →
      (residualType G u v x).Nonempty →
      residualType G u v x ≠ residualType G u v x')
    (hnoB : ∀ y y', y ∈ edgeSideBSet G u v →
      y' ∈ edgeSideBSet G u v → y ≠ y' →
      (residualType G u v y).Nonempty →
      residualType G u v y ≠ residualType G u v y')
    (hS : (residualSet G u v).ncard = 3) :
    edgeCount G ≤ fourMCandidate n := by
  have hmax : IsEdgeMaximalTriangleFree G :=
    edge_maximal_of_edgeCount_max hG.1 hG.2
  have hcompat : DegreeCompatible (supportFamilyA G u v)
      (supportFamilyB G u v) :=
    degreeCompatible_of_degree_sum_max hG huv hD hnoA hnoB
  let T := residualFinset G u v
  have hTcard : T.card = 3 := by
    dsimp [T]
    rw [residualFinset_card_eq_ncard]
    exact hS
  have hTsub : ∀ z, z ∈ residualSet G u v → z ∈ T := by
    intro z hz
    exact mem_residualFinset_iff.mpr hz
  have hTeq : (T : Set (Fin n)) = residualSet G u v := by
    ext z
    exact mem_residualFinset_iff
  let f := residualThreeEmbedding T hTcard
  let H := G.comap f
  have hHtri : H.CliqueFree 3 := by
    intro s hs
    rcases SimpleGraph.is3Clique_iff.mp hs with ⟨a, b, c, hab, hac, hbc, _⟩
    apply hG.1.1
    exact SimpleGraph.is3Clique_triple_iff.mpr ⟨hab, hac, hbc⟩
  have hHedge : ∃ i j : V3, H.Adj i j := by
    rcases residual_has_edge_of_high_four hG.1 huv with
      ⟨x, y, hx, hy, hxy⟩
    have hxT : x ∈ T := hTsub x hx
    have hyT : y ∈ T := hTsub y hy
    have hrange : Set.range f = (T : Set (Fin n)) :=
      residualThreeEmbedding_range T hTcard
    have hxrange : x ∈ Set.range f := by rw [hrange]; exact hxT
    have hyrange : y ∈ Set.range f := by rw [hrange]; exact hyT
    rcases Set.mem_range.mp hxrange with ⟨i, hi⟩
    rcases Set.mem_range.mp hyrange with ⟨j, hj⟩
    refine ⟨i, j, ?_⟩
    change G.Adj (f i) (f j)
    simpa [hi, hj] using hxy
  have hHpos : 0 < H.edgeFinset.card := by
    rcases hHedge with ⟨i, j, hij⟩
    exact Finset.card_pos.mpr ⟨s(i, j), SimpleGraph.mem_edgeFinset.mpr hij⟩
  have hHle : H.edgeFinset.card ≤ 2 := by
    have hmantel := edgeCount_le_turan_triangle_free hHtri
    rw [edgeCount_eq_edgeFinset_card_r4] at hmantel
    norm_num at hmantel
    exact hmantel
  have hHne2 : H.edgeFinset.card ≠ 2 := by
    intro h2
    exact verified_r4_residual_three_two_edge_impossible hG.1 huv
      hTcard hTsub hTeq (by simpa [H, f] using h2)
  have hHone : H.edgeFinset.card = 1 := by omega
  obtain ⟨e, q, he, hq, hEq⟩ :=
    verified_r4_residual_three_one_edge_certificate hG.1 huv hTcard
      hTsub hTeq hcompat (by simpa [H, f] using hHone)
  exact verified_r4_upper_from_residual_s3_certificate hmax huv hnoA hnoB
    he hq ⟨hS, hEq⟩

theorem verified_r4_residual_five_capacity
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (hG : HighChromaticTriangleFree 4 n G) {u v : Fin n} (huv : G.Adj u v)
    {T : Finset (Fin n)} (hTcard : T.card = 5)
    (hTsub : ∀ z, z ∈ residualSet G u v → z ∈ T)
    (hcompat : DegreeCompatible (supportFamilyA G u v)
      (supportFamilyB G u v)) :
    supportSurplus (supportFamilyA G u v) (supportFamilyB G u v) ≤ 24 := by
  apply r4_residual_five_capacity_of_local hG.1 huv hTcard hTsub hcompat
  intro 𝒜 ℬ h𝒜 hℬ hcomp
  have hresEdge : ∃ x y : Fin n,
      x ∈ residualSet G u v ∧ y ∈ residualSet G u v ∧ G.Adj x y :=
    residual_has_edge_of_high_four hG huv
  let f := residualFiveEmbedding T hTcard
  have hrange : Set.range f = (T : Set (Fin n)) :=
    residualFiveEmbedding_range T hTcard
  have hHEdge : ∃ x y : V5,
      (G.comap f).Adj x y := by
    rcases hresEdge with ⟨x, y, hx, hy, hxy⟩
    have hxT : x ∈ T := hTsub x hx
    have hyT : y ∈ T := hTsub y hy
    have hxrange : x ∈ Set.range f := by rw [hrange]; exact hxT
    have hyrange : y ∈ Set.range f := by rw [hrange]; exact hyT
    rcases Set.mem_range.mp hxrange with ⟨i, hi⟩
    rcases Set.mem_range.mp hyrange with ⟨j, hj⟩
    refine ⟨i, j, ?_⟩
    change G.Adj (f i) (f j)
    simpa [hi, hj] using hxy
  exact r4S5_graph_support_surplus_le_24 (G.comap f) hHEdge h𝒜 hℬ hcomp

/- The five-point residual branch now has a complete local dispatcher: Turán
   gives the six-edge residual bound, while the finite `K₂ ⊔ 3K₁` capacity table
   gives the support-surplus bound. -/
theorem verified_r4_upper_from_residual_s5_dispatch
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (hG : HighExtremal 4 n G) {u v : Fin n} (huv : G.Adj u v)
    (hD : ∀ H a b, HighExtremalEdgePairs 4 n (H, (a, b)) →
      degreeSumPair (H, (a, b)) ≤ degreeSumPair (G, (u, v)))
    (hnoA : ∀ x x', x ∈ edgeSideASet G u v →
      x' ∈ edgeSideASet G u v → x ≠ x' →
      (residualType G u v x).Nonempty →
      residualType G u v x ≠ residualType G u v x')
    (hnoB : ∀ y y', y ∈ edgeSideBSet G u v →
      y' ∈ edgeSideBSet G u v → y ≠ y' →
      (residualType G u v y).Nonempty →
      residualType G u v y ≠ residualType G u v y')
    (hn : 32 ≤ n)
    (hS : (residualSet G u v).ncard = 5) :
    edgeCount G ≤ fourMCandidate n := by
  have hmax : IsEdgeMaximalTriangleFree G :=
    edge_maximal_of_edgeCount_max hG.1 hG.2
  have hcompat : DegreeCompatible (supportFamilyA G u v)
      (supportFamilyB G u v) :=
    degreeCompatible_of_degree_sum_max hG huv hD hnoA hnoB
  let T := residualFinset G u v
  have hTcard : T.card = 5 := by
    dsimp [T]
    rw [residualFinset_card_eq_ncard]
    exact hS
  have hTsub : ∀ z, z ∈ residualSet G u v → z ∈ T := by
    intro z hz
    exact mem_residualFinset_iff.mpr hz
  have hq : supportSurplus (supportFamilyA G u v)
      (supportFamilyB G u v) ≤ 24 := by
    exact verified_r4_residual_five_capacity hG.1 huv hTcard hTsub hcompat
  have he : (G.induce (residualFinset G u v : Set (Fin n))).edgeFinset.card ≤ 6 := by
    exact verified_r4_residual_edge_bound_s5 hG.1.1 T hTcard
  exact verified_r4_upper_from_residual_s5_certificate hmax huv hnoA hnoB
    he hq hn ⟨hS, by omega, by omega⟩

/- Once the extremal edge has been twinized, the degree-average estimate leaves
   only residual sizes 2 through 5.  The size-two case is impossible, and the
   preceding three-, four-, and five-point dispatchers close the remaining
   cases. -/
theorem verified_r4_twinized_upper_n_ge_32
    {n : ℕ} (hn : 32 ≤ n) {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (hG : HighExtremal 4 n G) {u v : Fin n} (huv : G.Adj u v)
    (hD : ∀ H a b, HighExtremalEdgePairs 4 n (H, (a, b)) →
      degreeSumPair (H, (a, b)) ≤ degreeSumPair (G, (u, v)))
    (hnoA : ∀ x x', x ∈ edgeSideASet G u v →
      x' ∈ edgeSideASet G u v → x ≠ x' →
      (residualType G u v x).Nonempty →
      residualType G u v x ≠ residualType G u v x')
    (hnoB : ∀ y y', y ∈ edgeSideBSet G u v →
      y' ∈ edgeSideBSet G u v → y ≠ y' →
      (residualType G u v y).Nonempty →
      residualType G u v y ≠ residualType G u v y') :
    edgeCount G ≤ fourMCandidate n := by
  have hSle : (residualSet G u v).ncard ≤ 5 :=
    verified_r4_residual_ncard_le_five_of_degree_sum_max hn hG huv hD
  have hS2 : ¬ (residualSet G u v).ncard ≤ 2 := by
    intro hsmall
    exact verified_r4_residual_ncard_le_two_impossible hG.1 huv hsmall
  by_cases hS3 : (residualSet G u v).ncard = 3
  · exact verified_r4_upper_from_residual_s3_auto_dispatch hG huv hD
      hnoA hnoB hS3
  by_cases hS4 : (residualSet G u v).ncard = 4
  · exact verified_r4_upper_from_residual_s4_dispatch hG huv hD
      hnoA hnoB (by omega) hS4
  have hS5 : (residualSet G u v).ncard = 5 := by omega
  exact verified_r4_upper_from_residual_s5_dispatch hG huv hD hnoA hnoB hn hS5

/- The twinization choice is only needed for the extremal graph.  This theorem
   compares that graph with an arbitrary high four-chromatic triangle-free
   graph, yielding the full r=4 upper bound for n ≥ 32. -/
theorem verified_r4_upper_n_ge_32
    {n : ℕ} (hn : 32 ≤ n) {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (hG : HighChromaticTriangleFree 4 n G) :
    edgeCount G ≤ fourMCandidate n := by
  classical
  have hedge : ∀ H : SimpleGraph (Fin n), HighExtremal 4 n H →
      ∃ u v : Fin n, H.Adj u v := by
    intro H hH
    have hnebot : H ≠ (⊥ : SimpleGraph (Fin n)) := by
      intro hbot
      have hcol : H.Colorable 1 := by
        rw [hbot]
        simp
      have hbad : (4 : ℕ∞) ≤ 1 := hH.1.2.trans hcol.chromaticNumber_le
      norm_num at hbad
    exact SimpleGraph.ne_bot_iff_exists_adj.mp hnebot
  obtain ⟨G₀, u, v, hG₀, huv, hD, _hmin, hnoA, hnoB⟩ :=
    exists_twinized_extremal_edge (r := 4) (n := n) ⟨G, hG⟩ hedge
  letI : DecidableRel G₀.Adj := Classical.decRel _
  have hupper : edgeCount G₀ ≤ fourMCandidate n :=
    verified_r4_twinized_upper_n_ge_32 hn hG₀ huv hD hnoA hnoB
  exact (hG₀.2 G hG).trans hupper

/- Small finite arithmetic gaps used to extend the structural argument below
   n=32.  They are deliberately proved by `interval_cases`, not assumed from
   the computer enumeration. -/
theorem verified_r4_small_n_s4_gap
    {n : ℕ} (hn : 12 ≤ n) (hlt : n < 16) :
    n * (n - 4) < 4 * (fourMCandidate n + 1) := by
  interval_cases n <;> norm_num [fourMCandidate] at *

theorem verified_r4_small_n_s5_gap
    {n : ℕ} (hn : 12 ≤ n) (hlt : n < 32) :
    n * (n - 5) < 4 * (fourMCandidate n + 1) := by
  interval_cases n <;> norm_num [fourMCandidate] at *

/- If an extremal graph beats the candidate, the degree-average inequality
   rules out residual size at least five below n=32. -/
theorem verified_r4_residual_ncard_le_four_of_above_candidate
    {n : ℕ} (hn : 12 ≤ n) (hlt : n < 32)
    {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (hG : HighExtremal 4 n G) {u v : Fin n} (huv : G.Adj u v)
    (hD : ∀ H a b, HighExtremalEdgePairs 4 n (H, (a, b)) →
      degreeSumPair (H, (a, b)) ≤ degreeSumPair (G, (u, v)))
    (habove : fourMCandidate n < edgeCount G) :
    (residualSet G u v).ncard ≤ 4 := by
  have havg : 4 * edgeCount G ≤ n * degreeSumPair (G, (u, v)) :=
    four_mul_edgeCount_le_of_high_extremal_edge hG hD
  have hsum := degreeSumPair_add_residual_ncard_eq_n hG.1.1 huv
  by_contra hnot
  have hs5 : 5 ≤ (residualSet G u v).ncard := by omega
  have hDle : degreeSumPair (G, (u, v)) ≤ n - 5 := by omega
  have hprod : n * degreeSumPair (G, (u, v)) ≤ n * (n - 5) :=
    Nat.mul_le_mul_left n hDle
  have hstrict : fourMCandidate n + 1 ≤ edgeCount G :=
    Nat.succ_le_of_lt habove
  have hlow : 4 * (fourMCandidate n + 1) ≤ 4 * edgeCount G :=
    Nat.mul_le_mul_left 4 hstrict
  have hchain : 4 * (fourMCandidate n + 1) ≤ n * (n - 5) :=
    hlow.trans (havg.trans hprod)
  exact (Nat.not_lt_of_ge hchain)
    (verified_r4_small_n_s5_gap hn hlt)

/- The same argument rules out residual size at least four for 12≤n<16,
   which is the only extra small range needed by the four-point dispatcher. -/
theorem verified_r4_residual_ncard_le_three_of_above_candidate
    {n : ℕ} (hn : 12 ≤ n) (hlt : n < 16)
    {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (hG : HighExtremal 4 n G) {u v : Fin n} (huv : G.Adj u v)
    (hD : ∀ H a b, HighExtremalEdgePairs 4 n (H, (a, b)) →
      degreeSumPair (H, (a, b)) ≤ degreeSumPair (G, (u, v)))
    (habove : fourMCandidate n < edgeCount G) :
    (residualSet G u v).ncard ≤ 3 := by
  have havg : 4 * edgeCount G ≤ n * degreeSumPair (G, (u, v)) :=
    four_mul_edgeCount_le_of_high_extremal_edge hG hD
  have hsum := degreeSumPair_add_residual_ncard_eq_n hG.1.1 huv
  by_contra hnot
  have hs4 : 4 ≤ (residualSet G u v).ncard := by omega
  have hDle : degreeSumPair (G, (u, v)) ≤ n - 4 := by omega
  have hprod : n * degreeSumPair (G, (u, v)) ≤ n * (n - 4) :=
    Nat.mul_le_mul_left n hDle
  have hstrict : fourMCandidate n + 1 ≤ edgeCount G :=
    Nat.succ_le_of_lt habove
  have hlow : 4 * (fourMCandidate n + 1) ≤ 4 * edgeCount G :=
    Nat.mul_le_mul_left 4 hstrict
  have hchain : 4 * (fourMCandidate n + 1) ≤ n * (n - 4) :=
    hlow.trans (havg.trans hprod)
  exact (Nat.not_lt_of_ge hchain)
    (verified_r4_small_n_s4_gap hn hlt)

/- Full r=4 upper bound for an already twinized extremal edge at every n≥12.
   The only finite arithmetic input below 32 is the preceding two gap lemmas. -/
theorem verified_r4_twinized_upper_n_ge_12
    {n : ℕ} (hn : 12 ≤ n) {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (hG : HighExtremal 4 n G) {u v : Fin n} (huv : G.Adj u v)
    (hD : ∀ H a b, HighExtremalEdgePairs 4 n (H, (a, b)) →
      degreeSumPair (H, (a, b)) ≤ degreeSumPair (G, (u, v)))
