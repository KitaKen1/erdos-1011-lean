    (hcard : (r4S5Type i).card ≤ 3) :
    r4S5DisjointWeightBound i +
      4 * (2 * (r4S5Type i).card - 1) ≤ 24 := by
  decide +kernel +revert

theorem r4S5_bound_card_four {i : Fin 23}
    (hcard : (r4S5Type i).card = 4) :
    r4S5DisjointWeightBound i +
      3 * (2 * (r4S5Type i).card - 1) + 2 ≤ 24 := by
  decide +kernel +revert

theorem r4S5_disjoint_part_le
    {𝒜 : Finset (Finset V5)}
    (h𝒜 : ∀ I ∈ 𝒜, I ∈ r4S5Types) (i : Fin 23) :
    (∑ I ∈ 𝒜,
      if Disjoint I (r4S5Type i) then I.card else 0) ≤
      r4S5DisjointWeightBound i := by
  have hsub : 𝒜 ⊆ r4S5Types := by
    intro I hI
    exact h𝒜 I hI
  have hsum :
      (∑ I ∈ 𝒜, if Disjoint I (r4S5Type i) then I.card else 0) ≤
        (∑ I ∈ r4S5Types,
          if Disjoint I (r4S5Type i) then I.card else 0) := by
    exact Finset.sum_le_sum_of_subset_of_nonneg hsub
      (fun I hI hnot => by positivity)
  exact hsum.trans (r4S5_disjoint_weight_bound i)

theorem r4S5_hit_part_le_four
    {𝒜 : Finset (Finset V5)} (h𝒜 : ∀ I ∈ 𝒜, I ∈ r4S5Types)
    (J : Finset V5) :
    (∑ I ∈ 𝒜, if Disjoint I J then 0 else I.card) ≤
      4 * supportHits 𝒜 J := by
  have hterm : ∀ I ∈ 𝒜,
      (if Disjoint I J then 0 else I.card) ≤
        4 * (if Disjoint I J then 0 else 1) := by
    intro I hI
    by_cases h : Disjoint I J <;> simp [h]
    exact r4S5_card_le_four I (h𝒜 I hI)
  unfold supportHits
  calc
    (∑ I ∈ 𝒜, if Disjoint I J then 0 else I.card) ≤
        ∑ I ∈ 𝒜, 4 * (if Disjoint I J then 0 else 1) :=
      Finset.sum_le_sum (fun I hI => hterm I hI)
    _ = 4 * ∑ I ∈ 𝒜, (if Disjoint I J then 0 else 1) := by
      rw [Finset.mul_sum]

theorem r4S5_hit_part_le_three_plus_cardfour
    {𝒜 : Finset (Finset V5)} (h𝒜 : ∀ I ∈ 𝒜, I ∈ r4S5Types)
    (J : Finset V5) :
    (∑ I ∈ 𝒜, if Disjoint I J then 0 else I.card) ≤
      3 * supportHits 𝒜 J +
        (𝒜.filter (fun I => I.card = 4)).card := by
  have hterm : ∀ I ∈ 𝒜,
      (if Disjoint I J then 0 else I.card) ≤
        3 * (if Disjoint I J then 0 else 1) +
          (if Disjoint I J then 0 else if I.card = 4 then 1 else 0) := by
    intro I hI
    have hcard := r4S5_card_le_four I (h𝒜 I hI)
    by_cases hdis : Disjoint I J
    · simp [hdis]
    · by_cases hfour : I.card = 4
      · simp [hdis, hfour]
      · have hle : I.card ≤ 3 := by omega
        simp [hdis, hfour]
        omega
  unfold supportHits
  have hsum := Finset.sum_le_sum (s := 𝒜) (fun I hI => hterm I hI)
  have hextra :
      (∑ I ∈ 𝒜,
        (if Disjoint I J then 0 else if I.card = 4 then 1 else 0)) ≤
        (𝒜.filter (fun I => I.card = 4)).card := by
    calc
      (∑ I ∈ 𝒜,
        (if Disjoint I J then 0 else if I.card = 4 then 1 else 0)) ≤
          ∑ I ∈ 𝒜, (if I.card = 4 then 1 else 0) := by
        apply Finset.sum_le_sum
        intro I hI
        by_cases hdis : Disjoint I J <;> by_cases hfour : I.card = 4 <;>
          simp [hdis, hfour]
      _ = (𝒜.filter (fun I => I.card = 4)).card := by
        exact Finset.sum_boole (R := ℕ) (fun I : Finset V5 => I.card = 4) 𝒜
  calc
    (∑ I ∈ 𝒜, if Disjoint I J then 0 else I.card) ≤
        ∑ I ∈ 𝒜, ((3 * (if Disjoint I J then 0 else 1)) +
          (if Disjoint I J then 0 else if I.card = 4 then 1 else 0)) := hsum
    _ = 3 * (∑ I ∈ 𝒜, if Disjoint I J then 0 else 1) +
        (∑ I ∈ 𝒜,
          if Disjoint I J then 0 else if I.card = 4 then 1 else 0) := by
      simp_rw [Finset.sum_add_distrib, ← Finset.mul_sum]
    _ ≤ 3 * (∑ I ∈ 𝒜, if Disjoint I J then 0 else 1) +
        (𝒜.filter (fun I => I.card = 4)).card := by omega

/- The finite weighted argument.  In the heavy case, every support except the
   two singleton endpoints contributes at least twice its weight to the cross
   count; the two exceptional supports contribute at most one unit each. -/
theorem r4S5_support_surplus_le_24_of_oriented
    {𝒜 ℬ : Finset (Finset V5)}
    (h𝒜 : ∀ I ∈ 𝒜, I ∈ r4S5Types)
    (hℬ : ∀ J ∈ ℬ, J ∈ r4S5Types)
    (hcompat : DegreeCompatible 𝒜 ℬ)
    (hweight : supportWeight 𝒜 ≤ supportWeight ℬ) :
    supportSurplus 𝒜 ℬ ≤ 24 := by
  by_cases hsmall : supportWeight 𝒜 ≤ 24
  · have hs := supportSurplus_le_leftWeight hcompat.2
    exact hs.trans (by omega)
  have hheavy : 24 < supportWeight 𝒜 := by omega
  have hper : ∀ J ∈ ℬ,
      2 * J.card ≤ supportHits 𝒜 J +
        (if J = ({0} : Finset V5) ∨ J = ({1} : Finset V5) then 1 else 0) := by
    intro J hJ
    have hJtype := hℬ J hJ
    rcases Finset.mem_image.mp hJtype with ⟨i, hi, hEq⟩
    have hhit : J.card ≤ supportHits 𝒜 J := hcompat.2 J hJ
    have hspecial : r4S5Type i = ({0} : Finset V5) ∨
        r4S5Type i = ({1} : Finset V5) ∨
        (i ≠ 0 ∧ i ≠ 1) := by
      by_cases hi0 : i = 0
      · left; subst i; decide +kernel
      by_cases hi1 : i = 1
      · right; left; subst i; decide +kernel
      · right; right; exact ⟨hi0, hi1⟩
    rcases hspecial with h0 | h1 | hother
    · subst J
      have hhit' : 1 ≤ supportHits 𝒜 ({0} : Finset V5) := by
        simpa [h0, Finset.card_singleton] using hhit
      have hgoal : 2 * 1 ≤ supportHits 𝒜 ({0} : Finset V5) + 1 := by omega
      simpa [h0, Finset.card_singleton] using hgoal
    · subst J
      have hhit' : 1 ≤ supportHits 𝒜 ({1} : Finset V5) := by
        simpa [h1, Finset.card_singleton] using hhit
      have hgoal : 2 * 1 ≤ supportHits 𝒜 ({1} : Finset V5) + 1 := by omega
      simpa [h1, Finset.card_singleton] using hgoal
    · subst J
      have hIcardle : (r4S5Type i).card ≤ 4 :=
        r4S5_card_le_four _ (r4S5Type_mem_types i)
      have hAheavy : 24 < supportWeight 𝒜 := hheavy
      have hsplit : supportWeight 𝒜 =
          (∑ I ∈ 𝒜,
            if Disjoint I (r4S5Type i) then I.card else 0) +
          (∑ I ∈ 𝒜,
            if Disjoint I (r4S5Type i) then 0 else I.card) := by
        unfold supportWeight
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro I hI'
        by_cases hdis : Disjoint I (r4S5Type i) <;> simp [hdis]
      have hD := r4S5_disjoint_part_le h𝒜 i
      have hhit2 : 2 * (r4S5Type i).card ≤
          supportHits 𝒜 (r4S5Type i) := by
        by_contra hbad
        have hhit_le :
            (∑ I ∈ 𝒜, if Disjoint I (r4S5Type i) then 0 else 1) ≤
              2 * (r4S5Type i).card - 1 := by
          have hraw : supportHits 𝒜 (r4S5Type i) ≤
              2 * (r4S5Type i).card - 1 := by omega
          simpa [supportHits] using hraw
        have hAupper : supportWeight 𝒜 ≤ 24 := by
          rw [hsplit]
          by_cases hcard4 : (r4S5Type i).card = 4
          · have hH := r4S5_hit_part_le_three_plus_cardfour h𝒜 (r4S5Type i)
            unfold supportHits at hH
            have h4 := r4S5_card_four_subset_count h𝒜
            have hnum := r4S5_bound_card_four hcard4
            have hH' :
                (∑ I ∈ 𝒜, if Disjoint I (r4S5Type i) then 0 else I.card) ≤
                  3 * (2 * (r4S5Type i).card - 1) +
                    (𝒜.filter (fun I => I.card = 4)).card := by
              calc
                _ ≤ 3 * (∑ I ∈ 𝒜,
                    if Disjoint I (r4S5Type i) then 0 else 1) +
                    (𝒜.filter (fun I => I.card = 4)).card := hH
                _ ≤ _ := by omega
            omega
          · have hcard3 : (r4S5Type i).card ≤ 3 := by omega
            have hH := r4S5_hit_part_le_four h𝒜 (r4S5Type i)
            unfold supportHits at hH
            have hnum := r4S5_bound_card_le_three hother.1 hother.2 hcard3
            have hH' :
                (∑ I ∈ 𝒜, if Disjoint I (r4S5Type i) then 0 else I.card) ≤
                  4 * (2 * (r4S5Type i).card - 1) := by
              calc
                _ ≤ 4 * (∑ I ∈ 𝒜,
                    if Disjoint I (r4S5Type i) then 0 else 1) := hH
                _ ≤ _ := by omega
            omega
        omega
      have hneq0 : r4S5Type i ≠ ({0} : Finset V5) := by
        intro h
        apply hother.1
        apply r4S5Type_injective
        have ht0 : r4S5Type (0 : Fin 23) = ({0} : Finset V5) := by decide +kernel
        exact h.trans ht0.symm
      have hneq1 : r4S5Type i ≠ ({1} : Finset V5) := by
        intro h
        apply hother.2
        apply r4S5Type_injective
        have ht1 : r4S5Type (1 : Fin 23) = ({1} : Finset V5) := by decide +kernel
        exact h.trans ht1.symm
      simpa [hneq0, hneq1] using hhit2
  have hsum := Finset.sum_le_sum (s := ℬ) (fun J hJ => hper J hJ)
  have hspecial :
      (∑ J ∈ ℬ, (if J = ({0} : Finset V5) ∨ J = ({1} : Finset V5)
        then 1 else 0)) ≤ 2 := by
    have hsub : (ℬ.filter (fun J : Finset V5 =>
        J = ({0} : Finset V5) ∨ J = ({1} : Finset V5))) ⊆
        ({({0} : Finset V5), ({1} : Finset V5)} : Finset (Finset V5)) := by
      intro J hJ
      simpa using (Finset.mem_filter.mp hJ).2
    have hc := Finset.card_le_card hsub
    have hsumcard :
        (∑ J ∈ ℬ, (if J = ({0} : Finset V5) ∨ J = ({1} : Finset V5)
          then 1 else 0)) =
          (ℬ.filter (fun J : Finset V5 =>
            J = ({0} : Finset V5) ∨ J = ({1} : Finset V5))).card := by
      exact Finset.sum_boole
        (fun J : Finset V5 => J = ({0} : Finset V5) ∨ J = ({1} : Finset V5)) ℬ
    rw [hsumcard]
    simpa using hc
  have hleft :
      (∑ J ∈ ℬ, 2 * J.card) = 2 * supportWeight ℬ := by
    unfold supportWeight
    simp_rw [Finset.mul_sum]
  have hright : (∑ J ∈ ℬ, supportHits 𝒜 J) = supportCross 𝒜 ℬ := rfl
  have hsum' : 2 * supportWeight ℬ ≤ supportCross 𝒜 ℬ +
      (∑ J ∈ ℬ, (if J = ({0} : Finset V5) ∨ J = ({1} : Finset V5)
        then 1 else 0)) := by
    calc
      2 * supportWeight ℬ =
          ∑ J ∈ ℬ, 2 * J.card := hleft.symm
      _ ≤
          ∑ J ∈ ℬ, (supportHits 𝒜 J +
            (if J = ({0} : Finset V5) ∨ J = ({1} : Finset V5)
              then 1 else 0)) := hsum
      _ = supportCross 𝒜 ℬ +
          (∑ J ∈ ℬ, (if J = ({0} : Finset V5) ∨ J = ({1} : Finset V5)
            then 1 else 0)) := by
        rw [Finset.sum_add_distrib, hright]
  have hsum'' : 2 * supportWeight ℬ ≤ supportCross 𝒜 ℬ + 2 := by
    exact hsum'.trans (Nat.add_le_add_left hspecial _)
  unfold supportSurplus
  omega

theorem r4S5_support_surplus_le_24
    {𝒜 ℬ : Finset (Finset V5)}
    (h𝒜 : ∀ I ∈ 𝒜, I ∈ r4S5Types)
    (hℬ : ∀ J ∈ ℬ, J ∈ r4S5Types)
    (hcompat : DegreeCompatible 𝒜 ℬ) :
    supportSurplus 𝒜 ℬ ≤ 24 := by
  by_cases hweight : supportWeight 𝒜 ≤ supportWeight ℬ
  · exact r4S5_support_surplus_le_24_of_oriented h𝒜 hℬ hcompat hweight
  · have hweight' : supportWeight ℬ ≤ supportWeight 𝒜 := by omega
    have hs := r4S5_support_surplus_le_24_of_oriented hℬ h𝒜
      ⟨hcompat.2, hcompat.1⟩ hweight'
    unfold supportSurplus at hs ⊢
    rw [supportCross_symm] at hs
    simpa [Nat.add_comm] using hs

/- A finite relabelling lemma for the graph-level bridge. -/
theorem r4S5_exists_pair_equiv (x y : V5) (hxy : x ≠ y) :
    ∃ e : V5 ≃ V5, e 0 = x ∧ e 1 = y := by
  let e₁ : V5 ≃ V5 := Equiv.swap 0 x
  let z : V5 := e₁ 1
  let e₂ : V5 ≃ V5 := Equiv.swap z y
  have hz0 : z ≠ e₁ 0 := by
    exact e₁.injective.ne (by decide)
  have hzx : z ≠ x := by simpa [e₁] using hz0
  have hyx : y ≠ x := hxy.symm
  have hzx' : x ≠ z := hzx.symm
  have hyx' : x ≠ y := hyx.symm
  refine ⟨e₁.trans e₂, ?_, ?_⟩
  · dsimp [Equiv.trans_apply, e₁, e₂, z]
    exact Equiv.swap_apply_of_ne_of_ne hzx' hyx'
  · simp [Equiv.trans_apply, e₁, e₂, z]

theorem r4S5_graph_support_surplus_le_24
    (H : SimpleGraph V5) [DecidableRel H.Adj]
    (hedge : ∃ x y : V5, H.Adj x y)
    {𝒜 ℬ : Finset (Finset V5)}
    (h𝒜 : ∀ I ∈ 𝒜, I.Nonempty ∧ H.IsIndepSet (I : Set V5))
    (hℬ : ∀ J ∈ ℬ, J.Nonempty ∧ H.IsIndepSet (J : Set V5))
    (hcompat : DegreeCompatible 𝒜 ℬ) :
    supportSurplus 𝒜 ℬ ≤ 24 := by
  rcases hedge with ⟨x, y, hxy⟩
  obtain ⟨e, he0, he1⟩ := r4S5_exists_pair_equiv x y hxy.ne
  let H₀ := H.comap e
  let 𝒜₀ := pullSupportFamilyEmbedding e.toEmbedding 𝒜
  let ℬ₀ := pullSupportFamilyEmbedding e.toEmbedding ℬ
  have hAmap : mapSupportFamilyEmbedding e.toEmbedding 𝒜₀ = 𝒜 := by
    simpa [𝒜₀] using map_pullSupportFamilyEmbedding_eq e.toEmbedding
      (show familyMapsToEmbedding e.toEmbedding 𝒜 by
        intro I hI z hz; exact ⟨e.symm z, by simp⟩)
  have hBmap : mapSupportFamilyEmbedding e.toEmbedding ℬ₀ = ℬ := by
    simpa [ℬ₀] using map_pullSupportFamilyEmbedding_eq e.toEmbedding
      (show familyMapsToEmbedding e.toEmbedding ℬ by
        intro I hI z hz; exact ⟨e.symm z, by simp⟩)
  have hcomp₀ : DegreeCompatible 𝒜₀ ℬ₀ := by
    apply degreeCompatible_of_mapped_certificate e.toEmbedding
      (𝒜' := 𝒜) (ℬ' := ℬ)
    · exact hAmap.symm
    · exact hBmap.symm
    · exact hcompat
  have h𝒜₀ : ∀ I ∈ 𝒜₀, I ∈ r4S5Types := by
    intro I hI
    rcases Finset.mem_image.mp hI with ⟨J, hJ, rfl⟩
    apply r4S5_nonempty_base_independent
    · rcases h𝒜 J hJ with ⟨hn, _⟩
      rcases hn with ⟨z, hz⟩
      obtain ⟨i, hi⟩ := e.surjective z
      exact ⟨i, Finset.mem_preimage.mpr (by simpa [hi] using hz)⟩
    · intro a ha b hb hab hpair
      rcases hpair with hpair | hpair
      · rcases hpair with ⟨rfl, rfl⟩
        exact (h𝒜 J hJ).2 (Finset.mem_preimage.1 ha)
          (Finset.mem_preimage.1 hb) (e.injective.ne (by decide))
            (by simpa [H₀, he0, he1] using hxy)
      · rcases hpair with ⟨rfl, rfl⟩
        exact (h𝒜 J hJ).2 (Finset.mem_preimage.1 ha)
          (Finset.mem_preimage.1 hb) (e.injective.ne (by decide))
            (by simpa [H₀, he0, he1] using hxy.symm)
  have hℬ₀ : ∀ I ∈ ℬ₀, I ∈ r4S5Types := by
    intro I hI
    rcases Finset.mem_image.mp hI with ⟨J, hJ, rfl⟩
    apply r4S5_nonempty_base_independent
    · rcases hℬ J hJ with ⟨hn, _⟩
      rcases hn with ⟨z, hz⟩
      obtain ⟨i, hi⟩ := e.surjective z
      exact ⟨i, Finset.mem_preimage.mpr (by simpa [hi] using hz)⟩
    · intro a ha b hb hab hpair
      rcases hpair with hpair | hpair
      · rcases hpair with ⟨rfl, rfl⟩
        exact (hℬ J hJ).2 (Finset.mem_preimage.1 ha)
          (Finset.mem_preimage.1 hb) (e.injective.ne (by decide))
            (by simpa [H₀, he0, he1] using hxy)
      · rcases hpair with ⟨rfl, rfl⟩
        exact (hℬ J hJ).2 (Finset.mem_preimage.1 ha)
          (Finset.mem_preimage.1 hb) (e.injective.ne (by decide))
            (by simpa [H₀, he0, he1] using hxy.symm)
  calc
    supportSurplus 𝒜 ℬ =
        supportSurplus (mapSupportFamilyEmbedding e.toEmbedding 𝒜₀)
          (mapSupportFamilyEmbedding e.toEmbedding ℬ₀) := by rw [hAmap, hBmap]
    _ = supportSurplus 𝒜₀ ℬ₀ :=
      supportSurplus_mapSupportFamilyEmbedding e.toEmbedding 𝒜₀ ℬ₀
    _ ≤ 24 := r4S5_support_surplus_le_24 h𝒜₀ hℬ₀ hcomp₀

/- The same pullback bridge as the r=5 small-capacity file, with the
   five-point `K₂ ⊔ 3K₁` capacity 24 proved above. -/
theorem r4_residual_five_capacity_of_local
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    {u v : Fin n} (htri : G.CliqueFree 3) (huv : G.Adj u v)
    {T : Finset (Fin n)} (hTcard : T.card = 5)
    (hTsub : ∀ z, z ∈ residualSet G u v → z ∈ T)
    (hcompat : DegreeCompatible (supportFamilyA G u v)
      (supportFamilyB G u v))
    (hcap : ∀ (𝒜 ℬ : Finset (Finset V5)),
      (∀ I ∈ 𝒜, I.Nonempty ∧
        (G.comap (residualFiveEmbedding T hTcard)).IsIndepSet (I : Set V5)) →
      (∀ J ∈ ℬ, J.Nonempty ∧
        (G.comap (residualFiveEmbedding T hTcard)).IsIndepSet (J : Set V5)) →
      DegreeCompatible 𝒜 ℬ → supportSurplus 𝒜 ℬ ≤ 24) :
    supportSurplus (supportFamilyA G u v) (supportFamilyB G u v) ≤ 24 := by
  let f := residualFiveEmbedding T hTcard
  let H := G.comap f
  have hrange : Set.range f = (T : Set (Fin n)) := residualFiveEmbedding_range T hTcard
  have hmapsA : familyMapsToEmbedding f (supportFamilyA G u v) := by
    intro I hI z hz
    rcases mem_supportFamilyA_iff.mp hI with ⟨x, hx, hIx⟩
    subst I
    rw [hrange]
    exact hTsub z (mem_residualTypeFinset_iff.mp hz).2
  have hmapsB : familyMapsToEmbedding f (supportFamilyB G u v) := by
    intro I hI z hz
    rcases mem_supportFamilyB_iff.mp hI with ⟨x, hx, hIx⟩
    subst I
    rw [hrange]
    exact hTsub z (mem_residualTypeFinset_iff.mp hz).2
  let 𝒜 := pullSupportFamilyEmbedding f (supportFamilyA G u v)
  let ℬ := pullSupportFamilyEmbedding f (supportFamilyB G u v)
  have hAmap : mapSupportFamilyEmbedding f 𝒜 = supportFamilyA G u v := by
    simpa [𝒜] using map_pullSupportFamilyEmbedding_eq f hmapsA
  have hBmap : mapSupportFamilyEmbedding f ℬ = supportFamilyB G u v := by
    simpa [ℬ] using map_pullSupportFamilyEmbedding_eq f hmapsB
  have hcomp : DegreeCompatible 𝒜 ℬ := by
    apply degreeCompatible_of_mapped_certificate f
      (𝒜' := supportFamilyA G u v) (ℬ' := supportFamilyB G u v)
    · exact hAmap.symm
    · exact hBmap.symm
    · exact hcompat
  have h𝒜ind : ∀ I ∈ 𝒜, I.Nonempty ∧ H.IsIndepSet (I : Set V5) := by
    intro I hI
    rcases Finset.mem_image.mp hI with ⟨J, hJ, rfl⟩
    have hJ' := supportFamilyA_nonempty hJ
    have hnon : (J.preimage f f.injective.injOn).Nonempty := by
      rcases hJ' with ⟨z, hz⟩
      obtain ⟨i, hi⟩ := hmapsA J hJ z hz
      refine ⟨i, Finset.mem_preimage.mpr ?_⟩
      simpa [hi] using hz
    refine ⟨hnon, ?_⟩
    have hJind := supportFamilyA_independent htri hJ
    intro a ha b hb hab hAdj
    exact hJind (Finset.mem_preimage.1 ha) (Finset.mem_preimage.1 hb)
      (fun h => hab (f.injective h)) hAdj
  have hℬind : ∀ I ∈ ℬ, I.Nonempty ∧ H.IsIndepSet (I : Set V5) := by
    intro I hI
    rcases Finset.mem_image.mp hI with ⟨J, hJ, rfl⟩
    have hJ' := supportFamilyB_nonempty hJ
    have hnon : (J.preimage f f.injective.injOn).Nonempty := by
      rcases hJ' with ⟨z, hz⟩
      obtain ⟨i, hi⟩ := hmapsB J hJ z hz
      refine ⟨i, Finset.mem_preimage.mpr ?_⟩
      simpa [hi] using hz
    refine ⟨hnon, ?_⟩
    have hJind := supportFamilyB_independent htri hJ
    intro a ha b hb hab hAdj
    exact hJind (Finset.mem_preimage.1 ha) (Finset.mem_preimage.1 hb)
      (fun h => hab (f.injective h)) hAdj
  have hlocal : supportSurplus 𝒜 ℬ ≤ 24 := hcap 𝒜 ℬ h𝒜ind hℬind hcomp
  calc
    supportSurplus (supportFamilyA G u v) (supportFamilyB G u v) =
        supportSurplus (mapSupportFamilyEmbedding f 𝒜)
          (mapSupportFamilyEmbedding f ℬ) := by rw [hAmap, hBmap]
    _ = supportSurplus 𝒜 ℬ := supportSurplus_mapSupportFamilyEmbedding f 𝒜 ℬ
    _ ≤ 24 := hlocal

end Erdos1011

