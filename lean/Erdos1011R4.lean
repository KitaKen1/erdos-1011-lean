  r#"section Flattened_Erdos1011_R4FinitePatterns

namespace Erdos1011

open SimpleGraph

/-! Finite, executable graph-pattern predicates for a four-vertex residual.
These are deliberately stated on an explicit edge-code rather than on the
noncomputable `SimpleGraph` type.  This lets `decide +kernel` certify the
small graph classification used by the r=4 paper argument. -/

abbrev R4EdgeCode := {e : Sym2 V4 // ¬ e.IsDiag}

def r4EdgeSet (E : Finset R4EdgeCode) : Set (Sym2 V4) :=
  ((E.image Subtype.val : Finset (Sym2 V4)) : Set _)

instance r4EdgeSet_decidable (E : Finset R4EdgeCode) :
    DecidablePred (· ∈ r4EdgeSet E) := by
  intro e
  change Decidable (e ∈ E.image Subtype.val)
  infer_instance

def r4CodeGraph (E : Finset R4EdgeCode) : SimpleGraph V4 :=
  SimpleGraph.fromEdgeSet (r4EdgeSet E)

instance r4CodeGraph_decidable (E : Finset R4EdgeCode) :
    DecidableRel (r4CodeGraph E).Adj := by
  intro x y
  change Decidable (s(x, y) ∈ r4EdgeSet E ∧ x ≠ y)
  infer_instance

def r4HasEdge (G : SimpleGraph V4) : Prop := ∃ x y : V4, G.Adj x y

def r4HasP3 (G : SimpleGraph V4) : Prop :=
  ∃ x y z : V4, G.Adj x y ∧ G.Adj y z ∧ x ≠ z

def r4HasTwoK2 (G : SimpleGraph V4) : Prop :=
  ∃ x₁ y₁ x₂ y₂ : V4,
    G.Adj x₁ y₁ ∧ G.Adj x₂ y₂ ∧
    x₁ ≠ x₂ ∧ x₁ ≠ y₂ ∧ y₁ ≠ x₂ ∧ y₁ ≠ y₂

def r4HasP4 (G : SimpleGraph V4) : Prop :=
  ∃ x₀ x₁ x₂ x₃ : V4,
    G.Adj x₀ x₁ ∧ G.Adj x₁ x₂ ∧ G.Adj x₂ x₃ ∧
    x₀ ≠ x₂ ∧ x₀ ≠ x₃ ∧ x₁ ≠ x₃

def r4HasStar (G : SimpleGraph V4) : Prop :=
  ∃ c x y z : V4,
    G.Adj c x ∧ G.Adj c y ∧ G.Adj c z ∧
    c ≠ x ∧ c ≠ y ∧ c ≠ z ∧ x ≠ y ∧ x ≠ z ∧ y ≠ z

instance r4HasEdge_decidable (G : SimpleGraph V4) [DecidableRel G.Adj] :
    Decidable (r4HasEdge G) := by
  unfold r4HasEdge
  infer_instance

instance r4HasP3_decidable (G : SimpleGraph V4) [DecidableRel G.Adj] :
    Decidable (r4HasP3 G) := by
  unfold r4HasP3
  infer_instance

instance r4HasTwoK2_decidable (G : SimpleGraph V4) [DecidableRel G.Adj] :
    Decidable (r4HasTwoK2 G) := by
  unfold r4HasTwoK2
  infer_instance

instance r4HasP4_decidable (G : SimpleGraph V4) [DecidableRel G.Adj] :
    Decidable (r4HasP4 G) := by
  unfold r4HasP4
  infer_instance

instance r4HasStar_decidable (G : SimpleGraph V4) [DecidableRel G.Adj] :
    Decidable (r4HasStar G) := by
  unfold r4HasStar
  infer_instance

private def r4TriangleFree (G : SimpleGraph V4) : Prop :=
  ∀ x y z : V4, G.Adj x y → G.Adj x z → G.Adj y z → False

instance r4TriangleFree_decidable (G : SimpleGraph V4) [DecidableRel G.Adj] :
    Decidable (r4TriangleFree G) := by
  unfold r4TriangleFree
  infer_instance

/- The executable theorem is intentionally a disjunction with no hidden
  graph-theoretic assumptions.  In particular, every triangle-free four
  vertex graph with at least three edges either contains a 4-vertex path or
  is the 3-star.  The additional edge-count alternatives make the later
  capacity dispatcher finite and explicit. -/
theorem r4_code_pattern_certificate :
    ∀ E : Finset R4EdgeCode,
      r4TriangleFree (r4CodeGraph E) →
      (E.card = 0 ∨
       (E.card = 1 ∧ r4HasEdge (r4CodeGraph E)) ∨
       (E.card = 2 ∧
         (r4HasP3 (r4CodeGraph E) ∨ r4HasTwoK2 (r4CodeGraph E))) ∨
       (E.card ≥ 3 ∧
         (r4HasP4 (r4CodeGraph E) ∨ r4HasStar (r4CodeGraph E)))) := by
  decide +kernel

private def r4EdgeCodeOfGraph (G : SimpleGraph V4)
    [DecidableRel G.Adj] : Finset R4EdgeCode :=
  G.edgeFinset.attach.image (fun e =>
    (⟨e.1, G.not_isDiag_of_mem_edgeFinset e.2⟩ : R4EdgeCode))

private theorem r4CodeGraph_edgeCodeOfGraph
    (G : SimpleGraph V4) [DecidableRel G.Adj] :
    r4CodeGraph (r4EdgeCodeOfGraph G) = G := by
  ext x y
  constructor
  · intro h
    change (SimpleGraph.fromEdgeSet (r4EdgeSet (r4EdgeCodeOfGraph G))).Adj x y at h
    rw [SimpleGraph.fromEdgeSet_adj] at h
    rcases h with ⟨hE, hxy⟩
    change s(x, y) ∈
      ((r4EdgeCodeOfGraph G).image Subtype.val : Finset (Sym2 V4)) at hE
    rw [Finset.mem_image] at hE
    rcases hE with ⟨e, he, heq⟩
    rcases Finset.mem_image.mp he with ⟨e', he', heeq⟩
    have hefin : e'.1 ∈ G.edgeFinset := e'.2
    have heq' : e'.1 = e.1 := by simpa using congrArg Subtype.val heeq
    have hval : e'.1 = s(x, y) := heq'.trans heq
    have : s(x, y) ∈ G.edgeFinset := by simpa [hval] using hefin
    exact (SimpleGraph.mem_edgeFinset.mp this)
  · intro hxy
    have hne : x ≠ y := G.ne_of_adj hxy
    change (SimpleGraph.fromEdgeSet (r4EdgeSet (r4EdgeCodeOfGraph G))).Adj x y
    rw [SimpleGraph.fromEdgeSet_adj]
    refine ⟨?_, hne⟩
    change s(x, y) ∈
      ((r4EdgeCodeOfGraph G).image Subtype.val : Finset (Sym2 V4))
    apply Finset.mem_image.mpr
    let e : G.edgeFinset := ⟨s(x, y), SimpleGraph.mem_edgeFinset.mpr hxy⟩
    let ec : R4EdgeCode := ⟨e.1, G.not_isDiag_of_mem_edgeFinset e.2⟩
    refine ⟨ec, ?_, ?_⟩
    · apply Finset.mem_image.mpr
      exact ⟨e, by simp, rfl⟩
    · rfl

private theorem r4EdgeCodeOfGraph_card
    (G : SimpleGraph V4) [DecidableRel G.Adj] :
    (r4EdgeCodeOfGraph G).card = G.edgeFinset.card := by
  unfold r4EdgeCodeOfGraph
  calc
    (Finset.image (fun e =>
      (⟨e.1, G.not_isDiag_of_mem_edgeFinset e.2⟩ : R4EdgeCode))
        G.edgeFinset.attach).card = G.edgeFinset.attach.card := by
      apply Finset.card_image_of_injOn
      intro a ha b hb hab
      apply Subtype.ext
      simpa using congrArg Subtype.val hab
    _ = G.edgeFinset.card := by simp

theorem r4_graph_pattern_certificate
    (G : SimpleGraph V4) [DecidableRel G.Adj]
    (htri : G.CliqueFree 3) :
    G.edgeFinset.card = 0 ∨
      (G.edgeFinset.card = 1 ∧ r4HasEdge G) ∨
      (G.edgeFinset.card = 2 ∧ (r4HasP3 G ∨ r4HasTwoK2 G)) ∨
      (G.edgeFinset.card ≥ 3 ∧ (r4HasP4 G ∨ r4HasStar G)) := by
  let E := r4EdgeCodeOfGraph G
  have hEq : r4CodeGraph E = G := r4CodeGraph_edgeCodeOfGraph G
  have htriE : r4TriangleFree (r4CodeGraph E) := by
    intro x y z hxy hxz hyz
    exact htri _ (SimpleGraph.is3Clique_triple_iff.mpr ⟨
      (hEq ▸ hxy), (hEq ▸ hxz), (hEq ▸ hyz)⟩)
  have hcert := r4_code_pattern_certificate E htriE
  have hcard : E.card = G.edgeFinset.card := by
    dsimp [E]
    exact r4EdgeCodeOfGraph_card G
  rcases hcert with h0 | ⟨h1, hEdge⟩ | ⟨h2, hpat⟩ | ⟨h3, hpat⟩
  · left
    omega
  · right; left
    refine ⟨?_, ?_⟩
    · omega
    · simpa [hEq] using hEdge
  · right; right; left
    refine ⟨?_, ?_⟩
    · omega
    · rcases hpat with hP | hK
      · left; simpa [hEq] using hP
      · right; simpa [hEq] using hK
  · right; right; right
    refine ⟨?_, ?_⟩
    · omega
    · rcases hpat with hP | hK
      · left; simpa [hEq] using hP
      · right; simpa [hEq] using hK

end Erdos1011

end Flattened_Erdos1011_R4FinitePatterns
