theorem W10_contains_C5_edges
    {n : ℕ} {G : SimpleGraph (Fin n)}
    {v w₁ w₂ : Fin n} {s t : Finset (Fin n)}
    (hw : G.IsFiveWheelLike 1 0 v w₁ w₂ s t) :
    ∃ a b : Fin n, s = {a} ∧ t = {b} ∧
      G.Adj w₁ w₂ ∧ G.Adj v a ∧ G.Adj w₁ a ∧
        G.Adj v b ∧ G.Adj w₂ b := by
  have hs : s.card = 1 := hw.card_left
  have ht : t.card = 1 := hw.card_right
  obtain ⟨a, ha⟩ := Finset.card_eq_one.mp hs
  obtain ⟨b, hb⟩ := Finset.card_eq_one.mp ht
  have hva_ne : v ≠ a := by
    intro h
    apply hw.notMem_left
    rw [ha]
    simpa [h]
  have hw₁a_ne : w₁ ≠ a := by
    intro h
    apply hw.fst_notMem
    rw [ha]
    simpa [h]
  have hvb_ne : v ≠ b := by
    intro h
    apply hw.notMem_right
    rw [hb]
    simpa [h]
  have hw₂b_ne : w₂ ≠ b := by
    intro h
    apply hw.snd_notMem
    rw [hb]
    simpa [h]
  have hva : G.Adj v a := by
    have hcl := hw.isNClique_left.isClique
    rw [ha] at hcl
    exact hcl (by simp) (by simp) hva_ne
  have hw₁a : G.Adj w₁ a := by
    have hcl := hw.isNClique_fst_left.isClique
    rw [ha] at hcl
    exact hcl (by simp) (by simp) hw₁a_ne
  have hvb : G.Adj v b := by
    have hcl := hw.isNClique_right.isClique
    rw [hb] at hcl
    exact hcl (by simp) (by simp) hvb_ne
  have hw₂b : G.Adj w₂ b := by
    have hcl := hw.isNClique_snd_right.isClique
    rw [hb] at hcl
    exact hcl (by simp) (by simp) hw₂b_ne
  exact ⟨a, b, ha, hb, hw.isPathGraph3Compl.adj, hva, hw₁a, hvb, hw₂b⟩

theorem W10_contains_induced_C5
    {n : ℕ} {G : SimpleGraph (Fin n)}
    (htri : G.CliqueFree 3)
    {v w₁ w₂ : Fin n} {s t : Finset (Fin n)}
    (hw : G.IsFiveWheelLike 1 0 v w₁ w₂ s t) :
    ∃ a b : Fin n, s = {a} ∧ t = {b} ∧
      G.Adj w₁ w₂ ∧ G.Adj v a ∧ G.Adj w₁ a ∧
        G.Adj v b ∧ G.Adj w₂ b ∧
      ¬ G.Adj v w₁ ∧ ¬ G.Adj v w₂ ∧ ¬ G.Adj a w₂ ∧
        ¬ G.Adj a b ∧ ¬ G.Adj b w₁ := by
  rcases W10_contains_C5_edges hw with
    ⟨a, b, ha, hb, hw₁w₂, hva, hw₁a, hvb, hw₂b⟩
  have hva_w₂ : ¬ G.Adj a w₂ := by
    intro ha_w₂
    apply htri _
    exact SimpleGraph.is3Clique_triple_iff.mpr
      ⟨hw₁a.symm, ha_w₂, hw₁w₂⟩
  have hab : ¬ G.Adj a b := by
    intro hab
    apply htri _
    exact SimpleGraph.is3Clique_triple_iff.mpr
      ⟨hab, hva.symm, hvb.symm⟩
  have hvb_w₁ : ¬ G.Adj b w₁ := by
    intro hb_w₁
    apply htri _
    exact SimpleGraph.is3Clique_triple_iff.mpr
      ⟨hb_w₁, hw₂b.symm, hw₁w₂⟩
  exact ⟨a, b, ha, hb, hw₁w₂, hva, hw₁a, hvb, hw₂b,
    hw.isPathGraph3Compl.not_adj_fst, hw.isPathGraph3Compl.not_adj_snd,
    hva_w₂, hab, hvb_w₁⟩

/- A triangle-free graph admits at most two neighbors on a 5-cycle.  The
   proof uses only the five cycle edges: each adjacent pair of cycle vertices
   cannot both be adjacent to the same outside vertex, and summing those five
   integer inequalities gives twice the desired bound. -/
theorem c5_neighbor_indicator_le_two
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (htri : G.CliqueFree 3)
    {x c₀ c₁ c₂ c₃ c₄ : Fin n}
    (h₀₁ : G.Adj c₀ c₁) (h₁₂ : G.Adj c₁ c₂)
    (h₂₃ : G.Adj c₂ c₃) (h₃₄ : G.Adj c₃ c₄)
    (h₄₀ : G.Adj c₄ c₀) :
    (if G.Adj x c₀ then 1 else 0) + (if G.Adj x c₁ then 1 else 0) +
      (if G.Adj x c₂ then 1 else 0) + (if G.Adj x c₃ then 1 else 0) +
      (if G.Adj x c₄ then 1 else 0) ≤ 2 := by
  classical
  have hn₀₁ : ¬ (G.Adj x c₀ ∧ G.Adj x c₁) := by
    rintro ⟨hx₀, hx₁⟩
    exact htri _ (SimpleGraph.is3Clique_triple_iff.mpr ⟨hx₀, hx₁, h₀₁⟩)
  have hn₁₂ : ¬ (G.Adj x c₁ ∧ G.Adj x c₂) := by
    rintro ⟨hx₁, hx₂⟩
    exact htri _ (SimpleGraph.is3Clique_triple_iff.mpr ⟨hx₁, hx₂, h₁₂⟩)
  have hn₂₃ : ¬ (G.Adj x c₂ ∧ G.Adj x c₃) := by
    rintro ⟨hx₂, hx₃⟩
    exact htri _ (SimpleGraph.is3Clique_triple_iff.mpr ⟨hx₂, hx₃, h₂₃⟩)
  have hn₃₄ : ¬ (G.Adj x c₃ ∧ G.Adj x c₄) := by
    rintro ⟨hx₃, hx₄⟩
    exact htri _ (SimpleGraph.is3Clique_triple_iff.mpr ⟨hx₃, hx₄, h₃₄⟩)
  have hn₄₀ : ¬ (G.Adj x c₄ ∧ G.Adj x c₀) := by
    rintro ⟨hx₄, hx₀⟩
    exact htri _ (SimpleGraph.is3Clique_triple_iff.mpr ⟨hx₄, hx₀, h₄₀⟩)
  have hi₀₁ : (if G.Adj x c₀ then 1 else 0) +
      (if G.Adj x c₁ then 1 else 0) ≤ 1 := by
    by_cases hx₀ : G.Adj x c₀ <;> by_cases hx₁ : G.Adj x c₁ <;>
      simp_all [hx₀, hx₁]
  have hi₁₂ : (if G.Adj x c₁ then 1 else 0) +
      (if G.Adj x c₂ then 1 else 0) ≤ 1 := by
    by_cases hx₁ : G.Adj x c₁ <;> by_cases hx₂ : G.Adj x c₂ <;>
      simp_all [hx₁, hx₂]
  have hi₂₃ : (if G.Adj x c₂ then 1 else 0) +
      (if G.Adj x c₃ then 1 else 0) ≤ 1 := by
    by_cases hx₂ : G.Adj x c₂ <;> by_cases hx₃ : G.Adj x c₃ <;>
      simp_all [hx₂, hx₃]
  have hi₃₄ : (if G.Adj x c₃ then 1 else 0) +
      (if G.Adj x c₄ then 1 else 0) ≤ 1 := by
    by_cases hx₃ : G.Adj x c₃ <;> by_cases hx₄ : G.Adj x c₄ <;>
      simp_all [hx₃, hx₄]
  have hi₄₀ : (if G.Adj x c₄ then 1 else 0) +
      (if G.Adj x c₀ then 1 else 0) ≤ 1 := by
    by_cases hx₄ : G.Adj x c₄ <;> by_cases hx₀ : G.Adj x c₀ <;>
      simp_all [hx₄, hx₀]
  omega

theorem W10_contains_C5_neighbor_bound
    {n : ℕ} {G : SimpleGraph (Fin n)} [DecidableRel G.Adj]
    (htri : G.CliqueFree 3)
    {v w₁ w₂ : Fin n} {s t : Finset (Fin n)}
    (hw : G.IsFiveWheelLike 1 0 v w₁ w₂ s t) :
    ∃ a b : Fin n, s = {a} ∧ t = {b} ∧
      G.Adj v a ∧ G.Adj a w₁ ∧ G.Adj w₁ w₂ ∧
      G.Adj w₂ b ∧ G.Adj b v ∧
      ∀ x : Fin n,
        (if G.Adj x v then 1 else 0) + (if G.Adj x a then 1 else 0) +
          (if G.Adj x w₁ then 1 else 0) + (if G.Adj x w₂ then 1 else 0) +
          (if G.Adj x b then 1 else 0) ≤ 2 := by
  rcases W10_contains_induced_C5 htri hw with
    ⟨a, b, ha, hb, hw₁w₂, hva, hw₁a, hvb, hw₂b, -, -, -, -, -⟩
  refine ⟨a, b, ha, hb, hva, hw₁a.symm, hw₁w₂, hw₂b, hvb.symm, ?_⟩
  intro x
  exact c5_neighbor_indicator_le_two htri hva hw₁a.symm hw₁w₂ hw₂b hvb.symm

