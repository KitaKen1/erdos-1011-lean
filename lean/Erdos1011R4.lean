    (s3Adj_maskOfGraph_iff H x y).mpr hxy
  have hnot : ¬ s3Adj (s3MaskOfGraph H) x y := by
    simp [s3Adj, hval]
  exact hnot hcode

theorem s3_graph_support_surplus_le_four
    (H : SimpleGraph V3) [DecidableRel H.Adj]
    (hedge : ∃ x y : V3, H.Adj x y)
    (htri : H.CliqueFree 3)
    {𝒜 ℬ : Finset (Finset V3)}
    (h𝒜 : ∀ I ∈ 𝒜, I.Nonempty ∧ H.IsIndepSet (I : Set V3))
