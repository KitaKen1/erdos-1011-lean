      (∑ J ∈ ℬ \ s6TFamily, if J ∈ s6VDFamily then 1 else 0)) :
    supportSurplus 𝒜' ℬ' ≤ 0 := by
  rw [h𝒜eq, hℬeq]
  exact embedded_s6_support_surplus_nonpositive_of_vd_count
