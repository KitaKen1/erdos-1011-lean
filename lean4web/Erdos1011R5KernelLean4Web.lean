    edgeCount G ≤ fiveCandidate n := by
  have hmax : IsEdgeMaximalTriangleFree G :=
    edge_maximal_of_edgeCount_max hG.1 hG.2
  exact verified_r5_upper_from_residual_s7_sharp_s8_s9 hmax huv
    hnoA hnoB he hq hn hcase

