theorem residual_decomposition_bound_s10_small
    {n a b e q m : ℕ} (hn : 80 ≤ n)
    (hsum : a + b + 10 = n) (heq : e + q ≤ 149)
    (hdecomp : m ≤ a * b + e + q) : m ≤ fiveCandidate n := by
  have hab : a * b ≤ (a + b)^2 / 4 := nat_mul_le_add_sq_div_four a b
