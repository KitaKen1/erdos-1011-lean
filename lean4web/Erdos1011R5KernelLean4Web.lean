    (hm : m.val ∈ kernelS11C7RepresentativeMasks) : KernelS11C7Certificate m :=
  ⟨kernel_s11c7_all_canonical_mask m hm,
    kernel_s11c7_all_canonical_beta m.val hm,
    kernel_s11c7_all_canonical_scaled_bounds m.val hm⟩

