theorem edgeCount_le_fiveCandidate_of_simplified_s7_s9
    {n m : ℕ} (hn : 80 ≤ n)
    (hcert : ∃ s a b e q : ℕ,
      a + b + s = n ∧
      m ≤ a * b + e + q ∧
      ((s = 7 ∧ e + q ≤ 42) ∨
       (s = 8 ∧ e + q ≤ 77) ∨
       (s = 9 ∧ e + q ≤ 114))) :
