theorem small_gap_s11_80 {n : ℕ} (hn : 80 ≤ n) :
    (n - 11)^2 / 4 + 184 ≤ fiveCandidate n := by
  by_cases h80 : n = 80
  · subst n
    norm_num [fiveCandidate]
  by_cases h81 : n = 81
  · subst n
    norm_num [fiveCandidate]
  by_cases h82 : n = 82
  · subst n
    norm_num [fiveCandidate]
