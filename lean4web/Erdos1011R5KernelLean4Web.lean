    Nat.div_add_div_le_add_div
  rw [← hsq] at hdiv
  have hD : 72 ≤ (4 * (n - 8) + 4) / 4 := by
    apply (Nat.le_div_iff_mul_le (by omega : 0 < 4)).2
    omega
  omega

