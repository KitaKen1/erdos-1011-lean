theorem residual_decomposition_bound_s9_small
    {n a b e q m : ℕ} (hn : 80 ≤ n)
    (hsum : a + b + 9 = n) (heq : e + q ≤ 114)
    (hdecomp : m ≤ a * b + e + q) : m ≤ fiveCandidate n := by
